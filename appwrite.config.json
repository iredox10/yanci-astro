{
  "projectId": "YOUR_PROJECT_ID",
  "projectName": "Yanci",
  "endpoint": "https://<REGION>.cloud.appwrite.io/v1",
  "settings": {
    "services": {
      "account": false,
      "databases": true,
      "functions": true,
      "sites": true,
      "messaging": true
    },
    "protocols": {
      "rest": true,
      "graphql": false,
      "websocket": true
    },
    "auth": {
      "methods": {
        "email-password": true,
        "magic-url": false
      },
      "security": {
        "sessionsLimit": 10,
        "passwordDictionary": true
      }
    }
  },
  "tablesDB": [],
  "tables": [],
  "buckets": [],
  "teams": [],
  "topics": [],
"sites": [
    {
      "$id": "yanci",
      "name": "Yanci",
      "logging": true,
      "framework": "astro",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "./dist",
      "buildRuntime": "node-22",
      "adapter": "ssr",
      "startCommand": "npm run start",
      "buildSpecification": "s-1vcpu-512mb",
      "runtimeSpecification": "s-1vcpu-512mb",
      "timeout": 30,
      "deploymentRetention": 7,
      "path": "."
    }
  ]
}