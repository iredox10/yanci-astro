---
const year = new Date().getFullYear();
const socials = [
  { name: 'Twitter', href: 'https://twitter.com/yanci_ng' },
  { name: 'Facebook', href: 'https://facebook.com/yanci.ng' },
  { name: 'Instagram', href: 'https://instagram.com/yanci_ng' },
  { name: 'LinkedIn', href: 'https://linkedin.com/company/yanci' },
];
---

<footer class="relative mt-20 overflow-hidden border-t-8 border-[#c59d5f] bg-[#0f3036] pt-20 pb-10 text-white">
  <div class="pointer-events-none absolute inset-0 opacity-5"></div>
  <div class="relative z-10 mx-auto max-w-[1400px] px-6">
    <div class="mb-16 grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="space-y-8 lg:col-span-4">
        <div class="flex items-center gap-3">
          <img src="/icons/yc-mark-white.svg" alt="Yanci Logo" class="h-10 w-10 object-contain" />
          <h3 class="font-serif text-4xl font-black tracking-tighter">Yanci<span class="text-yanci-accent">.</span></h3>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-gray-300">
          Jarida mai zaman kanta da ke ba da labarai a Hausa, bisa gudummawar masu karatu. Muna kare gaskiya da al'adunmu na Arewa.
        </p>

        <div class="rounded-sm border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
          <h4 class="mb-2 text-sm font-bold uppercase tracking-widest text-yanci-accent">Kasance da mu</h4>
          <p class="mb-4 text-xs text-gray-400">Samu labarun masu zafi kai tsaye a akwatin imel naka.</p>
          <form id="newsletter-form" action="/api/newsletter" method="post" class="flex gap-2">
            <input
              type="email" name="email" placeholder="Adireshin imel" required
              class="w-full rounded-sm border border-white/20 bg-white/10 px-4 py-2 text-sm text-white placeholder-gray-500 transition-colors focus:border-yanci-accent focus:outline-none"
            />
            <button type="submit" class="rounded-sm bg-yanci-accent px-4 py-2 transition-colors hover:bg-white" aria-label="Biyan rajista">
              <svg class="h-5 w-5 text-[#0f3036]" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M502 3 153 199a24 24 0 0 0-4 40l70 26 22 74a24 24 0 0 0 39 10L382 30c3-3 3-7 0-10 0 0-2-13-11-18 0 0 0 0-1 0A15 15 0 0 0 369 0zM232 406l-31-19 105-113-74-27 0 0 0 0a24 24 0 0 1-34-34l0 0 0 0 113-105-19-31a24 24 0 0 0-32-9l-195 119a24 24 0 0 0-2 42l53 26 25 90a24 24 0 0 0 41 9L282 382a24 24 0 0 0-50-76z"/></svg>
            </button>
          </form>
          <p id="newsletter-status" class="mt-2 hidden text-xs text-green-400 font-bold">An yi rajada!</p>
          <button type="button" id="newsletter-unsubscribe" class="mt-1 text-[11px] text-gray-500 underline transition-colors hover:text-white">Cire rajista</button>
        </div>

        <div class="flex gap-4">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/5 transition-all hover:bg-yanci-accent hover:text-[#0f3036]" aria-label={s.name}>
              {s.name[0]}
            </a>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:col-span-8">
        <div>
          <h4 class="mb-6 border-b border-white/10 pb-3 text-xs font-bold uppercase tracking-wider text-yanci-accent">Labarun</h4>
          <ul class="space-y-4 text-sm text-gray-400">
            {[['Najeriya', '/labarai'], ['Siyasa', '/siyasa'], ['Kasuwanci', '/kasuwanci'], ['Wasanni', '/wasanni'], ['Fasaha', '/fasaha'], ['Binciken Gaskiya', '/fact-check']].map(([label, href]) => (
              <li><a href={href} class="block transition-all hover:translate-x-1 hover:text-white">{label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h4 class="mb-6 border-b border-white/10 pb-3 text-xs font-bold uppercase tracking-wider text-yanci-accent">Ra'ayi</h4>
          <ul class="space-y-4 text-sm text-gray-400">
            {[['Sharhin Edita', '/raayi'], ['Bincike', '/raayi'], ['Tattaunawa', '/raayi']].map(([label, href]) => (
              <li><a href={href} class="block transition-all hover:translate-x-1 hover:text-white">{label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h4 class="mb-6 border-b border-white/10 pb-3 text-xs font-bold uppercase tracking-wider text-yanci-accent">Al'adu</h4>
          <ul class="space-y-4 text-sm text-gray-400">
            {[['Kiɗa', '/aladu'], ['Fina-finai', '/bidiyo'], ['Abinci', '/aladu']].map(([label, href]) => (
              <li><a href={href} class="block transition-all hover:translate-x-1 hover:text-white">{label}</a></li>
            ))}
            <li><a href="/zabe" class="block transition-all hover:translate-x-1 hover:text-white">Zabe</a></li>
          </ul>
        </div>
        <div>
          <h4 class="mb-6 border-b border-white/10 pb-3 text-xs font-bold uppercase tracking-wider text-yanci-accent">Kamfani</h4>
          <ul class="space-y-4 text-sm text-gray-400">
            <li><a href="/about" class="block transition-all hover:translate-x-1 hover:text-white">Game da Mu</a></li>
            <li><a href="/tipline" class="block transition-all hover:translate-x-1 hover:text-white">Aiko da Bayani (TipLine)</a></li>
            <li><a href="/manufofi" class="block transition-all hover:translate-x-1 hover:text-white">Manufofin Edita</a></li>
            <li><a href="/gyara" class="block transition-all hover:translate-x-1 hover:text-white">Gyara da Koke</a></li>
            <li><a href="/contact" class="block transition-all hover:translate-x-1 hover:text-white">Tuntube Mu</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-6 border-t border-white/10 pt-8 text-xs font-medium tracking-wide text-gray-500 md:flex-row">
      <p>© {year} Yanci Media Ltd. An kiyaye haƴɗin mallaka.</p>
      <div class="flex flex-wrap gap-6 md:gap-8">
        <a href="/manufofi" class="transition-colors hover:text-white">Manufofin Edita</a>
        <a href="/gyara" class="transition-colors hover:text-white">Gyara da Koke</a>
        <a href="/privacy" class="transition-colors hover:text-white">Tsare Sirri</a>
        <a href="/search" class="transition-colors hover:text-white">Taswirar Shafin</a>
      </div>
    </div>
  </div>
</footer>

<script>
  const form = document.getElementById('newsletter-form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.querySelector('input[type="email"]') as HTMLInputElement | null)?.value;
    if (!email) return;
    const status = document.getElementById('newsletter-status');
    try {
      const res = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      if (res.ok) {
        form.hidden = true;
        if (status) {
          status.textContent = 'An yi rajada!';
          status.className = 'mt-2 text-xs font-bold text-green-400';
          status.hidden = false;
        }
      } else {
        if (status) {
          status.textContent = 'An samu matsala. Sake gwadawa.';
          status.className = 'mt-2 text-xs font-bold text-red-400';
          status.hidden = false;
        }
      }
    } catch {
      if (status) {
        status.textContent = 'An samu matsala. Sake gwadawa.';
        status.className = 'mt-2 text-xs font-bold text-red-400';
        status.hidden = false;
      }
    }
  });

  const unsubscribe = document.getElementById('newsletter-unsubscribe');
  unsubscribe?.addEventListener('click', async () => {
    const email = (form?.querySelector('input[type="email"]') as HTMLInputElement | null)?.value;
    if (!email) return;
    const status = document.getElementById('newsletter-status');
    try {
      const res = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, action: 'unsubscribe' }),
      });
      if (status) {
        status.textContent = res.ok ? 'An cire rajista!' : 'Ba a samu wannan imel ba.';
        status.className = `mt-2 text-xs font-bold ${res.ok ? 'text-green-400' : 'text-red-400'}`;
        status.hidden = false;
      }
    } catch {
      if (status) {
        status.textContent = 'An samu matsala. Sake gwadawa.';
        status.className = 'mt-2 text-xs font-bold text-red-400';
        status.hidden = false;
      }
    }
  });
</script>