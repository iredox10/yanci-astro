<script>
  // Global PWA install prompt handler
  let deferredPrompt: any = null;
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    (window as any).__yanciInstallPrompt = e;
  });

  // Handle all newsletter forms inside ad units
  document.querySelectorAll<HTMLFormElement>('[data-ad-newsletter-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[name="email"]');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const email = input?.value?.trim();
      if (!email) return;

      const originalBtnText = button ? button.textContent : '';
      if (button) {
        button.disabled = true;
        button.textContent = '...';
      }

      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        if (res.ok) {
          form.innerHTML = `
            <div class="flex items-center gap-1.5 rounded-lg bg-emerald-500/20 px-3 py-1.5 text-xs font-bold text-emerald-200 border border-emerald-500/30">
              <svg class="h-4 w-4 shrink-0 text-[#25D366]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>An yi rajista! Barka da zuwa Yanci.</span>
            </div>
          `;
        } else {
          if (button) {
            button.disabled = false;
            button.textContent = originalBtnText;
          }
          alert('An samu matsala wajen rajista. Da fatan a sake gwadawa.');
        }
      } catch {
        if (button) {
          button.disabled = false;
          button.textContent = originalBtnText;
        }
        alert('An samu matsala. Da fatan a duba intanet dinka.');
      }
    });
  });

  // Handle PWA install buttons inside ad units
  document.querySelectorAll<HTMLButtonElement>('[data-ad-pwa-install]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const promptEvent = deferredPrompt || (window as any).__yanciInstallPrompt;
      if (promptEvent) {
        promptEvent.prompt();
        const { outcome } = await promptEvent.userChoice;
        if (outcome === 'accepted') {
          deferredPrompt = null;
          (window as any).__yanciInstallPrompt = null;
        }
      } else {
        alert('Don sanya manhajar Yanci a wayarka:\n\n1. Android / Chrome: Danna ɗigon-uku (⋮) a sama sannan ka zaɓi "Install app" ko "Add to Home Screen".\n2. iPhone / Safari: Danna alamar raba (Share ⎋) a ƙasa sannan ka zaɓi "Add to Home Screen" (Ƙara zuwa Allon Waya).');
      }
    });
  });

  // Handle sticky footer dismiss button
  document.querySelectorAll<HTMLElement>('[data-ad-sticky-root]').forEach((stickyRoot) => {
    const slotId = stickyRoot.dataset.adSlot || 'default';
    const storageKey = `yanci-sticky-ad-dismissed-${slotId}`;

    try {
      if (sessionStorage.getItem(storageKey) === '1') {
        stickyRoot.style.display = 'none';
        return;
      }
    } catch {}

    const closeBtn = stickyRoot.querySelector<HTMLButtonElement>('[data-ad-sticky-close]');
    closeBtn?.addEventListener('click', () => {
      stickyRoot.style.opacity = '0';
      stickyRoot.style.transform = 'translateY(100%)';
      setTimeout(() => {
        stickyRoot.style.display = 'none';
      }, 300);
      try {
        sessionStorage.setItem(storageKey, '1');
      } catch {}
    });
  });
</script>

