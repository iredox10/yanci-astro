---
interface Props {
  tipNumber?: string;
  compact?: boolean;
}

const {
  tipNumber: customTipNumber,
  compact = false,
} = Astro.props;

const rawNumber = String(
  customTipNumber ||
    import.meta.env.PUBLIC_WHATSAPP_TIP_NUMBER ||
    '2348000000000'
);
const tipNumber = rawNumber.replace(/\D/g, '') || '2348000000000';
const prefilledPrefix = 'Ina son aiko da bayani na sirri ga Yanci: ';
const directWaUrl = `https://wa.me/${tipNumber}?text=${encodeURIComponent(prefilledPrefix)}`;
---

<section
  data-wa-tipline
  data-tip-number={tipNumber}
  data-prefix={prefilledPrefix}
  class={`rounded-2xl border border-emerald-900/10 bg-gradient-to-br from-emerald-50/70 via-white to-gray-50 p-5 shadow-xs sm:p-6 ${compact ? 'max-w-md' : 'max-w-2xl'}`}
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#25D366] text-white">
          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 448 512" aria-hidden="true">
            <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
          </svg>
        </span>
        <h3 class="font-serif text-lg font-bold text-yanci-primary">Yanci WhatsApp TipLine</h3>
      </div>
      <p class="text-xs text-gray-600">
        Ka san wani labari ko bayanin sirri? Aiko mana kai tsaye a WhatsApp ko shafinmu na sirri.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <a
        href={directWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-2 text-xs font-bold text-white shadow-xs transition-all hover:bg-[#1da851] hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0f3036]"
      >
        <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 448 512" aria-hidden="true">
          <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
        </svg>
        <span>WhatsApp</span>
      </a>

      <button
        type="button"
        data-wa-toggle
        aria-expanded="false"
        aria-controls="wa-tip-panel"
        class="inline-flex items-center gap-1.5 rounded-full border border-gray-300 bg-white px-3.5 py-2 text-xs font-semibold text-gray-700 transition-colors hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0f3036]"
      >
        <span>Rubuta saƙo</span>
        <svg class="h-3 w-3 transition-transform data-[open=true]:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>

      <a
        href="/tipline"
        class="inline-flex items-center gap-1 text-xs font-bold text-yanci-teal transition-colors hover:text-yanci-primary hover:underline"
      >
        <span>Shafin TipLine →</span>
      </a>
    </div>
  </div>

  <div id="wa-tip-panel" data-wa-panel hidden class="mt-4 border-t border-emerald-900/10 pt-4">
    <p class="mb-3 text-xs leading-relaxed text-gray-600">
      Rubuta labarinka a ƙasa domin buɗe WhatsApp da saƙon da aka shirya:
    </p>
    <form data-wa-form class="space-y-3">
      <label class="block text-xs font-bold uppercase tracking-wider text-gray-700">
        Labarinka
        <textarea
          name="tip"
          rows="3"
          required
          placeholder="Rubuta bayanin labari a nan..."
          class="mt-1 w-full resize-y rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-normal normal-case tracking-normal text-gray-800 placeholder:text-gray-400 focus:border-[#25D366] focus:outline-none focus:ring-1 focus:ring-[#25D366]"
        ></textarea>
      </label>
      
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700">
          Sunanka <span class="font-normal lowercase text-gray-400">(na zaɓi)</span>
          <input
            type="text"
            name="name"
            autocomplete="name"
            placeholder="Sunanka ko bar shi a ɓoye"
            class="mt-1 w-full sm:w-64 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-normal normal-case tracking-normal text-gray-800 placeholder:text-gray-400 focus:border-[#25D366] focus:outline-none focus:ring-1 focus:ring-[#25D366]"
          />
        </label>

        <button
          type="submit"
          class="mt-2 sm:mt-0 inline-flex items-center justify-center gap-2 rounded-full bg-[#25D366] px-4 py-2 text-xs font-bold text-white transition-colors hover:bg-[#1da851] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0f3036]"
        >
          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 512 512" aria-hidden="true">
            <path d="M498.1 5.6c10.1 7 15.4 19.1 13.5 31.2l-64 416c-1.5 9.7-7.4 18.2-16 23s-18.9 5.4-28 1.6L284 427.7l-68.5 74.1c-8.9 9.7-22.9 12.9-35.2 8.1S160 493.2 160 480V396.4c0-4 1.5-7.8 4.2-10.7L331.8 202.8c5.8-6.3 5.6-16-.4-22s-15.7-6.4-22-.7L106 360.8 17.7 316.6C7.1 311.3.3 300.7 0 288.9s5.9-22.8 16.1-28.7l448-256c10.7-6.1 23.9-5.5 34 1.4z"/>
          </svg>
          <span>Aika a WhatsApp</span>
        </button>
      </div>

      <div class="flex items-center justify-between pt-2 text-[11px] text-gray-500">
        <span>Ana riƙe sunanka da bayananka a asirce.</span>
        <a href="/tipline" class="text-yanci-teal hover:underline font-semibold">Duba cikakken tsaron majiya →</a>
      </div>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-wa-tipline]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-wa-toggle]');
    const panel = root.querySelector<HTMLElement>('[data-wa-panel]');
    const form = root.querySelector<HTMLFormElement>('[data-wa-form]');
    const number = root.dataset.tipNumber || '2348000000000';
    const prefix = root.dataset.prefix || 'Ina son aiko da bayani na sirri ga Yanci: ';
    if (!toggle || !panel || !form) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.querySelector('svg')?.setAttribute('data-open', String(open));
      panel.hidden = !open;
      if (open) panel.querySelector('textarea')?.focus();
      else toggle.focus();
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const tip = String(data.get('tip') ?? '').trim();
      if (!tip) return;
      const name = String(data.get('name') ?? '').trim();
      const userMessage = name ? `${tip}\n\n— ${name}` : tip;
      const fullText = `${prefix}${userMessage}`;
      window.open(`https://wa.me/${number}?text=${encodeURIComponent(fullText)}`, '_blank', 'noopener,noreferrer');
      form.reset();
    });
  });
</script>
