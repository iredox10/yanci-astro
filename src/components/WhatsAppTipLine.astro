---
const TIP_NUMBER = String(import.meta.env.PUBLIC_WHATSAPP_TIP_NUMBER ?? '');
---

{TIP_NUMBER && (
  <section data-wa-tipline data-tip-number={TIP_NUMBER} class="max-w-md">
    <button
      type="button"
      data-wa-toggle
      aria-expanded="false"
      aria-controls="wa-tip-panel"
      class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-5 py-2.5 text-sm font-bold text-white shadow-sm transition-colors hover:bg-[#1da851] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0f3036]"
    >
      <svg class="h-4 w-4" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
      Aiko da labari a WhatsApp
    </button>

    <div id="wa-tip-panel" data-wa-panel hidden class="mt-3 border-l-4 border-[#25D366] bg-gray-50 p-4">
      <p class="mb-3 text-sm leading-relaxed text-gray-600">Ka san wani labari? Ka rubuta mana — za mu tabbatar da shi kafin bugawa.</p>
      <form data-wa-form>
        <label class="mb-1 block text-xs font-bold uppercase tracking-wider text-gray-700">
          Labarinka
          <textarea
            name="tip"
            rows="4"
            required
            placeholder="Rubuta labarinka a nan..."
            class="mt-1 w-full resize-y rounded-sm border border-gray-300 bg-white px-3 py-2 text-sm font-normal normal-case tracking-normal text-gray-800 placeholder:text-gray-400 focus:border-[#25D366] focus:outline-none"
          ></textarea>
        </label>
        <label class="mt-3 mb-1 block text-xs font-bold uppercase tracking-wider text-gray-700">
          Sunanka (na zaɓi)
          <input
            type="text"
            name="name"
            autocomplete="name"
            placeholder="Sunanka"
            class="mt-1 w-full rounded-sm border border-gray-300 bg-white px-3 py-2 text-sm font-normal normal-case tracking-normal text-gray-800 placeholder:text-gray-400 focus:border-[#25D366] focus:outline-none"
          />
        </label>
        <p class="mt-2 text-xs text-gray-500">Ana iya rike sunanka a asirce.</p>
        <button
          type="submit"
          class="mt-3 inline-flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-2 text-sm font-bold text-white transition-colors hover:bg-[#1da851] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0f3036]"
        >
          <svg class="h-4 w-4" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M498.1 5.6c10.1 7 15.4 19.1 13.5 31.2l-64 416c-1.5 9.7-7.4 18.2-16 23s-18.9 5.4-28 1.6L284 427.7l-68.5 74.1c-8.9 9.7-22.9 12.9-35.2 8.1S160 493.2 160 480V396.4c0-4 1.5-7.8 4.2-10.7L331.8 202.8c5.8-6.3 5.6-16-.4-22s-15.7-6.4-22-.7L106 360.8 17.7 316.6C7.1 311.3.3 300.7 0 288.9s5.9-22.8 16.1-28.7l448-256c10.7-6.1 23.9-5.5 34 1.4z"/></svg>
          Aika ta WhatsApp
        </button>
      </form>
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-wa-tipline]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-wa-toggle]');
    const panel = root.querySelector<HTMLElement>('[data-wa-panel]');
    const form = root.querySelector<HTMLFormElement>('[data-wa-form]');
    const number = root.dataset.tipNumber;
    if (!toggle || !panel || !form || !number) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (open) panel.querySelector('textarea')?.focus();
      else toggle.focus();
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const tip = String(data.get('tip') ?? '').trim();
      if (!tip) return;
      const name = String(data.get('name') ?? '').trim();
      const text = name ? `${tip}\n\n— ${name}` : tip;
      window.open(`https://wa.me/${number}?text=${encodeURIComponent(text)}`, '_blank', 'noopener,noreferrer');
      form.reset();
    });
  });
</script>
