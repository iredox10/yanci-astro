---
import type { ArticleCard } from '../data/schema';

interface Props {
  data: ArticleCard;
  featured?: boolean;
}

const { data, featured = false } = Astro.props;
const href = `/article/${data.$id ?? data.id}`;
---

<article class={`group relative flex h-full flex-col overflow-hidden transition-all duration-500 ${featured ? 'rounded-2xl bg-gradient-to-br from-[#fdf6ed] to-[#f8f0e5] p-8' : 'rounded-xl border border-gray-100 bg-white p-6 hover:border-[#e05e00]/20 hover:shadow-xl'}`}>
  <div class={`absolute right-0 top-0 bg-[#e05e00]/5 transition-transform duration-700 group-hover:scale-150 ${featured ? '-mr-8 -mt-8 h-32 w-32 rounded-bl-full' : '-mr-4 -mt-4 h-24 w-24 rounded-bl-full'}`} />

  {featured && (
    <div class="absolute right-4 top-4">
      <span class="rounded-full bg-[#e05e00] px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white">Namijin Ra'ayi</span>
    </div>
  )}

  <div class="relative z-10 flex h-full flex-col">
    <div class={`flex items-center gap-4 ${featured ? 'mb-8' : 'mb-6'}`}>
      <div class="relative">
        <div class={`overflow-hidden rounded-full border-2 border-[#e05e00] p-0.5 shadow-lg ${featured ? 'h-16 w-16' : 'h-14 w-14'}`}>
          {data.image ? (
            <img src={data.image} alt={data.author ?? ''} loading="lazy" class="h-full w-full rounded-full object-cover transition-transform duration-500 group-hover:scale-110" />
          ) : (
            <div class="flex h-full w-full items-center justify-center rounded-full bg-gradient-to-br from-[#0f3036] to-[#1a454c] font-serif text-2xl font-bold text-white">
              {(data.author ?? 'Y')[0]}
            </div>
          )}
        </div>
        <div class="absolute -bottom-1 -right-1 flex h-7 w-7 items-center justify-center rounded-full bg-[#e05e00] p-1.5 text-white shadow-lg">
          <span class="font-serif text-sm font-black">"</span>
        </div>
      </div>
      <div>
        <div class="mb-1 text-[10px] font-bold uppercase tracking-widest text-[#e05e00]">Ra'ayi</div>
        <div class={`font-serif font-bold leading-none text-[#1c1917] transition-colors group-hover:text-[#e05e00] ${featured ? 'text-xl' : 'text-lg'}`}>{data.author}</div>
      </div>
    </div>

    <a href={href}>
      <h3 class={`flex-1 font-serif font-bold leading-tight text-[#1c1917] transition-colors group-hover:text-[#e05e00] ${featured ? 'mb-4 text-3xl md:text-4xl' : 'mb-4 text-xl'}`}>{data.headline}</h3>
    </a>

    {data.trail && (
      <div class="mt-auto border-l-2 border-[#e05e00]/30 pl-4">
        <p class="line-clamp-3 font-serif text-sm italic leading-relaxed text-gray-500">{data.trail}</p>
      </div>
    )}
  </div>
</article>