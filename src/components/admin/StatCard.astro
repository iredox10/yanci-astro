---
import { createElement, type ComponentType } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';

interface Props {
  title?: string;
  label?: string;
  value: string | number;
  icon?: ComponentType<{ className?: string }>;
  color?: string;
}

const { title, label, value, icon: Icon, color = 'bg-blue-500' } = Astro.props;
const displayTitle = title ?? label ?? '';

const iconHtml = Icon
  ? renderToStaticMarkup(
      createElement(Icon, { className: 'w-5 h-5 md:w-6 md:h-6 text-white' }),
    )
  : null;
---

<div class="bg-white p-4 md:p-6 rounded-lg shadow-sm border border-gray-200 flex items-center justify-between">
  <div>
    <p class="text-xs md:text-sm text-gray-500 font-medium uppercase tracking-wider">{displayTitle}</p>
    <h3 class="text-2xl md:text-3xl font-bold text-gray-900 mt-1">{value}</h3>
  </div>
  {
    iconHtml && (
      <div class={`p-2 md:p-3 rounded-full ${color}`} set:html={iconHtml} />
    )
  }
</div>
