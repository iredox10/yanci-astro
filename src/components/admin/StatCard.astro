---
import { createElement, type ComponentType } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';

interface Props {
  label: string;
  value: string;
  icon?: ComponentType<{ className?: string }>;
  color?: string;
}

const { label, value, icon: Icon, color = 'bg-blue-500' } = Astro.props;

const iconHtml = Icon
  ? renderToStaticMarkup(
      createElement(Icon, { className: 'h-5 w-5 text-white md:h-6 md:w-6' }),
    )
  : null;
---

<div class="flex items-center justify-between rounded-lg border border-gray-200 bg-white p-4 shadow-sm md:p-6">
  <div>
    <p class="text-xs font-medium uppercase tracking-wider text-gray-500 md:text-sm">{label}</p>
    <h3 class="mt-1 text-2xl font-bold text-gray-900 md:text-3xl">{value}</h3>
  </div>
  {
    iconHtml && (
      <div class:list={['rounded-full p-2 md:p-3', color]} set:html={iconHtml} />
    )
  }
</div>
