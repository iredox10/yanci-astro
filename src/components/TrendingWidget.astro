---
import type { ArticleCard } from '../data/schema';

interface Props {
  articles: ArticleCard[];
  limit?: number;
  title?: string;
  className?: string;
}

const { articles, limit = 5, title = 'Labarai Mafiya Karanta', className = '' } = Astro.props;
const mostRead = articles.slice(0, limit);
---

<aside class={`overflow-hidden rounded-lg border border-gray-200 bg-white ${className}`}>
  <div class="flex items-center gap-2 bg-[#0f3036] px-4 py-3 text-sm font-bold uppercase tracking-widest text-white">
    <span aria-hidden="true">🔥</span>
    <h3>{title}</h3>
  </div>
  <ol class="divide-y divide-gray-100">
    {mostRead.map((article, index) => (
      <li>
        <a href={`/article/${article.$id ?? article.id}`} class="group flex items-start gap-3 px-4 py-3 transition-colors hover:bg-gray-50">
          <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-gray-100 text-sm font-black text-gray-500 transition-colors group-hover:bg-[#0f3036] group-hover:text-white">{index + 1}</span>
          <div class="min-w-0 flex-1">
            <h4 class="line-clamp-2 text-sm font-bold leading-snug text-gray-800 transition-colors group-hover:text-[#0f3036]">{article.headline}</h4>
          </div>
        </a>
      </li>
    ))}
  </ol>
</aside>