---
import '../styles/global.css';
import { createElement, type ComponentType } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import {
  FaArrowRightFromBracket,
  FaBars,
  FaBell,
  FaCalendarDays,
  FaChartBar,
  FaChartLine,
  FaChartPie,
  FaCheckToSlot,
  FaCirclePlus,
  FaComment,
  FaFileLines,
  FaGear,
  FaImage,
  FaMagnifyingGlassChart,
  FaNewspaper,
  FaPalette,
  FaPhotoFilm,
  FaRightFromBracket,
  FaRobot,
  FaRotateRight,
  FaShieldHalved,
  FaStar,
  FaTowerBroadcast,
  FaTrophy,
  FaUser,
  FaUserShield,
  FaUsers,
  FaXmark,
} from 'react-icons/fa6';
import { requireUser, roleName } from '@lib/auth';

interface Props {
  title?: string;
  active?: string;
}

type IconCmp = ComponentType<{ className?: string }>;

const { title = 'Admin' } = Astro.props;
const auth = await requireUser(Astro.request);

const ic = (Icon: IconCmp, cls = 'w-5 h-5 shrink-0') =>
  renderToStaticMarkup(createElement(Icon, { className: cls }));

type NavEntry =
  | { header: string }
  | { href: string; label: string; Icon: IconCmp };

const NAV: NavEntry[] = [
  { href: '/admin', label: 'Dashboard', Icon: FaChartPie },
  { href: '/admin/articles', label: 'Articles', Icon: FaFileLines },
  { href: '/admin/calendar', label: 'Calendar', Icon: FaCalendarDays },
  { href: '/admin/live', label: 'Live Coverage', Icon: FaTowerBroadcast },
  { href: '/admin/elections', label: 'Elections', Icon: FaCheckToSlot },
  { href: '/admin/media', label: 'Media Library', Icon: FaImage },
  { href: '/admin/multimedia', label: 'Multimedia', Icon: FaPhotoFilm },
  { href: '/admin/sports', label: 'Sports', Icon: FaTrophy },
  { href: '/admin/highlights', label: 'Highlight Panels', Icon: FaStar },
  { href: '/admin/newsletter', label: 'Newsletter', Icon: FaNewspaper },
  { href: '/admin/comments', label: 'Comments', Icon: FaComment },
  { href: '/admin/analytics', label: 'Analytics', Icon: FaChartLine },
  { href: '/admin/reports', label: 'AI Reports', Icon: FaChartBar },
  { href: '/admin/homepage-stats', label: 'Homepage Stats', Icon: FaChartLine },
  { href: '/admin/homepage', label: 'Homepage Builder', Icon: FaPalette },
  { href: '/admin/seo', label: 'SEO & Metadata', Icon: FaShieldHalved },
  { href: '/admin/content-gap', label: 'Content Gaps', Icon: FaMagnifyingGlassChart },
  { href: '/admin/reviver', label: 'Article Reviver', Icon: FaRotateRight },
  { href: '/admin/autofetch', label: 'Auto Fetcher', Icon: FaRobot },
  { href: '/admin/notifications', label: 'Notifications', Icon: FaBell },
  { header: 'Administration' },
  { href: '/admin/users', label: 'Users', Icon: FaUsers },
  { href: '/admin/roles', label: 'Roles & Permissions', Icon: FaUserShield },
  { href: '/admin/settings', label: 'Settings', Icon: FaGear },
  { header: 'Content' },
  { href: '/admin/articles/new', label: 'New Article', Icon: FaCirclePlus },
];

const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/admin';
const bestHref = NAV.filter(
  (l): l is Exclude<NavEntry, { header: string }> =>
    !('header' in l) && (rawPath === l.href || rawPath.startsWith(`${l.href}/`) || (l.href === '/admin' && rawPath === '/admin/dashboard')),
)
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;

const userName = auth.ok ? auth.user.name : 'Staff';
const roleLabel = auth.ok ? roleName(auth.user.role) : 'Editor';
const initial = userName.charAt(0).toUpperCase();
---

<!doctype html>
<html lang="ha" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/icons/yc-mark.svg" />
    <title>{title} — Yanci Admin</title>
    <style>
      @media (min-width: 1024px) {
        #admin-sidebar {
          position: relative !important;
          transform: translateX(0) !important;
        }
        #admin-overlay {
          display: none !important;
        }
      }
    </style>
  </head>
  <body class="bg-gray-100 font-sans text-yanci-dark antialiased">
    <div class="flex h-screen overflow-hidden bg-gray-100 font-sans">
      <div id="admin-overlay" class="fixed inset-0 z-40 hidden bg-black/50 lg:hidden" aria-hidden="true"></div>

      <aside
        id="admin-sidebar"
        class="fixed inset-y-0 left-0 z-50 flex w-64 shrink-0 -translate-x-full transform flex-col bg-[#0f3036] text-white transition-transform duration-300 lg:relative lg:translate-x-0"
      >
        <div class="flex items-center justify-between border-b border-white/10 p-6">
          <div>
            <h1 class="font-serif text-2xl font-black tracking-tighter text-white">
              Yanci<span class="text-[#c59d5f]">.</span> Admin
            </h1>
            <div class="mt-2 text-xs text-gray-400">
              Logged in as <br />
              <span class="text-sm font-bold text-white">{userName}</span>
              <span class="block capitalize text-[#c59d5f]">{roleLabel}</span>
            </div>
          </div>
          <button
            id="sidebar-close"
            class="rounded-full p-2 text-white hover:bg-white/10 lg:hidden"
            aria-label="Close menu"
          >
            <span set:html={ic(FaXmark, 'w-6 h-6 text-white')} />
          </button>
        </div>

        <nav class="flex-1 space-y-1 overflow-y-auto p-4">
          {NAV.map((entry) =>
            'header' in entry ? (
              <div class="px-4 pb-1 pt-2 text-[10px] font-bold uppercase tracking-widest text-white/30">
                {entry.header}
              </div>
            ) : (
              <a
                href={entry.href}
                class:list={[
                  'flex items-center gap-3 rounded-md px-4 py-3 transition-colors',
                  bestHref === entry.href
                    ? 'bg-[#c59d5f] font-bold text-[#0f3036]'
                    : 'hover:bg-white/10',
                ]}
              >
                <span set:html={ic(entry.Icon)} />
                {entry.label}
              </a>
            ),
          )}
        </nav>

        <div class="space-y-2 border-t border-white/10 p-4">
          <a
            href="/admin/profile"
            class:list={[
              'flex items-center gap-3 rounded-md px-4 py-3 text-sm transition-colors',
              bestHref === '/admin/profile'
                ? 'bg-[#c59d5f] font-bold text-[#0f3036]'
                : 'text-gray-300 hover:bg-white/10 hover:text-white',
            ]}
          >
            <span set:html={ic(FaUser)} /> My Profile
          </a>
          <form method="post" action="/api/auth/logout">
            <button
              type="submit"
              class="flex w-full items-center gap-3 rounded-md px-4 py-3 text-left text-sm text-gray-300 transition-colors hover:bg-white/10 hover:text-white"
            >
              <span set:html={ic(FaArrowRightFromBracket)} /> Logout
            </button>
          </form>
          <a
            href="/"
            class="flex items-center gap-3 rounded-md px-4 py-3 text-sm text-red-400 transition-colors hover:bg-red-600/20 hover:text-red-300"
          >
            <span set:html={ic(FaRightFromBracket)} /> Back to Site
          </a>
        </div>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col overflow-hidden">
        <header class="flex h-16 shrink-0 items-center justify-between bg-[#0f3036] px-4 text-white shadow-md lg:hidden">
          <button
            id="sidebar-open"
            class="rounded-md p-2 hover:bg-white/10"
            aria-label="Open menu"
          >
            <span set:html={ic(FaBars, 'w-6 h-6 text-white')} />
          </button>
          <h1 class="font-serif text-xl font-black tracking-tighter text-white">
            Yanci<span class="text-[#c59d5f]">.</span>
          </h1>
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#c59d5f]/20 text-xs font-bold text-[#c59d5f]">
            {initial}
          </div>
        </header>

        <main id="admin-main" class="flex h-full min-w-0 flex-1 flex-col overflow-hidden bg-gray-50">
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      const sidebar = document.getElementById('admin-sidebar');
      const overlay = document.getElementById('admin-overlay');
      const openBtn = document.getElementById('sidebar-open');
      const closeBtn = document.getElementById('sidebar-close');
      function setOpen(open) {
        if (!sidebar || !overlay) return;
        sidebar.classList.toggle('-translate-x-full', !open);
        overlay.classList.toggle('hidden', !open);
        document.body.style.overflow = open && window.innerWidth < 1024 ? 'hidden' : '';
      }
      openBtn?.addEventListener('click', () => setOpen(true));
      closeBtn?.addEventListener('click', () => setOpen(false));
      overlay?.addEventListener('click', () => setOpen(false));
      sidebar?.addEventListener('click', (e) => {
        const t = e.target;
        if (t && t.closest && t.closest('a') && window.innerWidth < 1024) setOpen(false);
      });
    </script>
  </body>
</html>
