---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getSettings } from '@lib/appwrite-server';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  disableNav?: boolean;
  disableFooter?: boolean;
}

const settings = await getSettings();
const siteName = settings.site_name || 'Yanci';
const siteTagline = settings.tagline || 'Jaridar Hausa mai zuwa';

const {
  title = `${siteName} — ${siteTagline}`,
  description = settings.default_meta_desc ||
    'Yanci: Jaridar Hausa mai zuwa. Labarai, siyasa, wasanni da al’adu a yaren Hausa, kai tsaye daga Najeriya.',
  path = '/',
  disableNav = false,
  disableFooter = false,
} = Astro.props;

const canonical = new URL(path, Astro.site ?? settings.site_url ?? 'https://yanci.ng').href;
---

<!doctype html>
<html lang="ha">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Frank+Ruhl+Libre:wght@300;400;500;700;900&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    {!disableNav && <Nav />}
    <main class="flex-1">
      <slot />
    </main>
    {!disableFooter && <Footer />}
  </body>
</html>