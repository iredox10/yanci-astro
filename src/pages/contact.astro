---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSettings } from '@lib/appwrite-server';

export const prerender = false;

const settings = await getSettings();
const contactEmail = settings.contact_email || 'labulabari@yanci.ng';
const advertiseEmail = settings.advertising_email || 'tallace-tallace@yanci.ng';
---

<BaseLayout
  title="Tuntube Mu — Yanci"
  description="Tuntuɓi tawagar Yanci."
  path="/contact/"
>
  <main class="mx-auto max-w-[900px] px-4 py-16 md:px-6">
    <span class="text-xs font-bold uppercase tracking-widest text-yanci-accent">Kamfanin mu</span>
    <h1 class="mt-2 font-serif text-4xl font-black text-yanci-primary">Tuntube Mu</h1>
    <p class="mt-4 max-w-2xl text-gray-600">
      Kuna da labari? Kuna son tallata wa? Ko kuna da tambaya? Tuntuɓi tawagarmu ta hanyar imel ko shafin da ke ƙasa.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      <a href={`mailto:${contactEmail}`} class="group rounded-2xl border border-gray-100 bg-white p-8 shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl">
        <h2 class="font-serif text-xl font-bold text-yanci-primary">Labarai / Editan</h2>
        <p class="mt-2 text-sm text-gray-500">Aiko mana labari ko rahoto na bincike.</p>
        <p class="mt-4 break-all font-medium text-yanci-teal group-hover:underline">{contactEmail}</p>
      </a>
      <a href={`mailto:${advertiseEmail}`} class="group rounded-2xl border border-gray-100 bg-white p-8 shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl">
        <h2 class="font-serif text-xl font-bold text-yanci-primary">Tallace-tallace</h2>
        <p class="mt-2 text-sm text-gray-500">Domin talla da haɗin gwiwar kasuwanci.</p>
        <p class="mt-4 break-all font-medium text-yanci-teal group-hover:underline">{advertiseEmail}</p>
      </a>
    </div>

    <form class="mt-10 rounded-2xl border border-gray-100 bg-white p-8 shadow-sm" method="post" action="/api/contact">
      <h2 class="font-serif text-xl font-bold text-yanci-primary">Aiko sako</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1 block text-xs font-bold uppercase tracking-wide text-yanci-primary/70">Sunanka</span>
          <input type="text" name="name" required placeholder="Sunanka"
            class="w-full border border-yanci-primary/25 bg-white px-3 py-2.5 text-sm focus:border-yanci-accent focus:outline-none focus:ring-2 focus:ring-yanci-accent/40" />
        </label>
        <label class="block">
          <span class="mb-1 block text-xs font-bold uppercase tracking-wide text-yanci-primary/70">Imel</span>
          <input type="email" name="email" required placeholder="you@example.com"
            class="w-full border border-yanci-primary/25 bg-white px-3 py-2.5 text-sm focus:border-yanci-accent focus:outline-none focus:ring-2 focus:ring-yanci-accent/40" />
        </label>
        <label class="block sm:col-span-2">
          <span class="mb-1 block text-xs font-bold uppercase tracking-wide text-yanci-primary/70">Sako</span>
          <textarea name="message" required rows={6} placeholder="Rubuta sakonka…"
            class="w-full border border-yanci-primary/25 bg-white px-3 py-2.5 text-sm focus:border-yanci-accent focus:outline-none focus:ring-2 focus:ring-yanci-accent/40"></textarea>
        </label>
      </div>
      <button type="submit" class="mt-6 bg-yanci-primary px-8 py-3 text-sm font-bold uppercase tracking-wide text-yanci-paper hover:bg-yanci-primary/90">
        Aika sako
      </button>
      <p id="contact-msg" class="mt-3 text-xs text-yanci-red"></p>
    </form>
  </main>
</BaseLayout>

<script>
  const form = document.querySelector('form[action="/api/contact"]') as HTMLFormElement;
  const msg = document.getElementById('contact-msg');
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    msg!.textContent = '';
    const fd = new FormData(form);
    const res = await fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: fd.get('name'),
        email: fd.get('email'),
        message: fd.get('message'),
      }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      form.innerHTML = '<p class="py-8 text-center font-serif text-lg font-bold text-emerald-700">Na gode! Mun samu sakonka.</p>';
    } else {
      msg!.textContent = data.message ?? 'An samu matsala. Sake gwadawa.';
    }
  });
</script>
