---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import { FaBell, FaPaperPlane, FaUsers, FaTrash } from 'react-icons/fa6';

export const prerender = false;

type IconCmp = React.ComponentType<{ className?: string }>;
const ic = (Icon: IconCmp, cls = 'w-5 h-5 shrink-0') =>
  renderToStaticMarkup(createElement(Icon, { className: cls }));
---

<AdminLayout title="Notifications" active="notifications">
    <div class="flex-1 overflow-y-auto p-4 md:p-8">
      <div class="space-y-8">
        <!-- Header -->
        <div>
          <h2 class="text-2xl font-bold text-gray-900">Push Notifications</h2>
          <p class="text-sm text-gray-500 mt-1">
            Send breaking news alerts to readers who have installed the Yanci PWA.
          </p>
        </div>

        <!-- Status Card -->
        <div class="bg-white border border-gray-200 rounded-lg p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <span set:html={ic(FaBell, 'w-4 h-4 text-blue-600')} />
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Notification Status</h3>
                <p id="notif-support" class="text-sm text-gray-500">
                  Push notifications supported
                </p>
              </div>
            </div>
            <span
              id="notif-badge"
              class="px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-600"
            >
              Not subscribed
            </span>
          </div>

          <div class="flex items-center gap-6 text-sm">
            <div class="flex items-center gap-2 text-gray-600">
              <span set:html={ic(FaUsers, 'w-4 h-4 text-gray-400')} />
              <span id="subscriber-count">0 subscribers</span>
            </div>
            <div class="flex items-center gap-2">
              <button
                id="btn-subscribe"
                type="button"
                class="text-blue-600 hover:text-blue-700 font-medium"
              >
                Subscribe to test
              </button>
              <button
                id="btn-unsubscribe"
                type="button"
                class="text-red-600 hover:text-red-700 font-medium hidden items-center gap-1"
              >
                <span set:html={ic(FaTrash, 'w-3 h-3')} /> Unsubscribe
              </button>
            </div>
          </div>
        </div>

        <!-- Send Notification Form -->
        <div class="bg-white border border-gray-200 rounded-lg p-6">
          <h3 class="font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <span set:html={ic(FaPaperPlane, 'w-4 h-4 text-gray-400')} />
            Send Breaking News Alert
          </h3>

          <div id="sent-banner" class="mb-4 p-3 bg-green-50 border border-green-200 rounded-lg text-green-700 text-sm hidden">
            Notification sent successfully!
          </div>

          <form id="notif-form" class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">
                Title
              </label>
              <input
                id="notif-title"
                type="text"
                placeholder="Kai Tsaye: ..."
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">
                Message
              </label>
              <textarea
                id="notif-body"
                placeholder="Brief description of the breaking news..."
                required
                rows="3"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              ></textarea>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">
                Link URL (optional)
              </label>
              <input
                id="notif-url"
                type="text"
                placeholder="/article/123"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>

            <div class="flex items-center gap-3 pt-2">
              <button
                id="notif-send"
                type="submit"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2"
              >
                <span set:html={ic(FaPaperPlane, 'w-4 h-4')} />
                <span id="send-label">Send to All Subscribers</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Info -->
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
          <h4 class="font-medium text-amber-800 mb-2">Setup Required</h4>
          <p class="text-sm text-amber-700">
            To enable push notifications in production, you need to:
          </p>
          <ol class="text-sm text-amber-700 mt-2 list-decimal list-inside space-y-1">
            <li>Generate VAPID keys (run <code class="bg-amber-100 px-1 rounded">npx web-push generate-vapid-keys</code>)</li>
            <li>Add <code class="bg-amber-100 px-1 rounded">VITE_VAPID_PUBLIC_KEY</code> to your <code class="bg-amber-100 px-1 rounded">.env</code></li>
            <li>Deploy an Appwrite Cloud Function to handle push delivery via the <code class="bg-amber-100 px-1 rounded">web-push</code> library</li>
            <li>Create a <code class="bg-amber-100 px-1 rounded">notifications</code> collection in Appwrite to store subscriptions</li>
          </ol>
        </div>
      </div>
    </div>
</AdminLayout>

<script is:inline>
  const supportEl = document.getElementById('notif-support');
  const badgeEl = document.getElementById('notif-badge');
  const subCountEl = document.getElementById('subscriber-count');
  const btnSub = document.getElementById('btn-subscribe');
  const btnUnsub = document.getElementById('btn-unsubscribe');
  const form = document.getElementById('notif-form');
  const titleEl = document.getElementById('notif-title');
  const bodyEl = document.getElementById('notif-body');
  const urlEl = document.getElementById('notif-url');
  const sendBtn = document.getElementById('notif-send');
  const sendLabel = document.getElementById('send-label');
  const sentBanner = document.getElementById('sent-banner');

  let isSubscribed = false;
  let permission = Notification ? Notification.permission : 'default';
  const isSupported = 'serviceWorker' in navigator && 'PushManager' in window;

  function updateBadge() {
    if (!badgeEl || !supportEl || !btnSub || !btnUnsub) return;
    if (!isSupported) {
      supportEl.textContent = 'Push notifications not supported in this browser';
      badgeEl.textContent = 'Not subscribed';
      badgeEl.className = 'px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-600';
      btnSub.classList.add('hidden');
      btnUnsub.classList.add('hidden');
      return;
    }
    supportEl.textContent = 'Push notifications supported';
    if (isSubscribed) {
      badgeEl.textContent = 'Subscribed';
      badgeEl.className = 'px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700';
      btnSub.classList.add('hidden');
      btnUnsub.classList.remove('hidden');
      btnUnsub.classList.add('flex');
    } else if (permission === 'denied') {
      badgeEl.textContent = 'Blocked';
      badgeEl.className = 'px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700';
      btnSub.classList.remove('hidden');
      btnUnsub.classList.add('hidden');
    } else {
      badgeEl.textContent = 'Not subscribed';
      badgeEl.className = 'px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-600';
      btnSub.classList.remove('hidden');
      btnUnsub.classList.add('hidden');
    }
    if (btnSub) btnSub.disabled = !isSupported;
  }

  // Try to fetch subscriber count
  fetch('/api/notifications/count').then((r) => r.json()).then((d) => {
    if (d && typeof d.count === 'number' && subCountEl) {
      subCountEl.textContent = `${d.count} subscribers`;
    }
  }).catch(() => {});

  // Check existing subscription status from localStorage or pushManager
  async function checkSubscription() {
    if (!isSupported) { updateBadge(); return; }
    try {
      const reg = await navigator.serviceWorker.ready;
      const sub = await reg.pushManager.getSubscription();
      isSubscribed = !!sub;
      permission = Notification.permission;
    } catch {
      permission = Notification.permission;
    }
    updateBadge();
  }
  checkSubscription();

  async function enablePush() {
    if (!isSupported) return;
    try {
      const perm = await Notification.requestPermission();
      permission = perm;
      if (perm !== 'granted') { updateBadge(); return; }
      const reg = await navigator.serviceWorker.ready;
      // Try to subscribe with VAPID key if available (fallback without)
      let vapidKey = null;
      try {
        const r = await fetch('/api/notifications/vapid');
        if (r.ok) {
          const j = await r.json();
          vapidKey = j.publicKey || null;
        }
      } catch {}
      const sub = await reg.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: vapidKey ? urlBase64ToUint8Array(vapidKey) : undefined,
      });
      // send to server
      await fetch('/api/notifications/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(sub),
      });
      isSubscribed = true;
    } catch (e) {
      console.error('[push] enable failed', e);
    }
    updateBadge();
  }

  async function disablePush() {
    try {
      const reg = await navigator.serviceWorker.ready;
      const sub = await reg.pushManager.getSubscription();
      if (sub) {
        await sub.unsubscribe();
        await fetch('/api/notifications/unsubscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ endpoint: sub.endpoint }),
        });
      }
      isSubscribed = false;
    } catch (e) {
      console.error('[push] disable failed', e);
    }
    updateBadge();
  }

  function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - base64String.length % 4) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const rawData = window.atob(base64);
    const outputArray = new Uint8Array(rawData.length);
    for (let i = 0; i < rawData.length; ++i) outputArray[i] = rawData.charCodeAt(i);
    return outputArray;
  }

  if (btnSub) btnSub.addEventListener('click', enablePush);
  if (btnUnsub) btnUnsub.addEventListener('click', disablePush);

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = titleEl ? titleEl.value.trim() : '';
      const body = bodyEl ? bodyEl.value.trim() : '';
      const url = urlEl ? urlEl.value.trim() : '';
      if (!title || !body) return;
      if (sendBtn) sendBtn.disabled = true;
      if (sendLabel) sendLabel.textContent = 'Sending...';
      try {
        console.log('[Admin] Sending notification:', { title, body, url });
        // Try server endpoint
        try {
          await fetch('/api/notifications/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ title, body, url }),
          });
        } catch {}
        // Local notification for testing
        if ('serviceWorker' in navigator && Notification.permission === 'granted') {
          const registration = await navigator.serviceWorker.ready;
          await registration.showNotification(title, {
            body,
            icon: '/pwa-192x192.png',
            badge: '/pwa-192x192.png',
            data: { url },
            tag: 'breaking-news',
            renotify: true,
            requireInteraction: true,
          });
        }
        if (sentBanner) {
          sentBanner.classList.remove('hidden');
          setTimeout(() => sentBanner.classList.add('hidden'), 3000);
        }
      } catch (error) {
        console.error('[Admin] Error sending notification:', error);
      } finally {
        if (sendBtn) sendBtn.disabled = false;
        if (sendLabel) sendLabel.textContent = 'Send to All Subscribers';
        // disable if fields empty
        if (sendBtn) {
          const disabled = !titleEl.value.trim() || !bodyEl.value.trim();
          // keep enabled after send; validation will handle next
        }
      }
    });

    // enable/disable send button based on fields
    function updateSendState() {
      if (!sendBtn || !titleEl || !bodyEl) return;
      const disabled = !titleEl.value.trim() || !bodyEl.value.trim();
      sendBtn.disabled = disabled;
    }
    if (titleEl) titleEl.addEventListener('input', updateSendState);
    if (bodyEl) bodyEl.addEventListener('input', updateSendState);
    updateSendState();
  }

  updateBadge();
</script>
