---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminArticlesClient from '../../components/admin/AdminArticlesClient';
import { getArticles } from '@lib/appwrite-server';
import { requireUser } from '@lib/auth';

export const prerender = false;

const auth = await requireUser(Astro.request);
if (!auth.ok) return Astro.redirect('/admin/login?next=/admin/articles');

const allArticles = await getArticles(500);
const userCategory = (auth.user as any)?.category ?? null;

const normalizedArticles = allArticles.map((a: any) => ({
  $id: a.$id,
  id: a.$id ?? a.id,
  headline: a.headline ?? a.title ?? '',
  kicker: a.kicker ?? '',
  trail: a.trail ?? '',
  image: a.image ?? '',
  pillar: a.pillar ?? 'news',
  section: a.section ?? '',
  author: a.author ?? '',
  format: a.format ?? 'news',
  status: a.status ?? 'published',
  review_status: a.review_status ?? 'pending',
  slug: a.slug ?? '',
  publishAt: a.publishAt ?? '',
  $createdAt: a.$createdAt ?? '',
  $updatedAt: a.$updatedAt ?? '',
  tags: a.tags ?? [],
}));
---

<AdminLayout title="Labarai" active="articles">
  <AdminArticlesClient client:only="react" initialArticles={normalizedArticles} userCategory={userCategory} />
</AdminLayout>
