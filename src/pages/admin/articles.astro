---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getArticles } from '@lib/appwrite-server';
import { requireUser } from '@lib/auth';
import AdminArticlesClient from '../../components/admin/AdminArticlesClient';

export const prerender = false;

const articles = await getArticles(500);
const auth = await requireUser(Astro.request);
const userCategory = auth.ok ? (auth.user as any)?.category ?? null : null;

// Serialize for client island – ensure JSON-safe
const serialized = articles.map((a) => ({
  $id: a.$id,
  id: (a as any).id ?? a.$id,
  headline: a.headline,
  kicker: (a as any).kicker ?? '',
  trail: a.trail,
  body: a.body,
  image: a.image,
  pillar: a.pillar,
  section: a.section,
  type: (a as any).type ?? 'standard',
  author: a.author,
  coAuthor: (a as any).coAuthor ?? '',
  format: (a as any).format ?? 'news',
  status: a.status ?? 'published',
  review_status: (a as any).review_status ?? 'approved',
  slug: a.slug,
  publishAt: (a as any).publishAt ?? a.publishAt,
  $createdAt: a.$createdAt,
  $updatedAt: a.$updatedAt,
  tags: a.tags,
  isLive: a.isLive,
  isSensitive: a.isSensitive,
  imageFocalX: (a as any).imageFocalX,
  imageFocalY: (a as any).imageFocalY,
}));
---

<AdminLayout title="Labarai" active="articles">
  <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6">
    <AdminArticlesClient client:load initialArticles={serialized} userCategory={userCategory} />
  </div>
</AdminLayout>
