---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getArticles } from '@lib/appwrite-server';
import { requireUser } from '@lib/auth';

export const prerender = false;

const auth = await requireUser(Astro.request);
if (!auth.ok) return Astro.redirect('/admin/login?next=/admin/articles');

const allArticles = await getArticles(500);
const url = new URL(Astro.request.url);
const filterStatus = url.searchParams.get('status') ?? 'all';
const searchQuery = url.searchParams.get('q') ?? '';
const page = parseInt(url.searchParams.get('page') ?? '1', 10) || 1;
const ITEMS_PER_PAGE = 20;

let filtered = [...allArticles];
if (filterStatus !== 'all') filtered = filtered.filter(a => (a.status || 'published') === filterStatus);
if (searchQuery) {
  const q = searchQuery.toLowerCase();
  filtered = filtered.filter(a => (a.headline||'').toLowerCase().includes(q) || (a.tags||'').toString().toLowerCase().includes(q));
}
filtered.sort((a,b) => new Date(b.$createdAt || 0).getTime() - new Date(a.$createdAt || 0).getTime());

const totalPages = Math.max(1, Math.ceil(filtered.length / ITEMS_PER_PAGE));
const paginated = filtered.slice((page-1)*ITEMS_PER_PAGE, page*ITEMS_PER_PAGE);

const statusCounts = {
  all: allArticles.length,
  published: allArticles.filter(a => (a.status||'published')==='published').length,
  draft: allArticles.filter(a => (a.status||'published')==='draft').length,
  scheduled: allArticles.filter(a => (a.status||'published')==='scheduled').length,
  review: allArticles.filter(a => (a.status||'published')==='review').length,
};
---

<AdminLayout title="Labarai" active="articles">
  <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl md:text-2xl font-bold text-gray-800">Labarai</h2>
        <p class="text-sm text-gray-500 mt-1">{filtered.length} articles found</p>
      </div>
      <a href="/admin/articles/new" class="bg-[#0f3036] text-white px-4 py-2.5 rounded-md flex items-center justify-center gap-2 hover:bg-[#1a454c] font-bold text-sm w-full sm:w-auto">
        + Sabon Labari
      </a>
    </div>

    <div class="flex flex-wrap gap-2 border-b border-gray-200 pb-2">
      {Object.entries({all:'Duka', published:'An Buga', draft:'Daftari', scheduled:'Jadawalin', review:'Duba'}).map(([key,label]) => (
        <a href={`/admin/articles?status=${key}${searchQuery?`&q=${encodeURIComponent(searchQuery)}`:''}`} class={`px-3 py-1.5 rounded-full text-xs font-bold border ${filterStatus===key?'bg-[#0f3036] text-white border-[#0f3036]':'bg-white text-gray-500 border-gray-200'}`}>{label} <span class="ml-1 px-1.5 py-0.5 rounded-full text-[10px] bg-gray-100">{statusCounts[key as keyof typeof statusCounts]}</span></a>
      ))}
    </div>

    <form method="get" class="flex gap-2">
      <input type="text" name="q" value={searchQuery} placeholder="Search articles..." class="flex-1 pl-3 pr-3 py-2.5 text-xs border border-gray-200 rounded-lg bg-white focus:ring-2 focus:ring-[#c59d5f] outline-none" />
      <input type="hidden" name="status" value={filterStatus} />
      <button type="submit" class="px-4 py-2 bg-[#0f3036] text-white rounded-lg text-xs font-bold">Search</button>
      {searchQuery && <a href={`/admin/articles?status=${filterStatus}`} class="px-4 py-2 text-xs font-bold text-red-600 border border-gray-200 rounded-lg">Clear</a>}
    </form>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[700px]">
          <thead class="bg-gray-50 text-gray-600 uppercase tracking-wider border-b border-gray-200">
            <tr>
              <th class="p-4">Labari</th>
              <th class="p-4 w-24">Matsayi</th>
              <th class="p-4 w-24 hidden lg:table-cell">Pillar</th>
              <th class="p-4 w-36 hidden md:table-cell">Kwanan Wata</th>
              <th class="p-4 text-right w-36">Ayyuka</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {paginated.map(article => (
              <tr class="hover:bg-gray-50">
                <td class="p-4">
                  <div class="flex items-center gap-3">
                    {article.image && <img src={article.image} alt="" class="w-10 h-10 rounded object-cover bg-gray-100 shrink-0" />}
                    <div class="min-w-0">
                      <p class="font-bold text-gray-900 line-clamp-1">{article.headline || 'Untitled'}</p>
                      <p class="text-[10px] text-gray-500 uppercase tracking-wider">{(article as any).kicker || ''}</p>
                    </div>
                  </div>
                </td>
                <td class="p-4"><span class="px-2 py-0.5 rounded text-[10px] font-black border bg-green-50 text-green-700 border-green-200">{article.status || 'published'}</span></td>
                <td class="p-4 hidden lg:table-cell"><span class="px-2 py-0.5 rounded text-[10px] font-black border uppercase bg-gray-100">{article.pillar}</span></td>
                <td class="p-4 text-gray-500 text-xs hidden md:table-cell whitespace-nowrap">{article.$createdAt ? new Date(article.$createdAt).toLocaleDateString() : ''}</td>
                <td class="p-4 text-right">
                  <div class="flex items-center justify-end gap-1">
                    <a href={`/article/${article.$id}`} target="_blank" class="p-2 text-gray-400 hover:bg-gray-100 rounded-full" title="View">👁</a>
                    <a href={`/admin/articles/${article.$id}`} class="p-2 text-blue-600 hover:bg-blue-50 rounded-full" title="Edit">✏️</a>
                    <form method="post" action={`/api/admin/articles/${article.$id}?_method=DELETE`} class="inline">
                      <button type="submit" class="p-2 text-red-600 hover:bg-red-50 rounded-full" title="Delete" onclick="return confirm('Shin kana son share wannan labari?')">🗑</button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {totalPages > 1 && (
        <div class="flex items-center justify-between px-4 py-3 border-t border-gray-100 bg-gray-50">
          <p class="text-xs text-gray-500">Showing {(page-1)*ITEMS_PER_PAGE+1}–{Math.min(page*ITEMS_PER_PAGE, filtered.length)} of {filtered.length}</p>
          <div class="flex items-center gap-1">
            <a href={`/admin/articles?status=${filterStatus}&q=${encodeURIComponent(searchQuery)}&page=${Math.max(1,page-1)}`} class={`p-2 rounded-lg hover:bg-gray-200 ${page===1?'opacity-30 pointer-events-none':''}`}>‹</a>
            {Array.from({length: Math.min(5, totalPages)}, (_,i) => {
              let n = i+1;
              if (totalPages>5 && page>3) n = Math.min(totalPages-4, page-2)+i;
              return <a href={`/admin/articles?status=${filterStatus}&q=${encodeURIComponent(searchQuery)}&page=${n}`} class={`w-8 h-8 rounded-lg text-xs font-bold flex items-center justify-center ${page===n?'bg-[#0f3036] text-white':'hover:bg-gray-200'}`}>{n}</a>
            })}
            <a href={`/admin/articles?status=${filterStatus}&q=${encodeURIComponent(searchQuery)}&page=${Math.min(totalPages,page+1)}`} class={`p-2 rounded-lg hover:bg-gray-200 ${page===totalPages?'opacity-30 pointer-events-none':''}`}>›</a>
          </div>
        </div>
      )}
      {filtered.length===0 && (
        <div class="p-16 text-center">
          <p class="font-bold text-gray-600 text-lg">Ba a sami labari ba</p>
          <p class="text-sm text-gray-400 mt-1">Ƙirƙiri labari na farko don ganin shi a nan.</p>
          <a href="/admin/articles/new" class="inline-flex mt-4 px-4 py-2 text-sm font-bold text-white bg-[#0f3036] rounded-lg hover:bg-[#1a454c]">Create Article</a>
        </div>
      )}
    </div>
  </div>
</AdminLayout>
