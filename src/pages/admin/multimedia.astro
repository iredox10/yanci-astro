---
import AdminLayout from '../../layouts/AdminLayout.astro';
import VideoManager from '../../components/admin/VideoManager';
import { requireUser } from '@lib/auth';
import { listVideos } from '@lib/videos';

export const prerender = false;

const videos = await listVideos();
const auth = await requireUser(Astro.request);
const canDelete = auth.ok && (auth.user.role === 'super_admin' || auth.user.role === 'managing_editor');
---

<AdminLayout title="Multimedia" active="multimedia">
  <VideoManager client:load initialVideos={videos} canDelete={canDelete} />
</AdminLayout>
