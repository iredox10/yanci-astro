---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminHighlightsClient from '../../components/admin/AdminHighlightsClient';
import { adminListCollection } from '@lib/admin-collections';

export const prerender = false;

let docs: any[] = [];
try {
  docs = await adminListCollection('highlights', 200);
} catch {}
---

<AdminLayout title="Highlights" active="highlights">
  <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6">
    <AdminHighlightsClient client:load initialHighlightsData={docs} />
  </div>
</AdminLayout>
