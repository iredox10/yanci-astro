---
import AdminLayout from '../../layouts/AdminLayout.astro';
import MediaManager from '../../components/admin/MediaManager';
import { isMediaConfigured, listMediaFiles } from '@lib/admin-media';

export const prerender = false;

const PAGE_SIZE = 48;

interface MediaItem {
  id: string;
  name: string;
  size: number;
  mimeType: string;
  createdAt: string;
  url: string;
}

let files: MediaItem[] = [];
let notice: string | null = null;

if (!isMediaConfigured()) {
  notice = 'Cloudflare R2 Storage is not configured. Set R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME, and R2_PUBLIC_URL to manage media.';
} else {
  try {
    const r2Files = await listMediaFiles(PAGE_SIZE);
    files = r2Files.map((f) => ({
      id: f.id,
      name: f.name,
      size: f.sizeOriginal,
      mimeType: f.mimeType,
      createdAt: f.createdAt,
      url: f.url,
    }));
  } catch (error) {
    console.error('[admin/media] listing failed', error);
    notice = 'Could not load media files. Check Cloudflare R2 credentials.';
  }
}
---

<AdminLayout title="Media Manager — Yanci Admin" active="media">
  <div class="p-6 md:p-8 max-w-7xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-serif font-black text-[#0f3036]">Ma'adanar Hotuna da Bidiyo</h1>
        <p class="text-sm text-gray-500 mt-1">Loda da sarrafa hotunan labarai, rubutu da marubuta a kan Cloudflare R2.</p>
      </div>
    </div>

    {notice && (
      <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-xs font-bold text-amber-800">
        {notice}
      </div>
    )}

    <MediaManager client:load initialFiles={files} />
  </div>
</AdminLayout>
