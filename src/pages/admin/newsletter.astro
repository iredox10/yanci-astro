---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminNewsletterClient from '../../components/admin/AdminNewsletterClient';
import { adminListCollection } from '@lib/admin-collections';
import { getArticles } from '@lib/appwrite-server';

export const prerender = false;

let subscribers: any[] = [];
let articles: any[] = [];
try {
  subscribers = await adminListCollection('newsletter', 2000);
} catch {}
try {
  articles = await getArticles(200);
} catch {}
---

<AdminLayout title="Newsletter" active="newsletter">
  <div class="-m-4 md:-m-8">
    <AdminNewsletterClient client:load initialSubscribers={subscribers} initialArticles={articles as unknown as any[]} />
  </div>
</AdminLayout>
