---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminSportsClient from '../../components/admin/AdminSportsClient';
import { adminListCollection } from '@lib/admin-collections';

export const prerender = false;

let initialData: any = null;
try {
  const docs: any[] = await adminListCollection('sports', 1);
  const doc = docs?.[0];
  if (doc) {
    const parse = (raw: unknown) => {
      if (Array.isArray(raw)) return raw;
      if (typeof raw === 'string') {
        try { const p = JSON.parse(raw); return Array.isArray(p) ? p : []; } catch { return []; }
      }
      return [];
    };
    const parseObj = (raw: unknown) => {
      if (raw && typeof raw === 'object') return raw as any;
      if (typeof raw === 'string') {
        try { const p = JSON.parse(raw); return p && typeof p === 'object' ? p : null; } catch { return null; }
      }
      return null;
    };
    initialData = {
      $id: doc.$id,
      liveMatches: parse((doc as any).liveMatches),
      standings: parse((doc as any).standings),
      fixtures: parse((doc as any).fixtures),
      playerOfWeek: parseObj((doc as any).playerOfWeek) ?? parseObj((doc as any).player_of_week) ?? {
        name: 'Ahmed Musa',
        team: 'Yanci Stars',
        initials: 'AM',
        goals: 5,
        assists: 3,
        rating: 9.2,
      },
    };
    // fallback to defaults if empty arrays and no previous data
    if (initialData.liveMatches.length === 0 && initialData.standings.length === 0 && initialData.fixtures.length === 0) {
      initialData = null;
    }
  }
} catch {}
---

<AdminLayout title="Sports" active="sports">
  <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6">
    <AdminSportsClient client:only="react" initialData={initialData} />
  </div>
</AdminLayout>
