---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminCrud from '../../components/admin/AdminCrud.astro';
import { adminListCollection } from '@lib/admin-collections';

export const prerender = false;

const docs = await adminListCollection('sports');
---

<AdminLayout title="Sports" active="sports">
  <AdminCrud
    collection="sports"
    title="Sports dashboard data"
    description="JSON blobs that feed the live match, standings and fixtures widgets. One document keeps all three."
    docs={docs}
    fields={[
      { key: 'liveMatches', label: 'Live matches', type: 'json', placeholder: '[{ "id": 1, "league": "NPFL", "homeTeam": "Kano Pillars", "awayTeam": "Enyimba", "homeLogo": "KP", "awayLogo": "EN", "homeScore": 2, "awayScore": 1, "minute": "67\'", "isLive": true, "events": [{ "minute": "12\'", "player": "Ibrahim Mustafa", "team": "home", "score": "1-0" }], "streamUrl": "" }]' },
      { key: 'standings', label: 'Standings', type: 'json', placeholder: '[{ "pos": 1, "team": "Kano Pillars", "p": 24, "gd": 18, "pts": 52 }]' },
      { key: 'fixtures', label: 'Fixtures', type: 'json', placeholder: '[{ "id": 1, "league": "NPFL", "home": "Kano Pillars", "away": "Shooters Stars", "date": "Sat", "time": "16:00", "stadium": "Sani Abacha Stadium" }]' },
    ]}
  />
</AdminLayout>
