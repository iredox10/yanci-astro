---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminCommentsClient from '../../components/admin/AdminCommentsClient';
import { getAllComments, getArticles } from '@lib/appwrite-server';

export const prerender = false;

let comments: any[] = [];
let articles: any[] = [];
try {
  // fetch all statuses to show total like original sample (not filtered)
  comments = await getAllComments('', 200);
} catch {}
try {
  articles = await getArticles(200);
} catch {}

// Enrich comments with articleTitle like current Astro did
const articleTitle = new Map<string, string>();
for (const a of articles as any[]) {
  if (a.$id) articleTitle.set(a.$id, a.headline ?? a.title ?? String(a.$id));
}
const enriched = comments.map((c: any) => ({
  ...c,
  articleTitle: c.articleId ? (articleTitle.get(String(c.articleId)) ?? String(c.articleId)) : '—',
}));
---

<AdminLayout title="Comments" active="comments">
  <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6">
    <AdminCommentsClient client:only="react" initialComments={enriched} />
  </div>
</AdminLayout>
