---
import AdminLayout from '../../layouts/AdminLayout.astro';
import StatCard from '../../components/admin/StatCard.astro';
import { loadArticles } from '@lib/content';
import type { Article } from '../../data/schema';

export const prerender = false;

type ArticleStatus = NonNullable<Article['status']>;

interface Chip {
  id: string;
  headline: string;
  status: ArticleStatus;
  time: string;
  section: string;
}

interface Cell {
  iso: string;
  day: number;
}

const HAUSA_MONTHS = [
  'Janairu', 'Faburairu', 'Maris', 'Afrilu', 'Mayu', 'Yuni',
  'Yuli', 'Agusta', 'Satumba', 'Oktoba', 'Nuwamba', 'Disamba',
];

const HAUSA_DAYS = ['Lahadi', 'Litinin', 'Talata', 'Laraba', 'Alhamis', "Juma'a", 'Asabar'];

const STATUS_STYLES: Record<ArticleStatus, { chip: string; dot: string }> = {
  draft: {
    chip: 'border border-gray-300 bg-gray-100 text-gray-600 hover:border-gray-400',
    dot: 'bg-gray-400',
  },
  scheduled: {
    chip: 'border border-amber-300 bg-amber-100 text-amber-800 hover:border-amber-500',
    dot: 'bg-amber-500',
  },
  published: {
    chip: 'border border-green-300 bg-green-100 text-green-800 hover:border-green-500',
    dot: 'bg-green-600',
  },
};

const WEEK_MS = 7 * 24 * 60 * 60 * 1000;
const WINDOW_WEEKS = 6;

const pad = (n: number): string => String(n).padStart(2, '0');

function isoDate(d: Date): string {
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
}

function parseYm(raw: string | null): { year: number; month: number } {
  const now = new Date();
  if (raw && /^\d{4}-(0[1-9]|1[0-2])$/.test(raw)) {
    return { year: Number(raw.slice(0, 4)), month: Number(raw.slice(5, 7)) - 1 };
  }
  return { year: now.getFullYear(), month: now.getMonth() };
}

function shiftYm(year: number, month: number, delta: number): string {
  const d = new Date(year, month + delta, 1);
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}`;
}

const { year, month } = parseYm(Astro.url.searchParams.get('ym'));
const ym = `${year}-${pad(month + 1)}`;

const now = new Date();
const isCurrentMonth = year === now.getFullYear() && month === now.getMonth();
const todayIso = isoDate(now);

const windowStart = new Date(year, month, 1 - WINDOW_WEEKS * 7);
const windowEnd = new Date(year, month + 1, new Date(year, month + 1, 0).getDate() + WINDOW_WEEKS * 7);
const windowStartIso = isoDate(windowStart);
const windowEndIso = isoDate(windowEnd);

const weekCutoff = new Date(now);
weekCutoff.setHours(0, 0, 0, 0);
const weekEndTs = weekCutoff.getTime() + WEEK_MS;

const articles = await loadArticles();

const byDay = new Map<string, Chip[]>();
const counts: Record<ArticleStatus, number> = { draft: 0, published: 0, scheduled: 0 };
let scheduledThisWeek = 0;
let unscheduledDrafts = 0;

for (const a of articles) {
  const id = String(a.$id ?? a.id ?? '');
  if (!id) continue;
  const status: ArticleStatus = a.status ?? 'published';

  let at: Date | null = null;
  if (a.publishAt) {
    const parsed = new Date(a.publishAt);
    at = Number.isNaN(parsed.getTime()) ? null : parsed;
  }

  if (!at) {
    if (status === 'draft') unscheduledDrafts += 1;
    continue;
  }
  if (at.getTime() < windowStart.getTime() || at.getTime() > windowEnd.getTime()) continue;

  counts[status] += 1;
  if (status === 'scheduled' && at.getTime() >= weekCutoff.getTime() && at.getTime() < weekEndTs) {
    scheduledThisWeek += 1;
  }

  const iso = isoDate(at);
  const chip: Chip = {
    id,
    headline: a.headline || 'Untitled',
    status,
    time: `${pad(at.getHours())}:${pad(at.getMinutes())}`,
    section: a.section ?? a.pillar,
  };
  const list = byDay.get(iso);
  if (list) list.push(chip);
  else byDay.set(iso, [chip]);
}

for (const list of byDay.values()) {
  list.sort((x, y) => x.time.localeCompare(y.time) || x.headline.localeCompare(y.headline));
}

const MAX_CHIPS = 3;
const daysInMonth = new Date(year, month + 1, 0).getDate();
const leadBlanks = new Date(year, month, 1).getDay();
const cells: (Cell | null)[] = Array.from({ length: leadBlanks }, () => null);
for (let day = 1; day <= daysInMonth; day += 1) {
  cells.push({ iso: `${ym}-${pad(day)}`, day });
}
while (cells.length % 7 !== 0) cells.push(null);

const fmt = new Intl.NumberFormat('en-GB');
---

<AdminLayout title="Editorial calendar" active="calendar">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="font-serif text-2xl font-bold text-yanci-primary">Kalandar edita</h1>
      <p class="mt-1 text-sm text-yanci-primary/60">
        Publishing plan for {HAUSA_MONTHS[month]} {year}
        {!isCurrentMonth && <a href="/admin/calendar" class="underline hover:text-yanci-primary">&middot; back to this month</a>}
      </p>
    </div>
    <nav class="flex gap-1" aria-label="Watan">
      <a
        href={`/admin/calendar?ym=${shiftYm(year, month, -1)}`}
        class="border border-yanci-primary/25 px-3 py-1.5 text-sm font-medium text-yanci-primary/70 transition-colors hover:bg-yanci-primary/10"
        aria-label="Watan da ya gabata"
      >
        &larr;
      </a>
      <span class="min-w-[11rem] border border-yanci-primary/25 px-3 py-1.5 text-center text-sm font-bold text-yanci-primary">
        {HAUSA_MONTHS[month]} {year}
      </span>
      <a
        href={`/admin/calendar?ym=${shiftYm(year, month, 1)}`}
        class="border border-yanci-primary/25 px-3 py-1.5 text-sm font-medium text-yanci-primary/70 transition-colors hover:bg-yanci-primary/10"
        aria-label="Wata mai zuwa"
      >
        &rarr;
      </a>
    </nav>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_16rem]">
    <section aria-label={`Kalandar ${HAUSA_MONTHS[month]} ${year}`}>
      <div class="grid grid-cols-7 border border-yanci-primary/15 bg-white/60">
        {HAUSA_DAYS.map((d) => (
          <div class="border-b border-yanci-primary/15 py-2 text-center text-[10px] font-semibold uppercase tracking-widest text-yanci-primary/50">
            {d}
          </div>
        ))}
        {cells.map((cell) =>
          cell ? (
            <div
              class:list={[
                'min-h-28 border-b border-r border-yanci-primary/10 p-1.5 last:border-r-0',
                `[&:nth-child(7n)]:border-r-0`,
                cell.iso === todayIso && 'bg-yanci-accent/10',
              ]}
            >
              <div class="mb-1 flex items-center justify-between">
                <span
                  class:list={[
                    'flex h-6 w-6 items-center justify-center rounded-full text-xs font-bold',
                    cell.iso === todayIso ? 'bg-yanci-primary text-yanci-paper' : 'text-yanci-primary/70',
                  ]}
                >
                  {cell.day}
                </span>
                {(byDay.get(cell.iso)?.length ?? 0) > 0 && (
                  <span class="text-[10px] font-bold text-yanci-primary/40">{byDay.get(cell.iso)!.length}</span>
                )}
              </div>
              <div class="space-y-1">
                {(byDay.get(cell.iso) ?? []).slice(0, MAX_CHIPS).map((chip) => (
                  <a
                    href={`/admin/articles/${chip.id}`}
                    class:list={[
                      'block truncate rounded-sm px-1.5 py-0.5 text-[10px] font-medium transition-colors',
                      STATUS_STYLES[chip.status].chip,
                    ]}
                    title={`${chip.time} · ${chip.status}${chip.section ? ` · ${chip.section}` : ''} — ${chip.headline}`}
                  >
                    {chip.headline}
                  </a>
                ))}
                {(byDay.get(cell.iso)?.length ?? 0) > MAX_CHIPS && (
                  <p class="pl-1 text-[10px] font-bold text-yanci-primary/40">
                    +{(byDay.get(cell.iso)?.length ?? 0) - MAX_CHIPS} more
                  </p>
                )}
              </div>
            </div>
          ) : (
            <div class="min-h-28 border-b border-r border-yanci-primary/5 bg-yanci-paper/50 last:border-r-0 [&:nth-child(7n)]:border-r-0" />
          ),
        )}
      </div>
      {counts.draft + counts.published + counts.scheduled === 0 && (
        <p class="mt-4 text-center text-sm text-yanci-primary/50">Babu labarai a cikin wannan lokaci</p>
      )}
    </section>

    <aside class="space-y-4">
      <section class="grid grid-cols-2 gap-3 lg:grid-cols-1">
        <StatCard label="Scheduled · next 7d" value={fmt.format(scheduledThisWeek)} />
        <StatCard label="Unscheduled drafts" value={fmt.format(unscheduledDrafts)} />
      </section>

      <section class="border border-yanci-primary/15 bg-white/60 p-4">
        <h2 class="border-b border-yanci-primary/20 pb-2 font-serif text-base font-bold text-yanci-primary">Alamu</h2>
        <ul class="mt-3 space-y-2.5 text-sm">
          {(['published', 'scheduled', 'draft'] as const).map((s) => (
            <li class="flex items-center justify-between">
              <span class="flex items-center gap-2 capitalize text-yanci-dark/80">
                <span class:list={['inline-block h-2.5 w-2.5 rounded-full', STATUS_STYLES[s].dot]} />
                {s}
              </span>
              <span class="font-semibold text-yanci-primary">{fmt.format(counts[s])}</span>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs text-yanci-primary/45">
          {windowStartIso} &rarr; {windowEndIso} (&plusmn;{WINDOW_WEEKS} weeks)
        </p>
      </section>

      <section class="border border-yanci-primary/15 bg-white/60 p-4">
        <h2 class="font-serif text-base font-bold text-yanci-primary">Kwanakin nan</h2>
        <ul class="mt-3 space-y-2">
          {[...byDay.entries()]
            .filter(([iso, chips]) => iso >= todayIso && chips.some((c) => c.status === 'scheduled'))
            .slice(0, 6)
            .map(([iso, chips]) => (
              <li class="text-xs">
                <span class="font-semibold text-yanci-primary">{iso}</span>
                <span class="text-yanci-primary/55"> &middot; {chips.filter((c) => c.status === 'scheduled').length} scheduled</span>
              </li>
            ))}
          {![...byDay.entries()].some(([iso, chips]) => iso >= todayIso && chips.some((c) => c.status === 'scheduled')) && (
            <li class="text-xs text-yanci-primary/45">Babu shirye-shirye masu zuwa</li>
          )}
        </ul>
      </section>
    </aside>
  </div>
</AdminLayout>
