---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import {
  FaCalendar,
  FaChevronLeft,
  FaChevronRight,
  FaCircleCheck,
  FaCircleDot,
  FaClock,
  FaEye,
  FaBolt,
  FaXmark,
  FaPlus,
  FaArrowRight,
  FaFilter,
} from 'react-icons/fa6';
import { getArticles } from '@lib/appwrite-server';

export const prerender = false;

type IconCmp = React.ComponentType<{ className?: string }>;
const ic = (Icon: IconCmp, cls = 'w-5 h-5 shrink-0') =>
  renderToStaticMarkup(createElement(Icon, { className: cls }));

let articles: any[] = [];
try {
  articles = await getArticles(500);
} catch {}

const safeArticles = articles || [];
const articlesJson = JSON.stringify(safeArticles);
---

<AdminLayout title="Calendar" active="calendar">
  <div class="-m-4 md:-m-8">
    <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-200 pb-4">
        <div>
          <h2 class="text-xl md:text-2xl font-bold text-gray-800 flex items-center gap-2">
            <span set:html={ic(FaCalendar, 'w-5 h-5 text-[#c59d5f]')} /> Content Calendar
          </h2>
          <p class="text-sm text-gray-500 mt-1">Plan and track your editorial schedule</p>
        </div>
        <div class="flex items-center gap-2">
          <div class="flex items-center gap-1 bg-gray-100 rounded-lg p-1">
            <button id="cal-prev" type="button" class="p-2 hover:bg-white rounded-md transition-colors" aria-label="Previous month"><span set:html={ic(FaChevronLeft, 'w-3 h-3')} /></button>
            <span id="cal-month-label" class="text-sm font-bold text-gray-700 min-w-[160px] text-center"></span>
            <button id="cal-next" type="button" class="p-2 hover:bg-white rounded-md transition-colors" aria-label="Next month"><span set:html={ic(FaChevronRight, 'w-3 h-3')} /></button>
          </div>
          <button id="cal-today" type="button" class="px-3 py-2 text-xs font-bold text-[#0f3036] bg-gray-100 hover:bg-gray-200 rounded-lg">Today</button>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3" id="cal-stats">
        <!-- injected by JS -->
      </div>

      <!-- Filter -->
      <div class="flex items-center gap-2 flex-wrap" id="cal-filter">
        <span set:html={ic(FaFilter, 'w-3 h-3 text-gray-400')} />
        {['all', 'published', 'scheduled', 'draft', 'review'].map((status) => (
          <button
            data-filter={status}
            class={`px-3 py-1.5 rounded-full text-xs font-bold transition-all ${status === 'all' ? 'bg-[#0f3036] text-white' : 'bg-gray-100 text-gray-500 hover:bg-gray-200'}`}
          >
            {status === 'all' ? 'All' : status.charAt(0).toUpperCase() + status.slice(1)}
          </button>
        ))}
      </div>

      <!-- Calendar Grid -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <!-- Day headers -->
        <div class="grid grid-cols-7 bg-gray-50 border-b border-gray-200">
          {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((d) => (
            <div class="py-3 text-center text-[10px] font-bold uppercase tracking-widest text-gray-500">{d}</div>
          ))}
        </div>
        <!-- Calendar days -->
        <div class="grid grid-cols-7" id="cal-grid">
        </div>
      </div>

      <!-- Selected Date Detail -->
      <div id="cal-detail" class="hidden"></div>
      <div id="cal-empty" class="hidden bg-white rounded-xl border border-gray-200 shadow-sm p-8 text-center">
        <div class="mx-auto text-3xl text-gray-300 mb-2 flex items-center justify-center"><span set:html={ic(FaCalendar, 'w-8 h-8 text-gray-300')} /></div>
        <p class="text-sm text-gray-500" id="cal-empty-text"></p>
        <a href="/admin/articles/new" class="mt-3 inline-flex items-center gap-2 px-4 py-2 bg-[#0f3036] text-white rounded-lg text-sm font-bold hover:bg-[#1a454c]">
          <span set:html={ic(FaPlus, 'w-3.5 h-3.5')} /> Create Article
        </a>
      </div>
    </div>
  </div>
</AdminLayout>

<script is:inline define:vars={{ articlesJson }}>
  const articles = JSON.parse(articlesJson);
  const STATUS_CONFIG = {
    published: { color: 'bg-green-100 text-green-700 border-green-200', label: 'Published', icon: 'check' },
    draft: { color: 'bg-gray-100 text-gray-600 border-gray-200', label: 'Draft', icon: 'dot' },
    scheduled: { color: 'bg-blue-100 text-blue-700 border-blue-200', label: 'Scheduled', icon: 'clock' },
    review: { color: 'bg-amber-100 text-amber-700 border-amber-200', label: 'Review', icon: 'eye' },
  };
  const PILLAR_COLORS = {
    news: '#8a2c2c',
    sport: '#2c7a7b',
    opinion: '#c59d5f',
    culture: '#6366f1',
    lifestyle: '#d97706',
  };
  const iconSvg = {
    check: '<svg class="w-2.5 h-2.5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1010 10A10 10 0 0012 2zm4.3 7.3l-5 5a1 1 0 01-1.4 0l-2-2a1 1 0 011.4-1.4L10.6 12l4.3-4.3a1 1 0 011.4 1.6z"/></svg>',
    dot: '<svg class="w-2.5 h-2.5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4"/></svg>',
    clock: '<svg class="w-2.5 h-2.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
    eye: '<svg class="w-2.5 h-2.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>',
  };

  let currentDate = new Date();
  let selectedDate = null;
  let filterStatus = 'all';

  const monthLabel = document.getElementById('cal-month-label');
  const grid = document.getElementById('cal-grid');
  const statsEl = document.getElementById('cal-stats');
  const detailEl = document.getElementById('cal-detail');
  const emptyEl = document.getElementById('cal-empty');
  const emptyText = document.getElementById('cal-empty-text');

  function getDateStr(y, m, day) {
    return `${y}-${String(m + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
  }

  function render() {
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();
    const monthName = currentDate.toLocaleString('en', { month: 'long', year: 'numeric' });
    if (monthLabel) monthLabel.textContent = monthName;

    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const today = new Date();
    const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

    const filtered = filterStatus === 'all' ? articles : articles.filter((a) => a.status === filterStatus);
    const map = {};
    filtered.forEach((article) => {
      const dateStr = article.publishAt
        ? new Date(article.publishAt).toISOString().slice(0, 10)
        : article.$createdAt
          ? new Date(article.$createdAt).toISOString().slice(0, 10)
          : null;
      if (dateStr) {
        if (!map[dateStr]) map[dateStr] = [];
        map[dateStr].push(article);
      }
    });

    const stats = {
      total: filtered.length,
      published: filtered.filter((a) => a.status === 'published').length,
      scheduled: filtered.filter((a) => a.status === 'scheduled').length,
      draft: filtered.filter((a) => a.status === 'draft').length,
      review: filtered.filter((a) => a.status === 'review').length,
    };

    if (statsEl) {
      const items = [
        { label: 'Total', value: stats.total, color: 'bg-[#0f3036] text-white' },
        { label: 'Published', value: stats.published, color: 'bg-green-50 text-green-700' },
        { label: 'Scheduled', value: stats.scheduled, color: 'bg-blue-50 text-blue-700' },
        { label: 'Draft', value: stats.draft, color: 'bg-gray-50 text-gray-600' },
        { label: 'Review', value: stats.review, color: 'bg-amber-50 text-amber-700' },
      ];
      statsEl.innerHTML = items.map((s) => `
        <div class="${s.color} rounded-xl p-4 text-center">
          <p class="text-2xl font-black">${s.value}</p>
          <p class="text-xs font-bold opacity-70">${s.label}</p>
        </div>
      `).join('');
    }

    // filter buttons active state
    document.querySelectorAll('[data-filter]').forEach((btn) => {
      const status = btn.getAttribute('data-filter');
      const active = status === filterStatus;
      btn.className = `px-3 py-1.5 rounded-full text-xs font-bold transition-all ${active ? 'bg-[#0f3036] text-white' : 'bg-gray-100 text-gray-500 hover:bg-gray-200'}`;
      if (status !== 'all' && STATUS_CONFIG[status]) {
        btn.textContent = STATUS_CONFIG[status].label;
      } else if (status === 'all') {
        btn.textContent = 'All';
      }
    });

    // build days array
    const days = [];
    for (let i = 0; i < firstDay; i++) days.push(null);
    for (let d = 1; d <= daysInMonth; d++) days.push(d);

    if (!grid) return;
    grid.innerHTML = days.map((day, i) => {
      if (!day) return `<div class="min-h-[120px] border-b border-r border-gray-100 bg-gray-50/50"></div>`;
      const dateStr = getDateStr(year, month, day);
      const dayArticles = map[dateStr] || [];
      const isToday = dateStr === todayStr;
      const isSelected = selectedDate === dateStr;
      const header = `
        <div class="flex items-center justify-between mb-1">
          <span class="text-sm font-bold w-7 h-7 flex items-center justify-center rounded-full ${isToday ? 'bg-[#0f3036] text-white' : 'text-gray-700'}">${day}</span>
          ${dayArticles.length > 0 ? `<span class="text-[10px] font-bold text-gray-400">${dayArticles.length}</span>` : ''}
        </div>
      `;
      const list = dayArticles.slice(0, 3).map((article) => {
        const status = STATUS_CONFIG[article.status] || STATUS_CONFIG.published;
        const pillarColor = PILLAR_COLORS[article.pillar] || '#666';
        const icon = iconSvg[status.icon] || iconSvg.check;
        return `
          <div data-edit="${article.$id || article.id}" class="flex items-center gap-1.5 px-1.5 py-0.5 rounded text-[10px] font-medium truncate hover:opacity-80 transition-opacity cursor-pointer" style="background-color:${pillarColor}15;color:${pillarColor}" title="${(article.headline || '').replace(/"/g, '&quot;')}">
            ${icon}
            <span class="truncate">${(article.headline || 'Untitled').slice(0, 25)}</span>
          </div>
        `;
      }).join('');
      const more = dayArticles.length > 3 ? `<div class="text-[10px] font-bold text-gray-400 pl-1">+${dayArticles.length - 3} more</div>` : '';
      return `
        <div data-date="${dateStr}" class="min-h-[120px] border-b border-r border-gray-100 p-2 cursor-pointer transition-colors hover:bg-gray-50 ${isSelected ? 'bg-blue-50/50 ring-2 ring-inset ring-blue-200' : ''}">
          ${header}
          <div class="space-y-1 overflow-hidden max-h-[80px]">
            ${list}
            ${more}
          </div>
        </div>
      `;
    }).join('');

    // bind day clicks
    grid.querySelectorAll('[data-date]').forEach((el) => {
      el.addEventListener('click', () => {
        const ds = el.getAttribute('data-date');
        selectedDate = selectedDate === ds ? null : ds;
        renderDetail(map);
        render();
      });
    });
    grid.querySelectorAll('[data-edit]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = el.getAttribute('data-edit');
        window.location.href = `/admin/articles/${id}`;
      });
    });

    renderDetail(map);
  }

  function renderDetail(map) {
    if (!detailEl || !emptyEl) return;
    if (!selectedDate) {
      detailEl.classList.add('hidden');
      emptyEl.classList.add('hidden');
      return;
    }
    const list = map[selectedDate] || [];
    if (list.length > 0) {
      emptyEl.classList.add('hidden');
      detailEl.classList.remove('hidden');
      const dateFormatted = new Date(selectedDate + 'T00:00:00').toLocaleDateString('en', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
      detailEl.innerHTML = `
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-bold text-lg text-gray-800">${dateFormatted}</h3>
            <button id="detail-close" class="text-gray-400 hover:text-gray-600"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
          </div>
          <div class="space-y-3">
            ${list.map((article) => {
              const status = STATUS_CONFIG[article.status] || STATUS_CONFIG.published;
              const pillarColor = PILLAR_COLORS[article.pillar] || '#666';
              const icon = iconSvg[status.icon] || iconSvg.check;
              return `
                <div class="flex items-center gap-4 p-4 rounded-lg border border-gray-100 hover:border-gray-200 transition-colors">
                  <div class="w-1 h-10 rounded-full shrink-0" style="background-color:${pillarColor}"></div>
                  <div class="flex-1 min-w-0">
                    <p class="font-bold text-sm text-gray-900 truncate">${(article.headline || 'Untitled').replace(/</g,'&lt;')}</p>
                    <p class="text-xs text-gray-500">${article.author || 'Unknown'} · ${article.section || article.pillar || ''}</p>
                  </div>
                  <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-[10px] font-bold border ${status.color}">
                    ${icon} ${status.label}
                  </span>
                  <a href="/admin/articles/${article.$id || article.id}" class="p-2 text-gray-400 hover:text-[#0f3036] transition-colors" aria-label="Edit article">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </a>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
      const closeBtn = document.getElementById('detail-close');
      if (closeBtn) closeBtn.addEventListener('click', () => { selectedDate = null; render(); });
    } else {
      detailEl.classList.add('hidden');
      emptyEl.classList.remove('hidden');
      if (emptyText) emptyText.textContent = `No articles scheduled for ${new Date(selectedDate + 'T00:00:00').toLocaleDateString()}`;
    }
  }

  document.getElementById('cal-prev')?.addEventListener('click', () => {
    currentDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1);
    selectedDate = null;
    render();
  });
  document.getElementById('cal-next')?.addEventListener('click', () => {
    currentDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 1);
    selectedDate = null;
    render();
  });
  document.getElementById('cal-today')?.addEventListener('click', () => {
    currentDate = new Date();
    selectedDate = null;
    render();
  });
  document.querySelectorAll('[data-filter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      filterStatus = btn.getAttribute('data-filter') || 'all';
      selectedDate = null;
      render();
    });
  });

  render();
</script>
