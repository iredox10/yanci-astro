---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { adminListCollection } from '@lib/admin-collections';
import { PARTIES, CANDIDATES as SEED_CANDIDATES } from '../../../../data/electionData';
import { createElement, type ComponentType } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import {
  FaUsers, FaPlus, FaTrash, FaPen, FaArrowLeft, FaImage,
  FaLocationDot, FaGraduationCap, FaBriefcase, FaXmark,
  FaUpload, FaCamera,
} from 'react-icons/fa6';

export const prerender = false;

const { id } = Astro.params;

type Doc = Record<string, any>;
const [electionsRaw, candidatesRaw] = await Promise.all([
  adminListCollection('elections'),
  adminListCollection('candidates'),
]);

const elections: Doc[] = (electionsRaw as Doc[]).map((d)=>({ ...d, id: d.$id ?? d.id }));
const candidatesDocs: Doc[] = (candidatesRaw as Doc[]).map((d)=>({ ...d, id: d.$id ?? d.id, $id: d.$id }));

const election = elections.find((e)=> e.id===id) ?? elections[0] ?? null;

// Build electionCandidates: filter by electionId or position president, fallback to seed if no docs
let electionCandidates: Doc[] = [];
if (election) {
  const filtered = candidatesDocs.filter((c)=> c.electionId===election.id || c.position==='president');
  if (filtered.length > 0) {
    electionCandidates = filtered;
  } else {
    // fallback to seed for display if no Appwrite docs (so UI not empty)
    // Keep seed but attach electionId for edit handling
    electionCandidates = SEED_CANDIDATES.filter((c:any)=> c.position==='president').map((c:any)=>({ ...c, electionId: election.id }));
  }
}

type IconCmp = ComponentType<{ className?: string }>;
const ic = (Icon: IconCmp, cls='w-4 h-4') => renderToStaticMarkup(createElement(Icon,{className:cls}));

function getParty(pid: string) {
  return PARTIES.find((p)=> p.id===pid) || PARTIES[0];
}

const candidatesJson = JSON.stringify(electionCandidates.map((c)=>({
  id: c.id,
  $id: c.$id ?? c.id,
  name: c.name ?? '',
  party: c.party ?? 'apc',
  position: c.position ?? 'president',
  age: c.age ?? '',
  state: c.state ?? '',
  education: c.education ?? '',
  platform: Array.isArray(c.platform) ? c.platform.join('\n') : (c.platform ?? ''),
  runningMate: c.runningMate ?? '',
  previousOffice: c.previousOffice ?? '',
  image: c.image ?? '',
  electionId: c.electionId ?? election?.id ?? '',
})));

const partiesJson = JSON.stringify(PARTIES);
const electionIdForForm = election?.id ?? '';
---

<AdminLayout title={`'Yan Takara — ${election ? election.name : ''}`} active="elections">
  <div class="flex-1 flex flex-col min-w-0 overflow-y-auto p-6 md:p-8 -m-4 md:-m-8">
    { !election ? (
      <div class="flex-1 flex items-center justify-center">
        <div class="text-center">
          <p class="text-gray-500">Zaben ba a samu ba.</p>
          <a href="/admin/elections" class="text-[#0f3036] font-bold text-sm mt-2 inline-block">← Komawa</a>
        </div>
      </div>
    ) : (
      <>
        <!-- Header -->
        <div class="flex items-center justify-between mb-8">
          <div class="flex items-center gap-4">
            <a href="/admin/elections" class="p-2 hover:bg-gray-100 rounded-lg transition-colors">
              <span set:html={ic(FaArrowLeft, 'text-gray-500 w-4 h-4')} />
            </a>
            <div>
              <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-3">
                <span set:html={ic(FaUsers, 'text-[#0f3036] w-6 h-6')} />
                'Yan Takara — {election.name}
              </h1>
              <p class="text-sm text-gray-500 mt-1">{electionCandidates.length} 'yan takara</p>
            </div>
          </div>
          <button
            id="btn-create-candidate"
            class="flex items-center gap-2 px-4 py-2.5 bg-[#0f3036] text-white rounded-lg font-bold text-sm hover:bg-[#1a454c] transition-colors cursor-pointer"
          >
            <span set:html={ic(FaPlus, 'w-4 h-4')} /> Ƙara Ɗan Takara
          </button>
        </div>

        <!-- Candidate Cards -->
        <div class="grid md:grid-cols-2 gap-6">
          {electionCandidates.map((candidate) => {
            const party = getParty(candidate.party);
            const platformArr = Array.isArray(candidate.platform) ? candidate.platform : (typeof candidate.platform === 'string' ? candidate.platform.split('\n').filter(Boolean) : []);
            return (
              <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden hover:shadow-md transition-all">
                <div class="flex">
                  <div class="w-32 flex-shrink-0 relative">
                    {candidate.image ? (
                      <img src={candidate.image} alt={candidate.name} class="w-full h-full object-cover" />
                    ) : (
                      <div class="w-full h-full bg-gray-100 flex items-center justify-center">
                        <span set:html={ic(FaImage, 'w-8 h-8 text-gray-300')} />
                      </div>
                    )}
                    <div class="absolute bottom-0 left-0 right-0 h-1" style={`background-color:${party.color}`} />
                  </div>
                  <div class="flex-1 p-4">
                    <div class="flex items-start justify-between">
                      <div>
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full" style={`background-color:${party.color}20;color:${party.color}`}>
                          {party.name}
                        </span>
                        <h3 class="font-bold text-lg mt-1">{candidate.name}</h3>
                      </div>
                      <div class="flex gap-1">
                        <button data-edit-candidate={candidate.id} class="p-1.5 hover:bg-gray-100 rounded-lg transition-colors text-gray-400 hover:text-gray-600 cursor-pointer">
                          <span set:html={ic(FaPen, 'w-4 h-4')} />
                        </button>
                        <button data-delete-candidate={candidate.id} class="p-1.5 hover:bg-red-50 rounded-lg transition-colors text-gray-400 hover:text-red-600 cursor-pointer">
                          <span set:html={ic(FaTrash, 'w-4 h-4')} />
                        </button>
                      </div>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">Mataimaki: {candidate.runningMate || '—'}</p>
                    <div class="flex flex-wrap gap-3 mt-2 text-xs text-gray-500">
                      <span class="flex items-center gap-1"><span set:html={ic(FaLocationDot, 'w-3 h-3')} /> {candidate.state || '—'}</span>
                      <span class="flex items-center gap-1"><span set:html={ic(FaBriefcase, 'w-3 h-3')} /> {candidate.previousOffice || '—'}</span>
                    </div>
                    {platformArr.length > 0 && (
                      <div class="mt-2">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1">Manufofi</p>
                        <ul class="space-y-0.5">
                          {platformArr.slice(0,2).map((item:string)=> (
                            <li class="text-xs text-gray-600 truncate">• {item}</li>
                          ))}
                          {platformArr.length > 2 && (
                            <li class="text-xs text-gray-400">+{platformArr.length - 2} ƙari</li>
                          )}
                        </ul>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        {electionCandidates.length === 0 && (
          <div class="bg-white rounded-xl p-12 text-center border border-gray-100">
            <span class="flex justify-center mb-4" set:html={ic(FaUsers, 'w-12 h-12 mx-auto text-gray-200')} />
            <p class="text-gray-500 font-medium">Babu 'yan takara tukuna.</p>
            <button id="btn-empty-candidate" class="mt-4 text-sm text-[#0f3036] font-bold hover:underline cursor-pointer">
              + Ƙara ɗan takara na farko
            </button>
          </div>
        )}

        <!-- Modal -->
        <div id="candidate-modal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden">
          <div id="candidate-modal-panel" class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
            <div class="p-6 border-b border-gray-100 flex items-center justify-between">
              <h2 id="candidate-modal-title" class="text-xl font-bold">Sabon Ɗan Takara</h2>
              <button id="candidate-modal-close" class="p-2 hover:bg-gray-100 rounded-lg cursor-pointer">
                <span set:html={ic(FaXmark, 'w-5 h-5 text-gray-400')} />
              </button>
            </div>
            <form id="candidate-form" class="p-6 space-y-4">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Sunan</label>
                  <input name="name" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036]" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Jam'iyya</label>
                  <select name="party" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036]">
                    {PARTIES.map((p)=> <option value={p.id}>{p.name} — {p.fullName}</option>)}
                  </select>
                </div>
              </div>
              <div class="grid grid-cols-3 gap-4">
                <div>
                  <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Matsayi</label>
                  <select name="position" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036]">
                    <option value="president">Shugaban Ƙasa</option>
                    <option value="governor">Gwamna</option>
                    <option value="senator">Sanata</option>
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Shekaru</label>
                  <input type="number" name="age" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036]" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Jiha</label>
                  <input name="state" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036]" />
                </div>
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Mataimaki</label>
                  <input name="runningMate" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036]" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Mukamin Da Ya Taɓa Riƙe</label>
                  <input name="previousOffice" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036]" />
                </div>
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Ilimi</label>
                <input name="education" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036]" />
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Hoton Ɗan Takara</label>
                <div class="flex items-start gap-4">
                  <div
                    id="candidate-image-preview"
                    class="w-24 h-24 rounded-lg border-2 border-dashed border-gray-300 flex items-center justify-center cursor-pointer hover:border-[#0f3036] transition-colors overflow-hidden bg-gray-50 shrink-0 relative group"
                  >
                    <div id="candidate-image-placeholder" class="text-center text-gray-400">
                      <span class="flex justify-center" set:html={ic(FaCamera, 'w-6 h-6 mx-auto mb-1')} />
                      <span class="text-[9px] font-bold">Danna don ɗora</span>
                    </div>
                    <img id="candidate-image-img" src="" alt="Preview" class="w-full h-full object-cover hidden" />
                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center hidden" id="candidate-image-overlay">
                      <span set:html={ic(FaCamera, 'w-5 h-5 text-white')} />
                    </div>
                  </div>
                  <div class="flex-1 space-y-2">
                    <button
                      type="button"
                      id="candidate-upload-btn"
                      class="flex items-center gap-2 px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-bold hover:bg-gray-200 transition-colors cursor-pointer"
                    >
                      <span set:html={ic(FaUpload, 'w-4 h-4')} />
                      Zaɓi Hoto daga Na'ura
                    </button>
                    <p class="text-[10px] text-gray-400">PNG, JPG, ko WebP · Max 5MB</p>
                    <input
                      id="candidate-file-input"
                      type="file"
                      accept="image/*"
                      class="hidden"
                    />
                    <div class="pt-2 border-t border-gray-100">
                      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Ko sanya URL</label>
                      <input name="image" placeholder="https://..." class="w-full px-3 py-1.5 border border-gray-200 rounded-lg text-xs focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036]" />
                    </div>
                  </div>
                </div>
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Manufofi (kowane layi ɗaya)</label>
                <textarea name="platform" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036] resize-none" placeholder="Ƙarfafa tsaro&#10;Haɓaka aikin yi&#10;..."></textarea>
              </div>
              <div class="flex justify-end gap-3 pt-4">
                <button type="button" id="candidate-cancel" class="px-4 py-2 text-sm font-bold text-gray-600 hover:text-gray-800 cursor-pointer">Soke</button>
                <button type="submit" id="candidate-submit" class="px-6 py-2 bg-[#0f3036] text-white text-sm font-bold rounded-lg hover:bg-[#1a454c] transition-colors cursor-pointer">
                  Ƙirƙiri Ɗan Takara
                </button>
              </div>
              <p id="candidate-msg" class="text-xs text-red-600 font-bold hidden"></p>
            </form>
          </div>
        </div>
      </>
    )}
  </div>

  <script type="application/json" id="candidates-data" set:html={candidatesJson} />
  <script type="application/json" id="parties-data" set:html={partiesJson} />
  <script type="application/json" id="election-id-data" set:html={JSON.stringify(electionIdForForm)} />

  <script is:inline>
    (() => {
      const modal = document.getElementById('candidate-modal');
      const panel = document.getElementById('candidate-modal-panel');
      const form = document.getElementById('candidate-form');
      const titleEl = document.getElementById('candidate-modal-title');
      const submitBtn = document.getElementById('candidate-submit');
      const msgEl = document.getElementById('candidate-msg');
      const closeBtn = document.getElementById('candidate-modal-close');
      const cancelBtn = document.getElementById('candidate-cancel');
      const createBtn = document.getElementById('btn-create-candidate');
      const emptyBtn = document.getElementById('btn-empty-candidate');
      const dataEl = document.getElementById('candidates-data');
      const electionIdEl = document.getElementById('election-id-data');
      const fileInput = document.getElementById('candidate-file-input');
      const uploadBtn = document.getElementById('candidate-upload-btn');
      const previewWrap = document.getElementById('candidate-image-preview');
      const previewImg = document.getElementById('candidate-image-img');
      const previewPlaceholder = document.getElementById('candidate-image-placeholder');
      const previewOverlay = document.getElementById('candidate-image-overlay');
      let editingId = null;
      let candidatesData = [];
      try { candidatesData = JSON.parse(dataEl.textContent || '[]'); } catch {}
      const electionId = JSON.parse(electionIdEl.textContent || '""');
      let imagePreview = '';

      function showMsg(t){ if(!msgEl) return; msgEl.textContent=t; msgEl.classList.remove('hidden'); }
      function hideMsg(){ if(msgEl){ msgEl.textContent=''; msgEl.classList.add('hidden'); } }

      function setImagePreview(url){
        imagePreview = url;
        if(url){
          previewImg.src = url;
          previewImg.classList.remove('hidden');
          previewPlaceholder.classList.add('hidden');
          previewOverlay.classList.remove('hidden');
          const imageInput = form.elements.namedItem('image');
          if(imageInput) imageInput.value = url;
        } else {
          previewImg.src = '';
          previewImg.classList.add('hidden');
          previewPlaceholder.classList.remove('hidden');
          previewOverlay.classList.add('hidden');
          const imageInput = form.elements.namedItem('image');
          if(imageInput) imageInput.value = '';
        }
      }

      function openCreate(){
        editingId = null;
        if(titleEl) titleEl.textContent = 'Sabon Ɗan Takara';
        if(submitBtn) submitBtn.textContent = 'Ƙirƙiri Ɗan Takara';
        form.reset();
        const party = form.elements.namedItem('party');
        if(party) party.value = 'apc';
        const position = form.elements.namedItem('position');
        if(position) position.value = 'president';
        setImagePreview('');
        hideMsg();
        modal.classList.remove('hidden');
        document.body.style.overflow='hidden';
      }

      function openEdit(id){
        const candidate = candidatesData.find(c=>c.id===id || c.$id===id);
        if(!candidate) return;
        editingId = candidate.id || candidate.$id;
        if(titleEl) titleEl.textContent = 'Gyara Ɗan Takara';
        if(submitBtn) submitBtn.textContent = 'Ajiye Canje-canje';
        hideMsg();
        const fields = ['name','party','position','age','state','education','platform','runningMate','previousOffice','image'];
        for(const k of fields){
          const el = form.elements.namedItem(k);
          if(el) el.value = candidate[k] ?? '';
        }
        setImagePreview(candidate.image || '');
        modal.classList.remove('hidden');
        document.body.style.overflow='hidden';
      }

      function closeModal(){
        modal.classList.add('hidden');
        document.body.style.overflow='';
        editingId=null;
        hideMsg();
      }

      createBtn && createBtn.addEventListener('click', openCreate);
      emptyBtn && emptyBtn.addEventListener('click', openCreate);
      closeBtn && closeBtn.addEventListener('click', closeModal);
      cancelBtn && cancelBtn.addEventListener('click', closeModal);
      modal && modal.addEventListener('click', (e)=>{ if(e.target===modal) closeModal(); });
      panel && panel.addEventListener('click', (e)=> e.stopPropagation());

      // Image handling
      function triggerFileInput(){ fileInput && fileInput.click(); }
      previewWrap && previewWrap.addEventListener('click', triggerFileInput);
      uploadBtn && uploadBtn.addEventListener('click', triggerFileInput);

      fileInput && fileInput.addEventListener('change', async (e)=>{
        const file = e.target.files?.[0];
        if(!file) return;
        if(!file.type.startsWith('image/')){ alert('Zaɓi fayil ɗin hoto kawai.'); return; }
        if(file.size > 5 * 1024 * 1024){ alert('Girman hoto ya wuce 5MB.'); return; }
        const localUrl = URL.createObjectURL(file);
        setImagePreview(localUrl);
        // Try upload to Appwrite if endpoint configured - for now just keep local preview
        // Future: attempt to upload via /api/admin/media if available
        const imageInput = form.elements.namedItem('image');
        if(imageInput) imageInput.value = localUrl;
      });

      document.querySelectorAll('[data-edit-candidate]').forEach(btn=>{
        btn.addEventListener('click', ()=> openEdit(btn.getAttribute('data-edit-candidate')));
      });

      document.querySelectorAll('[data-delete-candidate]').forEach(btn=>{
        btn.addEventListener('click', async ()=>{
          const id = btn.getAttribute('data-delete-candidate');
          if(!confirm('Ka tabbata kana son share wannan ɗan takara?')) return;
          btn.disabled = true;
          try{
            const res = await fetch(`/api/admin/candidates/${id}`, { method:'DELETE' });
            const data = await res.json().catch(()=>({}));
            if(!res.ok) throw new Error(data.message||'Delete failed');
            window.location.reload();
          }catch(err){
            alert(err.message||'Delete failed');
            btn.disabled=false;
          }
        });
      });

      form && form.addEventListener('submit', async (e)=>{
        e.preventDefault();
        hideMsg();
        const fd = new FormData(form);
        const platformStr = String(fd.get('platform')||'');
        const data = {
          name: String(fd.get('name')||''),
          party: String(fd.get('party')||'apc'),
          position: String(fd.get('position')||'president'),
          age: parseInt(String(fd.get('age')||'0')) || 0,
          state: String(fd.get('state')||''),
          education: String(fd.get('education')||''),
          platform: platformStr.split('\n').filter(Boolean),
          runningMate: String(fd.get('runningMate')||''),
          previousOffice: String(fd.get('previousOffice')||''),
          image: String(fd.get('image')||''),
          electionId: electionId,
        };
        if(!data.name){ showMsg('Sunan ɗan takara yana da mahimmanci.'); return; }
        submitBtn.disabled = true;
        submitBtn.textContent = 'Ana ajiyewa...';
        try{
          const url = `/api/admin/candidates/${editingId || 'new'}`;
          const method = editingId ? 'PUT' : 'POST';
          const res = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(data)});
          const json = await res.json().catch(()=>({}));
          if(!res.ok) throw new Error(json.message||'Save failed');
          window.location.reload();
        }catch(err){
          showMsg(err.message||'Save failed');
          submitBtn.disabled=false;
          submitBtn.textContent = editingId ? 'Ajiye Canje-canje' : 'Ƙirƙiri Ɗan Takara';
        }
      });

      document.addEventListener('keydown', (e)=>{ if(e.key==='Escape' && modal && !modal.classList.contains('hidden')) closeModal(); });
    })();
  </script>
</AdminLayout>
