---
import '../../styles/global.css';

export const prerender = false;

const token = new URL(Astro.request.url).searchParams.get('token') ?? '';
const invalid = !token;
---

<!doctype html>
<html lang="ha">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sake Saitin Kalmar Sirri — Yanci Admin</title>
  </head>
  <body class="antialiased">
    <div class="min-h-screen bg-[#0f3036] flex items-center justify-center p-4">
      {invalid ? (
        <div class="max-w-md w-full">
          <div class="bg-white rounded-2xl shadow-2xl p-8 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-red-50 mb-4">
              <svg class="text-red-500 text-2xl" style="width:1em;height:1em" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M144 144v48H304V144c0-44.2-35.8-80-80-80s-80 35.8-80 80zM80 192V144C80 64.5 144.5 0 224 0s144 64.5 144 144v48h16c35.3 0 64 28.7 64 64V448c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V256c0-35.3 28.7-64 64-64H80z"></path></svg>
            </div>
            <h1 class="text-xl font-black text-gray-800 mb-2">Hanyar Ba Ta Aiki</h1>
            <p class="text-gray-500 text-sm mb-6">
              Wannan hanyar sake saitin kalmar sirri ba ta aiki ko kuma ta ƙare. Don Allah ka sake neman sabuwar hanyar sake saiti.
            </p>
            <a href="/admin/forgot-password" class="inline-block bg-[#0f3036] text-white py-3 px-6 rounded-xl font-bold hover:bg-[#1a4e56] transition-colors text-sm">
              Sake Nema
            </a>
          </div>
        </div>
      ) : (
        <>
          <div id="reset-form-root" class="max-w-md w-full">
            <div class="text-center mb-8">
              <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white/10 mb-4">
                <svg class="text-[#c59d5f] text-2xl" style="width:1em;height:1em" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M144 144v48H304V144c0-44.2-35.8-80-80-80s-80 35.8-80 80zM80 192V144C80 64.5 144.5 0 224 0s144 64.5 144 144v48h16c35.3 0 64 28.7 64 64V448c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V256c0-35.3 28.7-64 64-64H80z"></path></svg>
              </div>
              <h1 class="text-2xl font-black text-white tracking-tight">Sake Saitin Kalmar Sirri</h1>
              <p class="text-white/50 text-sm mt-1">Shigar da sabuwar kalmar sirri</p>
            </div>

            <div class="bg-white rounded-2xl shadow-2xl p-8">
              <form id="reset-form" class="space-y-5">
                <div>
                  <label for="password" class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wider">
                    <svg class="inline w-3 h-3 mr-1 text-[#c59d5f]" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M336 352c97.2 0 176-78.8 176-176S433.2 0 336 0S160 78.8 160 176c0 18.7 2.9 36.8 8.3 53.7L7 391c-4.5 4.5-7 10.6-7 17l0 80c0 13.3 10.7 24 24 24l80 0c13.3 0 24-10.7 24-24l0-40 40 0c13.3 0 24-10.7 24-24l0-40 40 0c6.4 0 12.5-2.5 17-7l33.3-33.3c16.9 5.4 35 8.3 53.7 8.3zM376 96a40 40 0 1 1 0 80 40 40 0 1 1 0-80z"></path></svg>
                    Sabuwar Kalmar Sirri
                  </label>
                  <input
                    id="password"
                    name="password"
                    type="password"
                    placeholder="Akalla haruffa 8"
                    required
                    minlength="8"
                    autocomplete="new-password"
                    class="w-full border border-gray-200 rounded-xl px-3 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#c59d5f] focus:border-transparent bg-gray-50 transition"
                  />
                </div>

                <div>
                  <label for="confirm" class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wider">
                    <svg class="inline w-3 h-3 mr-1 text-[#c59d5f]" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M336 352c97.2 0 176-78.8 176-176S433.2 0 336 0S160 78.8 160 176c0 18.7 2.9 36.8 8.3 53.7L7 391c-4.5 4.5-7 10.6-7 17l0 80c0 13.3 10.7 24 24 24l80 0c13.3 0 24-10.7 24-24l0-40 40 0c13.3 0 24-10.7 24-24l0-40 40 0c6.4 0 12.5-2.5 17-7l33.3-33.3c16.9 5.4 35 8.3 53.7 8.3zM376 96a40 40 0 1 1 0 80 40 40 0 1 1 0-80z"></path></svg>
                    Tabbatar da Kalmar Sirri
                  </label>
                  <input
                    id="confirm"
                    name="confirm"
                    type="password"
                    placeholder="Sake rubuta kalmar sirri"
                    required
                    autocomplete="new-password"
                    class="w-full border border-gray-200 rounded-xl px-3 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#c59d5f] focus:border-transparent bg-gray-50 transition"
                  />
                </div>

                <div id="reset-error" class="hidden bg-red-50 border border-red-100 rounded-xl px-4 py-3 text-sm text-red-700 font-medium"></div>

                <button
                  id="reset-btn"
                  type="submit"
                  class="w-full bg-[#0f3036] text-white py-3.5 rounded-xl font-bold hover:bg-[#1a4e56] transition-colors disabled:opacity-50 disabled:cursor-not-allowed text-sm tracking-wide"
                >
                  Sake Saita Kalmar Sirri
                </button>
              </form>
            </div>
          </div>

          <div id="reset-done" class="max-w-md w-full hidden">
            <div class="text-center mb-8">
              <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white/10 mb-4">
                <svg class="text-green-400 text-2xl" style="width:1em;height:1em" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM369 209L241 337c-9.4 9.4-24.6 9.4-33.9 0l-64-64c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0l47 47L335 175c9.4-9.4 24.6-9.4 33.9 0s9.4 24.6 0 33.9z"></path></svg>
              </div>
              <h1 class="text-2xl font-black text-white tracking-tight">An Sake Saita</h1>
              <p class="text-white/50 text-sm mt-1">Kalmar sirrinka ta canja</p>
            </div>

            <div class="bg-white rounded-2xl shadow-2xl p-8 text-center">
              <p class="text-gray-600 text-sm leading-relaxed mb-6">
                An sake saita kalmar sirrinka cikin nasara. Za ka iya shiga da sabuwar kalmar sirri yanzu.
              </p>
              <a href="/admin/login" class="inline-block bg-[#0f3036] text-white py-3 px-6 rounded-xl font-bold hover:bg-[#1a4e56] transition-colors text-sm tracking-wide">
                Shiga Tsarin
              </a>
            </div>
          </div>
        </>
      )}
    </div>

    {!invalid && (
      <script is:inline data-token={token}>
        const form = document.getElementById('reset-form');
        const btn = document.getElementById('reset-btn');
        const errBox = document.getElementById('reset-error');
        const passwordInput = document.getElementById('password');
        const confirmInput = document.getElementById('confirm');
        const formRoot = document.getElementById('reset-form-root');
        const doneRoot = document.getElementById('reset-done');
        const token = document.currentScript ? document.currentScript.getAttribute('data-token') : new URLSearchParams(window.location.search).get('token');

        function updateBtnState() {
          if (!btn || !passwordInput || !confirmInput) return;
          const hasValues = passwordInput.value && confirmInput.value;
          if (hasValues && !btn.hasAttribute('data-loading')) {
            btn.removeAttribute('disabled');
          } else if (!btn.hasAttribute('data-loading')) {
            btn.setAttribute('disabled', 'true');
          }
        }
        if (passwordInput) passwordInput.addEventListener('input', () => { if (errBox) { errBox.classList.add('hidden'); errBox.textContent=''; } updateBtnState(); });
        if (confirmInput) confirmInput.addEventListener('input', () => { if (errBox) { errBox.classList.add('hidden'); errBox.textContent=''; } updateBtnState(); });
        updateBtnState();

        if (form) {
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (errBox) { errBox.classList.add('hidden'); errBox.textContent=''; }
            const password = passwordInput ? passwordInput.value : '';
            const confirm = confirmInput ? confirmInput.value : '';
            if (password.length < 8) {
              if (errBox) { errBox.textContent = 'Kalmar sirri dole ta \u0199alla 8 haruffa.'; errBox.classList.remove('hidden'); }
              return;
            }
            if (password !== confirm) {
              if (errBox) { errBox.textContent = 'Kalmomin sirri ba su daidaita ba.'; errBox.classList.remove('hidden'); }
              return;
            }
            if (btn) { btn.setAttribute('disabled','true'); btn.setAttribute('data-loading','true'); btn.textContent='Ana sake saiti...'; }
            try {
              const res = await fetch('/api/auth/reset', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ token, password }),
              });
              const data = await res.json();
              if (!res.ok || !data.ok) {
                throw new Error(data.message || 'An sami matsala. Gwada sake.');
              }
              if (formRoot) formRoot.classList.add('hidden');
              if (doneRoot) doneRoot.classList.remove('hidden');
            } catch (err) {
              if (errBox) { errBox.textContent = err.message || 'An sami matsala. Gwada sake.'; errBox.classList.remove('hidden'); }
              if (btn) { btn.removeAttribute('data-loading'); btn.textContent='Sake Saita Kalmar Sirri'; updateBtnState(); }
            }
          });
        }
      </script>
    )}
  </body>
</html>
