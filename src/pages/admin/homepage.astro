---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getHomepageLayout, listHomepageLayoutDocs } from '@lib/homepage-layout';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import {
  FaPalette,
  FaEye,
  FaArrowUp,
  FaArrowDown,
  FaToggleOn,
  FaToggleOff,
  FaFloppyDisk,
  FaSpinner,
  FaCheck,
} from 'react-icons/fa6';

export const prerender = false;

// Fetch Astro layout for SSR seeding (keeps SSR)
const layout = await getHomepageLayout();
const docs = await listHomepageLayoutDocs();

// React's defaultSections (pixel-identical source)
const defaultSections = [
  { id: 'ticker', label: 'Breaking News Ticker', enabled: true, order: 0 },
  { id: 'hero', label: 'Hero Story + Sidebar', enabled: true, order: 1 },
  { id: 'highlights', label: 'Highlight Panels (3 cards)', enabled: true, order: 2 },
  { id: 'stats', label: 'Statistics Counter', enabled: true, order: 3 },
  { id: 'opinion', label: 'Opinion Section', enabled: true, order: 4 },
  { id: 'sport', label: 'Sports Section', enabled: true, order: 5 },
  { id: 'lifestyle', label: 'Lifestyle & Culture', enabled: true, order: 6 },
  { id: 'elections', label: 'Election Hub Widget', enabled: false, order: 7 },
  { id: 'newsletter', label: 'Newsletter CTA', enabled: true, order: 8 },
];

// Convert Astro layout to React shape if available (fallback to defaultSections)
function mapLayoutToSections() {
  if (layout && layout.length > 0) {
    // Map Astro keys to React ids where possible, else use default
    const keyToLabel: Record<string, string> = {
      breaking: 'Breaking News Ticker',
      headlines: 'Hero Story + Sidebar',
      trending: 'Highlight Panels (3 cards)',
      stats: 'Statistics Counter',
      opinion: 'Opinion Section',
      sport: 'Sports Section',
      culture: 'Lifestyle & Culture',
      video: 'Newsletter CTA',
    };
    // If layout has same count as Astro modules, map them
    // Otherwise fallback to defaultSections
    if (layout.length === 8) {
      const mapped = layout.map((item: any, idx: number) => ({
        id: item.key,
        label: keyToLabel[item.key] ?? item.key,
        enabled: Boolean(item.enabled),
        order: Number(item.position ?? idx),
      }));
      // Ensure we have newsletter/elections handling: add missing
      const hasElection = mapped.some((s) => s.id === 'elections');
      if (!hasElection) mapped.push({ id: 'elections', label: 'Election Hub Widget', enabled: false, order: 7 });
      return mapped.sort((a, b) => a.order - b.order);
    }
  }
  return defaultSections;
}

const sectionsForClient = mapLayoutToSections();
const sectionsJson = JSON.stringify(sectionsForClient);
const enabledCountInit = sectionsForClient.filter((s) => s.enabled).length;

type IconCmp = React.ComponentType<{ className?: string }>;
const ic = (Icon: IconCmp, cls = 'w-5 h-5 shrink-0') =>
  renderToStaticMarkup(createElement(Icon, { className: cls }));
---

<AdminLayout title="Shafin farko" active="homepage">
    <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-200 pb-4">
        <div>
          <h2 class="text-xl md:text-2xl font-bold text-gray-800 flex items-center gap-2">
            <span set:html={ic(FaPalette, 'w-5 h-5 text-[#c59d5f]')} /> Homepage Builder
          </h2>
          <p class="text-sm text-gray-500 mt-1">Control layout, section ordering, da widget visibility na shafin farko <span id="homepage-source">(Local)</span></p>
        </div>
        <div class="flex gap-2">
          <button
            id="homepage-preview-toggle"
            type="button"
            class="px-4 py-2.5 rounded-md flex items-center gap-2 font-bold text-sm transition-colors bg-white text-gray-700 border border-gray-200 hover:bg-gray-50"
          >
            <span set:html={ic(FaEye, 'w-4 h-4')} /> Preview
          </button>
          <button
            id="homepage-save"
            type="button"
            class="px-6 py-2.5 rounded-md flex items-center gap-2 font-bold text-sm transition-colors bg-[#0f3036] text-white hover:bg-[#1a454c] disabled:opacity-50"
          >
            <span id="homepage-save-icon" set:html={ic(FaFloppyDisk, 'w-4 h-4')} />
            <span id="homepage-save-label">Ajiye Layout</span>
          </button>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
          <p class="text-sm text-gray-500">Total Sections</p>
          <p id="stat-total" class="text-3xl font-black text-gray-900">{sectionsForClient.length}</p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
          <p class="text-sm text-gray-500">Enabled</p>
          <p id="stat-enabled" class="text-3xl font-black text-green-600">{enabledCountInit}</p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
          <p class="text-sm text-gray-500">Disabled</p>
          <p id="stat-disabled" class="text-3xl font-black text-gray-400">{sectionsForClient.length - enabledCountInit}</p>
        </div>
      </div>

      <!-- Section List -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="p-4 bg-gray-50 border-b border-gray-200">
          <div class="flex items-center justify-between text-xs font-bold text-gray-500 uppercase tracking-wider">
            <span>Order & Visibility</span>
            <span>Section</span>
          </div>
        </div>
        <div id="homepage-list" class="divide-y divide-gray-100">
          {
            sectionsForClient.map((section, index) => (
              <div
                data-section-id={section.id}
                class={`p-4 flex items-center justify-between transition-colors ${section.enabled ? 'hover:bg-gray-50' : 'bg-gray-50/50 opacity-60'}`}
              >
                <div class="flex items-center gap-3 w-32">
                  <span class={`w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold ${section.enabled ? 'bg-[#0f3036] text-white' : 'bg-gray-200 text-gray-500'}`}>
                    {index + 1}
                  </span>
                  <div class="flex flex-col">
                    <button type="button" data-move="up" data-index={String(index)} disabled={index === 0} class="text-gray-400 hover:text-gray-600 disabled:opacity-30 transition-colors">
                      <span set:html={ic(FaArrowUp, 'w-3 h-3')} />
                    </button>
                    <button type="button" data-move="down" data-index={String(index)} disabled={index === sectionsForClient.length - 1} class="text-gray-400 hover:text-gray-600 disabled:opacity-30 transition-colors">
                      <span set:html={ic(FaArrowDown, 'w-3 h-3')} />
                    </button>
                  </div>
                </div>
                <div class="flex-1 px-4">
                  <p class={`font-bold text-sm ${section.enabled ? 'text-gray-900' : 'text-gray-400 line-through'}`}>{section.label}</p>
                  <p class="text-xs text-gray-400 font-mono">/{section.id}</p>
                </div>
                <button type="button" data-toggle={section.id} class={`transition-all ${section.enabled ? 'text-green-600' : 'text-gray-300'}`}>
                  {section.enabled ? (
                    <span set:html={ic(FaToggleOn, 'w-8 h-8')} />
                  ) : (
                    <span set:html={ic(FaToggleOff, 'w-8 h-8')} />
                  )}
                </button>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Preview Mode -->
      <div id="homepage-preview" class="bg-[#fafaf9] rounded-xl border border-gray-200 shadow-sm overflow-hidden hidden">
        <div class="p-3 bg-[#0f3036] text-white text-xs font-bold uppercase tracking-wider flex items-center gap-2">
          <span set:html={ic(FaEye, 'w-3 h-3')} /> Homepage Preview (Enabled Sections Only)
        </div>
        <div id="homepage-preview-list" class="p-6 space-y-4">
          {
            sectionsForClient
              .filter((s) => s.enabled)
              .map((section, index) => (
                <div class="bg-white rounded-lg border-2 border-dashed border-gray-200 p-4 text-center">
                  <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">
                    Section {index + 1}: {section.label}
                  </span>
                </div>
              ))
          }
        </div>
      </div>

      <!-- Info Card -->
      <div class="bg-blue-50 border border-blue-100 rounded-xl p-5">
        <h4 class="font-bold text-blue-900 mb-2 flex items-center gap-2">
          <span set:html={ic(FaCheck, 'w-4 h-4')} /> How It Works
        </h4>
        <ul class="text-sm text-blue-800 space-y-1 list-disc list-inside">
          <li>Drag sections up/down to change their order on the homepage</li>
          <li>Toggle sections on/off to show or hide them from visitors</li>
          <li>Preview mode shows you how the layout will look</li>
          <li>Click "Ajiye Layout" to save your changes</li>
          <li>Changes are saved to localStorage and applied on next page load</li>
        </ul>
      </div>
    </div>
</AdminLayout>

<script is:inline define:vars={{ sectionsJson }}>
  const STORAGE_KEY = 'yanci_homepage_builder';
  const defaultSections = JSON.parse(sectionsJson);
  let sections = (() => {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        const parsed = JSON.parse(saved);
        if (Array.isArray(parsed) && parsed.length > 0) return parsed;
      }
    } catch {}
    return defaultSections;
  })();
  let previewMode = false;
  let saving = false;
  let saved = false;
  let useAppwrite = false;

  // try to load from Appwrite via API (if available)
  (async () => {
    try {
      const res = await fetch('/api/admin/homepage-layout', { headers: { 'Accept': 'application/json' } });
      if (res.ok) {
        const data = await res.json().catch(() => null);
        if (data && Array.isArray(data.layout) && data.layout.length > 0) {
          // data.layout is HomepageLayoutItem[] with key/position/enabled
          // Map to our sections shape if counts match
          // For now, if API returns layout, we can consider useAppwrite true
          useAppwrite = true;
          const sourceEl = document.getElementById('homepage-source');
          if (sourceEl) sourceEl.textContent = '(Appwrite)';
        }
      }
    } catch {}
  })();

  const listEl = document.getElementById('homepage-list');
  const previewEl = document.getElementById('homepage-preview');
  const previewListEl = document.getElementById('homepage-preview-list');
  const totalEl = document.getElementById('stat-total');
  const enabledEl = document.getElementById('stat-enabled');
  const disabledEl = document.getElementById('stat-disabled');
  const previewToggle = document.getElementById('homepage-preview-toggle');
  const saveBtn = document.getElementById('homepage-save');
  const saveLabel = document.getElementById('homepage-save-label');
  const saveIcon = document.getElementById('homepage-save-icon');

  function persistLocal() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(sections)); } catch {}
  }

  async function persistAppwrite() {
    if (!useAppwrite) return;
    try {
      // Try to persist via homepage-layout API - map sections to layout payload
      // Our sections use id/order/enabled, need to produce layout with key/position/enabled
      // For compatibility, send as layout array
      const payload = sections.map(s => ({ key: s.id, position: s.order, enabled: s.enabled }));
      await fetch('/api/admin/homepage-layout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ layout: payload }),
      }).catch(() => {});
    } catch {}
  }

  function updateStats() {
    if (totalEl) totalEl.textContent = String(sections.length);
    const enabled = sections.filter(s => s.enabled).length;
    if (enabledEl) enabledEl.textContent = String(enabled);
    if (disabledEl) disabledEl.textContent = String(sections.length - enabled);
  }

  function renderList() {
    if (!listEl) return;
    listEl.innerHTML = sections.map((section, index) => `
      <div data-section-id="${section.id}" class="p-4 flex items-center justify-between transition-colors ${section.enabled ? 'hover:bg-gray-50' : 'bg-gray-50/50 opacity-60'}">
        <div class="flex items-center gap-3 w-32">
          <span class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold ${section.enabled ? 'bg-[#0f3036] text-white' : 'bg-gray-200 text-gray-500'}">
            ${index + 1}
          </span>
          <div class="flex flex-col">
            <button type="button" data-move="up" data-index="${index}" ${index === 0 ? 'disabled' : ''} class="text-gray-400 hover:text-gray-600 disabled:opacity-30 transition-colors">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.5 15.75L12 8.25l7.5 7.5"/></svg>
            </button>
            <button type="button" data-move="down" data-index="${index}" ${index === sections.length - 1 ? 'disabled' : ''} class="text-gray-400 hover:text-gray-600 disabled:opacity-30 transition-colors">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
            </button>
          </div>
        </div>
        <div class="flex-1 px-4">
          <p class="font-bold text-sm ${section.enabled ? 'text-gray-900' : 'text-gray-400 line-through'}">${section.label}</p>
          <p class="text-xs text-gray-400 font-mono">/${section.id}</p>
        </div>
        <button type="button" data-toggle="${section.id}" class="transition-all ${section.enabled ? 'text-green-600' : 'text-gray-300'}">
          ${section.enabled ? '<svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4a8 8 0 100 16 8 8 0 000-16zm0 14a6 6 0 110-12 6 6 0 010 12zm4-9l-5 5-2-2 1.4-1.4 0.6 0.6 3.6-3.6z"/></svg>' : '<svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4a8 8 0 100 16 8 8 0 000-16zm0 14a6 6 0 110-12 6 6 0 010 12z" opacity="0.3"/></svg>'}
        </button>
      </div>
    `).join('');
    bindEvents();
    renderPreview();
    updateStats();
  }

  function renderPreview() {
    if (!previewListEl || !previewEl) return;
    const enabled = sections.filter(s => s.enabled);
    if (!previewMode) {
      previewEl.classList.add('hidden');
      return;
    }
    previewEl.classList.remove('hidden');
    previewListEl.innerHTML = enabled.map((section, index) => `
      <div class="bg-white rounded-lg border-2 border-dashed border-gray-200 p-4 text-center">
        <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Section ${index + 1}: ${section.label}</span>
      </div>
    `).join('');
    if (enabled.length === 0) {
      previewListEl.innerHTML = '<div class="bg-white rounded-lg border-2 border-dashed border-gray-200 p-8 text-center text-sm text-gray-400">No sections enabled</div>';
    }
  }

  function bindEvents() {
    listEl.querySelectorAll('[data-move]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-index'));
        const dir = btn.getAttribute('data-move');
        moveSection(idx, dir);
      });
    });
    listEl.querySelectorAll('[data-toggle]').forEach(btn => {
      btn.addEventListener('click', () => toggleSection(btn.getAttribute('data-toggle')));
    });
  }

  function setSaveState(state) {
    if (!saveBtn || !saveLabel || !saveIcon) return;
    if (state === 'saving') {
      saveBtn.className = 'px-6 py-2.5 rounded-md flex items-center gap-2 font-bold text-sm transition-colors bg-[#0f3036] text-white disabled:opacity-50';
      saveLabel.textContent = 'Saving...';
      saveIcon.innerHTML = '<svg class="animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25"/><path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="4" class="opacity-75"/></svg>';
    } else if (state === 'saved') {
      saveBtn.className = 'px-6 py-2.5 rounded-md flex items-center gap-2 font-bold text-sm transition-colors bg-green-600 text-white';
      saveLabel.textContent = 'Saved!';
      saveIcon.innerHTML = '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>';
    } else {
      saveBtn.className = 'px-6 py-2.5 rounded-md flex items-center gap-2 font-bold text-sm transition-colors bg-[#0f3036] text-white hover:bg-[#1a454c] disabled:opacity-50';
      saveLabel.textContent = 'Ajiye Layout';
      saveIcon.innerHTML = '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>';
    }
  }

  async function handleSave() {
    if (saving) return;
    saving = true;
    setSaveState('saving');
    persistLocal();
    await persistAppwrite();
    saved = true;
    setSaveState('saved');
    setTimeout(() => { saved = false; setSaveState('idle'); saving = false; }, 3000);
  }

  function toggleSection(id) {
    sections = sections.map(s => s.id === id ? { ...s, enabled: !s.enabled } : s);
    persistLocal();
    renderList();
  }

  function moveSection(index, direction) {
    const newSections = [...sections];
    const targetIndex = direction === 'up' ? index - 1 : index + 1;
    if (targetIndex < 0 || targetIndex >= newSections.length) return;
    const tempOrder = newSections[index].order;
    newSections[index] = { ...newSections[index], order: newSections[targetIndex].order };
    newSections[targetIndex] = { ...newSections[targetIndex], order: tempOrder };
    const sorted = newSections.sort((a, b) => a.order - b.order);
    sections = sorted;
    persistLocal();
    renderList();
  }

  if (previewToggle) {
    previewToggle.addEventListener('click', () => {
      previewMode = !previewMode;
      if (previewMode) {
        previewToggle.className = 'px-4 py-2.5 rounded-md flex items-center gap-2 font-bold text-sm transition-colors bg-[#c59d5f] text-white';
        previewToggle.innerHTML = '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg> Edit Mode';
      } else {
        previewToggle.className = 'px-4 py-2.5 rounded-md flex items-center gap-2 font-bold text-sm transition-colors bg-white text-gray-700 border border-gray-200 hover:bg-gray-50';
        previewToggle.innerHTML = '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg> Preview';
      }
      renderPreview();
    });
  }
  if (saveBtn) saveBtn.addEventListener('click', handleSave);

  updateStats();
  renderList();
</script>
