---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireUser } from '@lib/auth';

export const prerender = false;

const auth = await requireUser(Astro.request);
if (!auth.ok) return Astro.redirect('/admin/login?next=/admin/articles/new');
---

<AdminLayout title="Sabon Labari" active="articles">
  <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6 max-w-5xl mx-auto w-full">
    <div class="flex items-center justify-between border-b border-gray-200 pb-4">
      <div>
        <h2 class="text-xl md:text-2xl font-bold text-gray-800">Sabon Labari</h2>
        <p class="text-sm text-gray-500">Ƙirƙiri sabon labari</p>
      </div>
      <a href="/admin/articles" class="px-4 py-2 text-sm font-bold text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50">← Komawa</a>
    </div>

    <form id="create-form" class="space-y-6 bg-white rounded-xl border border-gray-200 shadow-sm p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Headline *</span>
          <input type="text" name="headline" required placeholder="Taken labari" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none" />
        </label>
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Kicker</span>
          <input type="text" name="kicker" placeholder="Kicker" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none" />
        </label>
      </div>

      <label class="block">
        <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Trail / Summary</span>
        <textarea name="trail" rows="2" placeholder="Taƙaitaccen bayani" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none"></textarea>
      </label>

      <label class="block">
        <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Body (HTML)</span>
        <textarea name="body" rows="12" placeholder="<p>Abun ciki...</p>" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-3 text-sm font-mono focus:ring-2 focus:ring-[#c59d5f] outline-none"></textarea>
      </label>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Image URL</span>
          <input type="url" name="image" placeholder="https://..." class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none" />
        </label>
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Author</span>
          <input type="text" name="author" placeholder="Sunan marubuci" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none" />
        </label>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Pillar</span>
          <select name="pillar" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm bg-white focus:ring-2 focus:ring-[#c59d5f] outline-none">
            <option value="news">News</option>
            <option value="sport">Sport</option>
            <option value="opinion">Opinion</option>
            <option value="culture">Culture</option>
            <option value="lifestyle">Lifestyle</option>
          </select>
        </label>
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Section</span>
          <input type="text" name="section" value="headlines" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none" />
        </label>
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Status</span>
          <select name="status" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm bg-white focus:ring-2 focus:ring-[#c59d5f] outline-none">
            <option value="draft">Draft</option>
            <option value="published">Published</option>
            <option value="scheduled">Scheduled</option>
            <option value="review">Review</option>
          </select>
        </label>
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Slug</span>
          <input type="text" name="slug" placeholder="taken-labari" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none" />
        </label>
      </div>

      <label class="block">
        <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Tags (comma separated)</span>
        <input type="text" name="tags" placeholder=" siyasa, zabe, ..." class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none" />
      </label>

      <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-[#0f3036] text-white px-6 py-2.5 rounded-lg font-bold hover:bg-[#1a454c] transition-colors">Ƙirƙiri Labari</button>
        <a href="/admin/articles" class="px-6 py-2.5 rounded-lg font-bold text-gray-600 border border-gray-200 hover:bg-gray-50">Soke</a>
      </div>
    </form>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
      <strong>Lura:</strong> Wannan sigar ƙirƙira ce mai sauƙi ba tare da React ba — tana guje wa matsalar <code>Invalid hook call</code>.
    </div>
  </div>
</AdminLayout>

<script is:inline>
  const form = document.getElementById('create-form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const data = Object.fromEntries(fd.entries());
    if (typeof data.tags === 'string') data.tags = data.tags.split(',').map(s => s.trim()).filter(Boolean);
    try {
      const res = await fetch('/api/admin/articles', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const out = await res.json().catch(()=>({}));
      if (!res.ok || out.ok===false) throw new Error(out.message || 'Create failed');
      const id = out.id || out.$id;
      if (id) window.location.href = `/admin/articles/${encodeURIComponent(id)}`;
      else window.location.href = '/admin/articles';
    } catch (err) {
      alert('Ƙirƙira ya gaza: ' + (err.message || err));
    }
  });
</script>
