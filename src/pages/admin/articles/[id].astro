---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getArticleById } from '@lib/appwrite-server';
import { requireUser } from '@lib/auth';

export const prerender = false;

const auth = await requireUser(Astro.request);
if (!auth.ok) return Astro.redirect('/admin/login?next=/admin/articles');

const id = Astro.params.id;
if (!id) return Astro.redirect('/admin/articles');
const article = await getArticleById(id);
if (!article) return Astro.redirect('/admin/articles');

const isEditing = true;
---

<AdminLayout title="Gyara Labari" active="articles">
  <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6 max-w-5xl mx-auto w-full">
    <div class="flex items-center justify-between border-b border-gray-200 pb-4">
      <div>
        <h2 class="text-xl md:text-2xl font-bold text-gray-800">Gyara Labari</h2>
        <p class="text-sm text-gray-500">ID: {article.$id}</p>
      </div>
      <a href="/admin/articles" class="px-4 py-2 text-sm font-bold text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50">← Komawa</a>
    </div>

    <form method="post" action={`/api/admin/articles/${article.$id}`} class="space-y-6 bg-white rounded-xl border border-gray-200 shadow-sm p-6">
      <input type="hidden" name="_method" value="PUT" />
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Headline *</span>
          <input type="text" name="headline" value={article.headline} required class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none" />
        </label>
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Kicker</span>
          <input type="text" name="kicker" value={(article as any).kicker ?? ''} class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none" />
        </label>
      </div>

      <label class="block">
        <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Trail / Summary</span>
        <textarea name="trail" rows="2" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none">{article.trail}</textarea>
      </label>

      <label class="block">
        <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Body (HTML)</span>
        <textarea name="body" rows="12" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-3 text-sm font-mono focus:ring-2 focus:ring-[#c59d5f] outline-none">{article.body}</textarea>
      </label>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Image URL</span>
          <input type="url" name="image" value={article.image ?? ''} class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none" />
        </label>
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Author</span>
          <input type="text" name="author" value={article.author ?? ''} class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none" />
        </label>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Pillar</span>
          <select name="pillar" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm bg-white focus:ring-2 focus:ring-[#c59d5f] outline-none">
            <option value="news" selected={article.pillar==='news'}>News</option>
            <option value="sport" selected={article.pillar==='sport'}>Sport</option>
            <option value="opinion" selected={article.pillar==='opinion'}>Opinion</option>
            <option value="culture" selected={article.pillar==='culture'}>Culture</option>
            <option value="lifestyle" selected={article.pillar==='lifestyle'}>Lifestyle</option>
          </select>
        </label>
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Section</span>
          <input type="text" name="section" value={article.section ?? ''} class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none" />
        </label>
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Status</span>
          <select name="status" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm bg-white focus:ring-2 focus:ring-[#c59d5f] outline-none">
            <option value="draft" selected={(article as any).status==='draft'}>Draft</option>
            <option value="published" selected={(article as any).status==='published' || !article.status}>Published</option>
            <option value="scheduled" selected={(article as any).status==='scheduled'}>Scheduled</option>
            <option value="review" selected={(article as any).status==='review'}>Review</option>
          </select>
        </label>
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Slug</span>
          <input type="text" name="slug" value={article.slug ?? ''} class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none" />
        </label>
      </div>

      <label class="block">
        <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Tags (comma separated)</span>
        <input type="text" name="tags" value={Array.isArray(article.tags) ? (article.tags as string[]).join(', ') : (article.tags as any) ?? ''} class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#c59d5f] outline-none" />
      </label>

      <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-[#0f3036] text-white px-6 py-2.5 rounded-lg font-bold hover:bg-[#1a454c] transition-colors">Ajiye Canje-canje</button>
        <a href="/admin/articles" class="px-6 py-2.5 rounded-lg font-bold text-gray-600 border border-gray-200 hover:bg-gray-50">Soke</a>
        <span class="ml-auto text-xs text-gray-400">ID: {article.$id}</span>
      </div>
    </form>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
      <strong>Lura:</strong> Wannan sigar gyara ce mai sauƙi ba tare da React ba — tana guje wa matsalar <code>Invalid hook call</code>. Cikakken editan React zai dawo bayan gyaran React.
    </div>
  </div>
</AdminLayout>

<script is:inline>
  const form = document.querySelector('form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const data = Object.fromEntries(fd.entries());
    // tags as array
    if (typeof data.tags === 'string') data.tags = data.tags.split(',').map(s => s.trim()).filter(Boolean);
    // _method handling
    const id = window.location.pathname.split('/').pop();
    try {
      const res = await fetch(`/api/admin/articles/${encodeURIComponent(id)}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const out = await res.json().catch(()=>({}));
      if (!res.ok || out.ok===false) throw new Error(out.message || 'Update failed');
      alert('An ajiye!');
      window.location.href = '/admin/articles';
    } catch (err) {
      alert('Ajiye ya gaza: ' + (err.message || err));
    }
  });
</script>
