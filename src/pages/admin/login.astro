---
import '../../styles/global.css';
import { requireUser, createAdminSession, adminCookieHeader } from '@lib/auth';

export const prerender = false;

const next = new URL(Astro.request.url).searchParams.get('next') ?? '/admin/dashboard';
let error = '';
let emailValue = '';

// Check if already authenticated as admin
const auth = await requireUser(Astro.request);
if (auth.ok) {
  return Astro.redirect(next);
}

const SESSION_TTL = 60 * 60 * 12;

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const email = String(formData.get('email') ?? '').trim();
    const password = String(formData.get('password') ?? '');
    emailValue = email;

    if (!email || !password) {
      error = 'Shigar da imel da kalmar sirri don Allah';
    } else {
      const result = await createAdminSession(email, password);
      if (!('token' in result)) {
        error = result.message || 'Imel ko kalmar sirri ba daidai ba ne';
      } else {
        Astro.cookies.set('yc_session', result.token, {
          path: '/',
          httpOnly: true,
          sameSite: 'lax',
          maxAge: SESSION_TTL,
          secure: import.meta.env.PROD,
        });
        return new Response(null, {
          status: 302,
          headers: {
            Location: next,
            'Set-Cookie': adminCookieHeader(result.token, SESSION_TTL),
          },
        });
      }
    }
  } catch (err: any) {
    error = err?.message || 'An sami matsala wajen shiga. Gwada sake.';
  }
}
---

<!doctype html>
<html lang="ha">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/icons/yc-mark.svg" />
    <title>Shiga Tsarin Gudanarwa — Yanci Admin</title>
  </head>
  <body class="antialiased">
    <div class="min-h-screen bg-[#0f3036] flex items-center justify-center p-4">
      <div class="max-w-md w-full">
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white/10 mb-4">
            <svg class="text-[#c59d5f] text-2xl" style="width:1em;height:1em" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M144 144v48H304V144c0-44.2-35.8-80-80-80s-80 35.8-80 80zM80 192V144C80 64.5 144.5 0 224 0s144 64.5 144 144v48h16c35.3 0 64 28.7 64 64V448c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V256c0-35.3 28.7-64 64-64H80z"></path></svg>
          </div>
          <h1 class="text-2xl font-black text-white tracking-tight">Yanci Admin</h1>
          <p class="text-white/50 text-sm mt-1">Shigar da imel da kalmar sirri don shiga</p>
        </div>

        <div class="bg-white rounded-2xl shadow-2xl p-8">
          <form id="admin-login-form" method="POST" action={`/admin/login?next=${encodeURIComponent(next)}`} class="space-y-5">
            <div>
              <label for="email" class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wider">
                <svg class="inline w-3 h-3 mr-1 text-[#c59d5f]" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48L48 64zM0 176L0 384c0 35.3 28.7 64 64 64l384 0c35.3 0 64-28.7 64-64l0-208L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z"></path></svg>
                Imel
              </label>
              <input
                id="email"
                name="email"
                type="email"
                value={emailValue}
                placeholder="admin@yanci.ng"
                required
                autocomplete="username"
                class="w-full border border-gray-200 rounded-xl px-3 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#c59d5f] focus:border-transparent bg-gray-50 transition"
              />
            </div>

            <div>
              <label for="password" class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wider">
                <svg class="inline w-3 h-3 mr-1 text-[#c59d5f]" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M336 352c97.2 0 176-78.8 176-176S433.2 0 336 0S160 78.8 160 176c0 18.7 2.9 36.8 8.3 53.7L7 391c-4.5 4.5-7 10.6-7 17l0 80c0 13.3 10.7 24 24 24l80 0c13.3 0 24-10.7 24-24l0-40 40 0c13.3 0 24-10.7 24-24l0-40 40 0c6.4 0 12.5-2.5 17-7l33.3-33.3c16.9 5.4 35 8.3 53.7 8.3zM376 96a40 40 0 1 1 0 80 40 40 0 1 1 0-80z"></path></svg>
                Kalmar Sirri
              </label>
              <input
                id="password"
                name="password"
                type="password"
                placeholder="••••••••"
                required
                autocomplete="current-password"
                class="w-full border border-gray-200 rounded-xl px-3 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#c59d5f] focus:border-transparent bg-gray-50 transition"
              />
            </div>

            <div class="flex justify-end">
              <a href="/admin/forgot-password" class="text-xs text-[#c59d5f] hover:text-[#b0884a] transition-colors font-medium">
                Manta kalmar sirri?
              </a>
            </div>

            <div id="login-error" class:list={['bg-red-50 border border-red-100 rounded-xl px-4 py-3 text-sm text-red-700 font-medium', error ? 'block' : 'hidden']}>
              <span id="login-error-text">{error}</span>
            </div>

            <button
              id="login-submit-btn"
              type="submit"
              class="w-full bg-[#0f3036] text-white py-3.5 rounded-xl font-bold hover:bg-[#1a4e56] transition-colors disabled:opacity-50 disabled:cursor-not-allowed text-sm tracking-wide"
            >
              <span id="btn-text">Shiga Tsarin</span>
            </button>
          </form>

          <div class="mt-6 text-center">
            <a href="/" class="text-xs text-gray-400 hover:text-[#0f3036] transition-colors">
              &larr; Koma Shafin Jama'a
            </a>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      const form = document.getElementById('admin-login-form');
      const btn = document.getElementById('login-submit-btn');
      const btnText = document.getElementById('btn-text');
      const errBox = document.getElementById('login-error');
      const errText = document.getElementById('login-error-text');
      const emailInput = document.getElementById('email');
      const passwordInput = document.getElementById('password');
      function updateBtnState() {
        if (!btn) return;
        const hasValues = emailInput && passwordInput && emailInput.value.trim() && passwordInput.value;
        if (hasValues && !btn.hasAttribute('data-loading')) {
          btn.removeAttribute('disabled');
        } else if (!hasValues && !btn.hasAttribute('data-loading')) {
          btn.setAttribute('disabled', 'true');
        }
      }
      if (emailInput) emailInput.addEventListener('input', () => { if (errBox) { errBox.classList.add('hidden'); errBox.classList.remove('block'); } updateBtnState(); });
      if (passwordInput) passwordInput.addEventListener('input', () => { if (errBox) { errBox.classList.add('hidden'); errBox.classList.remove('block'); } updateBtnState(); });
      updateBtnState();
      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (btn) {
            btn.setAttribute('disabled', 'true');
            btn.setAttribute('data-loading', 'true');
          }
          if (btnText) btnText.textContent = 'Ana shiga...';
          if (errBox) {
            errBox.classList.add('hidden');
            errBox.classList.remove('block');
          }
          const email = form.email.value;
          const password = form.password.value;
          try {
            const res = await fetch('/api/auth/login', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email, password }),
            });
            const data = await res.json();
            if (!res.ok || !data.ok) {
              throw new Error(data.message || 'Imel ko kalmar sirri ba daidai ba ne');
            }
            const params = new URLSearchParams(window.location.search);
            const target = params.get('next') || '/admin/dashboard';
            window.location.assign(target);
          } catch (err) {
            if (errBox && errText) {
              errText.textContent = err.message || 'An sami matsala wajen shiga. Gwada sake.';
              errBox.classList.remove('hidden');
              errBox.classList.add('block');
            }
            if (btn) {
              btn.removeAttribute('data-loading');
              updateBtnState();
            }
            if (btnText) btnText.textContent = 'Shiga Tsarin';
          }
        });
      }
    </script>
  </body>
</html>
