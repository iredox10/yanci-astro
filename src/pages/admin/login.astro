---
import '../../styles/global.css';
import { requireUser } from '@lib/auth';
import AdminLogin from '../../components/admin/AdminLogin';

export const prerender = false;

const auth = await requireUser(Astro.request);
const next = new URL(Astro.request.url).searchParams.get('next') ?? '/admin/dashboard';

if (auth.ok) {
  return Astro.redirect(next);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — Yanci Admin</title>
  </head>
  <body class="bg-yanci-paper text-yanci-dark">
    <div class="flex min-h-screen flex-col items-center justify-center px-4">
      <a href="/" class="mb-8 flex items-center gap-2">
        <span class="font-serif text-3xl font-bold text-yanci-primary">Yanci</span>
        <span class="rounded-sm bg-yanci-accent px-2 py-0.5 text-xs font-bold uppercase tracking-widest text-yanci-primary">
          Admin
        </span>
      </a>
      <div class="w-full max-w-sm border border-yanci-primary/15 bg-white/60 p-6">
        <h1 class="font-serif text-xl font-bold text-yanci-primary">Sign in</h1>
        <p class="mt-1 text-sm text-yanci-primary/60">
          Use your Yanci account credentials. Only editorial roles are allowed.
        </p>
        <AdminLogin client:load next={next} />
      </div>
      <a
        href="/admin/forgot-password"
        class="mt-4 text-sm text-yanci-primary/60 hover:text-yanci-primary"
      >
        An manta kalmar shiga?
      </a>
      <a href="/" class="mt-6 text-sm text-yanci-primary/60 hover:text-yanci-primary">← Back to site</a>
    </div>
  </body>
</html>
