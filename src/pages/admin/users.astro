---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminUsersClient from '../../components/admin/AdminUsersClient';
import { adminListCollection } from '@lib/admin-collections';

export const prerender = false;

const invitations = await adminListCollection('invitations');

const normalized = invitations.map((d: any) => ({
  $id: d.$id,
  $createdAt: d.$createdAt,
  name: String(d.name ?? ''),
  email: String(d.email ?? ''),
  token: String(d.token ?? ''),
  role: String(d.role ?? ''),
  labels: typeof d.labels === 'string' ? d.labels.split(',').filter(Boolean) : d.labels || [],
  status: String(d.status ?? 'pending'),
  expires_at: String(d.expires_at ?? d.expiresAt ?? ''),
}));
---

<AdminLayout title="User Management" active="users">
  <div class="-m-4 md:-m-8">
    <AdminUsersClient client:load initialInvitations={normalized} />
  </div>
</AdminLayout>
