---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getArticles } from '@lib/appwrite-server';
import { requireUser } from '@lib/auth';
import AdminLiveManager from '../../components/admin/AdminLiveManager';

export const prerender = false;

const all = await getArticles(200);
const liveArticles = all.filter((a: any) => Boolean(a.isLive));
const auth = await requireUser(Astro.request);
const userCategory = auth.ok ? ((auth.user as unknown as Record<string, unknown>).category as string | undefined) ?? null : null;
const userName = auth.ok ? auth.user.name : null;
---

<AdminLayout title="Live Coverage" active="live">
  <div class="-m-4 md:-m-8">
    <AdminLiveManager client:load initialLiveArticles={liveArticles as unknown as any[]} userCategory={userCategory} userName={userName} />
  </div>
</AdminLayout>
