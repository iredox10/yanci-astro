---
import AdminLayout from '../../layouts/AdminLayout.astro';
import StatCard from '../../components/admin/StatCard.astro';
import { buildTrafficReport, normalizeRange, type TrafficReport } from '@lib/reporting';
import { loadArticles } from '@lib/content';

export const prerender = false;

const days = normalizeRange(Astro.url.searchParams.get('days'));
const [report, articles] = await Promise.all([buildTrafficReport(days), loadArticles()]);

const fmt = new Intl.NumberFormat('en-GB');
const titleFor = (a: { headline?: string; ogTitle?: string }) => String(a.headline ?? a.ogTitle ?? 'Untitled');
const articleById = new Map(articles.map((a) => [a.$id, a]));

function share(count: number, total: number): string {
  return total > 0 ? `${Math.round((count / total) * 100)}%` : '0%';
}

const hasData = report.sampledRows > 0 && report.totalViews30d > 0;

interface Bar {
  x: number;
  y: number;
  w: number;
  h: number;
  label: string;
  tip: string;
}

function buildBars(data: TrafficReport['daily']): Bar[] {
  const step = data.length > 60 ? 9 : data.length > 14 ? 22 : 36;
  const width = Math.max(3, Math.round(step * 0.62));
  const max = Math.max(1, ...data.map((d) => d.views));
  const labelEvery = Math.ceil(data.length / 8);
  return data.map((d, i) => {
    const h = Math.max(d.views > 0 ? 3 : 0, Math.round((d.views / max) * 130));
    const date = new Date(`${d.day}T00:00:00Z`);
    const showLabel = i % labelEvery === 0 || i === data.length - 1;
    const labelText = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(date);
    return {
      x: i * step,
      y: 140 - h,
      w: width,
      h,
      label: showLabel ? labelText : '',
      tip: `${labelText}: ${fmt.format(d.views)} view${d.views === 1 ? '' : 's'}`,
    };
  });
}

const bars = buildBars(report.daily);
const chartStep = report.daily.length > 60 ? 9 : report.daily.length > 14 ? 22 : 36;
const chartW = Math.max(chartStep * report.daily.length, 120);
const sectionTotal = report.sections.reduce((sum, s) => sum + s.count, 0);
const deviceTotal = report.devices.reduce((sum, d) => sum + d.count, 0);

const visitorNote =
  report.visitorBasis === 'sessions'
    ? 'Unique sessions'
    : report.visitorBasis === 'device-day'
      ? 'Estimate from device/day pairs'
      : '';
---

<AdminLayout title="Reports" active="reports">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="font-serif text-2xl font-bold text-yanci-primary">Traffic reports</h1>
      <p class="mt-1 text-sm text-yanci-primary/60">
        Aggregated over the views collection
        {report.truncated && <span class:text-yanci-red> &middot; sample capped at {fmt.format(20000)} rows</span>}
      </p>
    </div>
    <nav class="flex gap-1" aria-label="Date range">
      {[7, 30, 90].map((n) => (
        <a
          href={`/admin/reports?days=${n}`}
          class:list={[
            'border px-3 py-1.5 text-sm font-medium transition-colors',
            n === days
              ? 'border-yanci-primary bg-yanci-primary text-yanci-paper'
              : 'border-yanci-primary/25 text-yanci-primary/70 hover:bg-yanci-primary/10',
          ]}
          aria-current={n === days ? 'page' : undefined}
        >
          {n}d
        </a>
      ))}
    </nav>
  </div>

  {!hasData ? (
    <section class="mt-10 border border-yanci-primary/15 bg-white/60 p-16 text-center">
      <p class="font-serif text-xl font-bold text-yanci-primary">Babu bayanan kai ziyara</p>
      <p class="mt-2 text-sm text-yanci-primary/50">No page views recorded yet. Once readers start visiting, traffic reports will appear here.</p>
    </section>
  ) : (
    <>
      <section class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
        <StatCard label={`Views · last ${days}d`} value={fmt.format(report.daily.reduce((s, d) => s + d.views, 0))} />
        <StatCard label="Views · last 7d" value={fmt.format(report.totalViews7d)} />
        <StatCard label="Views · last 30d" value={fmt.format(report.totalViews30d)} />
        <StatCard
          label={report.visitorBasis === 'sessions' ? 'Unique visitors · 7d' : 'Visitors (est.) · 7d'}
          value={fmt.format(report.uniqueVisitors7d)}
        />
      </section>
      {visitorNote && <p class="mt-2 text-xs text-yanci-primary/45">{visitorNote}</p>}

      <section class="mt-8 border border-yanci-primary/15 bg-white/60 p-5">
        <div class="flex items-baseline justify-between border-b border-yanci-primary/20 pb-2">
          <h2 class="font-serif text-lg font-bold text-yanci-primary">Daily views</h2>
          <p class="text-xs uppercase tracking-widest text-yanci-primary/50">Last {days} days</p>
        </div>
        <svg
          viewBox={`-4 -12 ${chartW + 8} 176`}
          preserveAspectRatio="none"
          class="mt-4 h-48 w-full"
          role="img"
          aria-label={`Daily page views for the last ${days} days`}
        >
          <line x1="-4" y1="140.5" x2={chartW} y2="140.5" stroke="#0f3036" stroke-opacity="0.2" stroke-width="1"></line>
          {bars.map((b) => (
            <g>
              <title>{b.tip}</title>
              {b.h > 0 && (
                <rect x={b.x} y={b.y} width={b.w} height={b.h} fill="#c59d5f" rx="1">
                </rect>
              )}
            </g>
          ))}
          {bars.map((b) =>
            b.label ? (
              <text x={b.x + b.w / 2} y="158" font-size="10" fill="#0f3036" fill-opacity="0.5" text-anchor="middle">
                {b.label}
              </text>
            ) : null
          )}
        </svg>
      </section>

      <section class="mt-8 grid gap-6 lg:grid-cols-2">
        <div>
          <h2 class="border-b border-yanci-primary/20 pb-2 font-serif text-lg font-bold text-yanci-primary">
            Top 10 articles
          </h2>
          <table class="mt-3 w-full text-sm">
            <thead>
              <tr class="border-b border-yanci-primary/15 text-left text-xs font-semibold uppercase tracking-widest text-yanci-primary/50">
                <th class="py-2 pr-2 font-semibold">#</th>
                <th class="py-2 pr-2 font-semibold">Article</th>
                <th class="py-2 text-right font-semibold">Views</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-yanci-primary/10">
              {report.topArticles.map((t, i) => {
                const article = articleById.get(t.articleId);
                return (
                  <tr>
                    <td class="py-2 pr-2 font-serif font-bold text-yanci-accent">{i + 1}</td>
                    <td class="max-w-xs truncate py-2 pr-2">
                      <a href={`/admin/articles/${t.articleId}`} class="font-medium text-yanci-dark/85 hover:text-yanci-primary hover:underline">
                        {article ? titleFor(article) : 'Deleted article'}
                      </a>
                    </td>
                    <td class="py-2 text-right font-semibold text-yanci-primary">{fmt.format(t.views)}</td>
                  </tr>
                );
              })}
              {report.topArticles.length === 0 && (
                <tr><td colspan="3" class="py-4 text-center text-sm text-yanci-primary/50">Babu bayanan kai ziyara</td></tr>
              )}
            </tbody>
          </table>
        </div>

        <div>
          <h2 class="border-b border-yanci-primary/20 pb-2 font-serif text-lg font-bold text-yanci-primary">
            Section split
          </h2>
          <ul class="mt-3 space-y-2.5">
            {report.sections.map((s) => (
              <li>
                <div class="flex items-baseline justify-between text-sm">
                  <span class="capitalize text-yanci-dark/80">{s.name}</span>
                  <span class="text-yanci-primary/60">
                    <span class="font-semibold text-yanci-primary">{fmt.format(s.count)}</span>
                    <span class="ml-1.5 text-xs">{share(s.count, sectionTotal)}</span>
                  </span>
                </div>
                <div class="mt-1 h-1.5 w-full bg-yanci-primary/10">
                  <div class="h-full bg-yanci-teal" style={`width:${share(s.count, sectionTotal)}`}></div>
                </div>
              </li>
            ))}
            {report.sections.length === 0 && <li class="text-sm text-yanci-primary/50">Babu bayanan kai ziyara</li>}
          </ul>
        </div>
      </section>

      <section class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="border border-yanci-primary/15 bg-white/60 p-5">
          <h2 class="border-b border-yanci-primary/20 pb-2 font-serif text-lg font-bold text-yanci-primary">
            Devices
          </h2>
          <table class="mt-3 w-full text-sm">
            <tbody class="divide-y divide-yanci-primary/10">
              {report.devices.map((d) => (
                <tr>
                  <td class="py-2 capitalize text-yanci-dark/80">{d.name}</td>
                  <td class="w-24 py-2 text-right font-semibold text-yanci-primary">{fmt.format(d.count)}</td>
                  <td class="w-16 py-2 text-right text-xs text-yanci-primary/50">{share(d.count, deviceTotal)}</td>
                </tr>
              ))}
              {report.devices.length === 0 && (
                <tr><td colspan="3" class="py-4 text-center text-yanci-primary/50">Babu bayanan kai ziyara</td></tr>
              )}
            </tbody>
          </table>
        </div>

        <div class="border border-yanci-primary/15 bg-white/60 p-5">
          <h2 class="border-b border-yanci-primary/20 pb-2 font-serif text-lg font-bold text-yanci-primary">
            Top referrers
          </h2>
          <table class="mt-3 w-full text-sm">
            <thead>
              <tr class="border-b border-yanci-primary/15 text-left text-xs font-semibold uppercase tracking-widest text-yanci-primary/50">
                <th class="py-2 font-semibold">Source</th>
                <th class="py-2 text-right font-semibold">Views</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-yanci-primary/10">
              {report.referrers.map((r) => (
                <tr>
                  <td class="py-2 truncate text-yanci-dark/80">{r.name}</td>
                  <td class="py-2 text-right font-semibold text-yanci-primary">{fmt.format(r.count)}</td>
                </tr>
              ))}
              {report.referrers.length === 0 && (
                <tr><td colspan="2" class="py-4 text-center text-yanci-primary/50">Babu bayanan kai ziyara</td></tr>
              )}
            </tbody>
          </table>
        </div>
      </section>
    </>
  )}

  {hasData && (
    <p class="mt-8 text-xs text-yanci-primary/40">
      Sample of {fmt.format(report.sampledRows)} tracked rows
      {report.activeArticles > 0 && ` across ${fmt.format(report.activeArticles)} articles`} &middot;
      avg {report.avgViewsPerArticle} views/article &middot; deeper history in <a href="/admin/analytics" class="underline hover:text-yanci-primary">Analytics</a>.
    </p>
  )}
</AdminLayout>
