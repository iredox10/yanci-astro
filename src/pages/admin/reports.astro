---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import {
  FaChartBar,
  FaSpinner,
  FaWandMagicSparkles,
  FaFileLines,
  FaArrowTrendUp,
  FaArrowTrendDown,
  FaCalendar,
  FaDownload,
} from 'react-icons/fa6';
import { getArticles } from '@lib/appwrite-server';

export const prerender = false;

type IconCmp = React.ComponentType<{ className?: string }>;
const ic = (Icon: IconCmp, cls = 'w-5 h-5 shrink-0') =>
  renderToStaticMarkup(createElement(Icon, { className: cls }));

let articles: any[] = [];
try {
  articles = await getArticles(500);
} catch {}
const safeArticles = articles || [];
const sections = [...new Set(safeArticles.map((a) => a.section).filter(Boolean))];
const published = safeArticles.filter((a) => a.status === 'published');
const authors = [...new Set(safeArticles.map((a) => a.author).filter(Boolean))];
const avgWords = Math.round(
  published.reduce((sum, a) => sum + ((a.body ?? '').replace(/<[^>]*>/g, ' ').split(/\s+/).length || 0), 0) /
    (published.length || 1)
);
const articlesJson = JSON.stringify(safeArticles);
---

<AdminLayout title="Reports" active="reports">
    <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-200 pb-4">
        <div>
          <h2 class="text-xl md:text-2xl font-bold text-gray-800 flex items-center gap-2">
            <span set:html={ic(FaChartBar, 'w-5 h-5 text-[#c59d5f]')} /> Automated Reports
          </h2>
          <p class="text-sm text-gray-500 mt-1">AI-generated performance and content reports</p>
        </div>
      </div>

      <!-- Controls -->
      <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
        <h3 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2">
          <span set:html={ic(FaWandMagicSparkles, 'w-4 h-4 text-[#c59d5f]')} /> Generate Report
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
          <div>
            <label class="text-xs font-bold text-gray-500 mb-1 block">Time Period</label>
            <select
              id="report-type"
              class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#c59d5f]"
            >
              <option value="weekly">Weekly</option>
              <option value="monthly">Monthly</option>
              <option value="all">All Time</option>
            </select>
          </div>
          <div>
            <label class="text-xs font-bold text-gray-500 mb-1 block">Section</label>
            <select
              id="report-scope"
              class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#c59d5f]"
            >
              <option value="all">All Sections</option>
              {sections.map((s) => (
                <option value={String(s)}>{String(s).charAt(0).toUpperCase() + String(s).slice(1)}</option>
              ))}
            </select>
          </div>
          <div class="flex items-end">
            <button
              id="generate-report"
              type="button"
              class="w-full bg-[#0f3036] text-white px-6 py-2.5 rounded-lg font-bold text-sm hover:bg-[#1a454c] disabled:opacity-50 flex items-center justify-center gap-2"
            >
              <span id="gen-icon" set:html={ic(FaFileLines, 'w-4 h-4')} />
              <span id="gen-label">Generate Report</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Quick Stats -->
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center"><span set:html={ic(FaFileLines, 'w-5 h-5 text-blue-600')} /></div>
            <span class="text-sm text-gray-500 font-medium">Total Articles</span>
          </div>
          <p class="text-3xl font-black text-gray-900">{published.length}</p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center"><span set:html={ic(FaArrowTrendUp, 'w-5 h-5 text-green-600')} /></div>
            <span class="text-sm text-gray-500 font-medium">Sections</span>
          </div>
          <p class="text-3xl font-black text-gray-900">{sections.length}</p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center"><span set:html={ic(FaCalendar, 'w-5 h-5 text-purple-600')} /></div>
            <span class="text-sm text-gray-500 font-medium">Authors</span>
          </div>
          <p class="text-3xl font-black text-gray-900">{authors.length}</p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center"><span set:html={ic(FaChartBar, 'w-5 h-5 text-amber-600')} /></div>
            <span class="text-sm text-gray-500 font-medium">Avg Word Count</span>
          </div>
          <p class="text-3xl font-black text-gray-900">{avgWords}</p>
        </div>
      </div>

      <!-- Report Output -->
      <div id="report-output" class="hidden"></div>

      <div id="report-empty" class="text-center py-16">
        <div class="w-12 h-12 text-gray-200 mx-auto mb-3 flex items-center justify-center"><span set:html={ic(FaChartBar, 'w-12 h-12 text-gray-200')} /></div>
        <p class="text-sm text-gray-400">Select a time period and click "Generate Report" to get AI-powered insights.</p>
      </div>
    </div>
</AdminLayout>

<script is:inline define:vars={{ articlesJson }}>
  const articles = JSON.parse(articlesJson);
  const genBtn = document.getElementById('generate-report');
  const genIcon = document.getElementById('gen-icon');
  const genLabel = document.getElementById('gen-label');
  const output = document.getElementById('report-output');
  const empty = document.getElementById('report-empty');
  const reportTypeEl = document.getElementById('report-type');
  const reportScopeEl = document.getElementById('report-scope');

  let generating = false;
  let report = null;

  const spinnerSvg = '<svg class="animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25"/><path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="4" class="opacity-75"/></svg>';
  const fileSvg = '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V7z"/><polyline points="14 2 14 8 20 8"/></svg>';

  function setGenerating(v) {
    generating = v;
    if (!genBtn || !genIcon || !genLabel) return;
    genBtn.disabled = v;
    genIcon.innerHTML = v ? spinnerSvg : fileSvg;
    genLabel.textContent = v ? 'Generating...' : 'Generate Report';
  }

  function escapeHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function renderReport(report, reportType) {
    if (!output) return;
    const title = report.title || `${reportType.charAt(0).toUpperCase() + reportType.slice(1)} Report`;
    const summary = report.summary ? `<div><p class="text-xs font-bold text-gray-500 mb-1">Executive Summary</p><p class="text-sm text-gray-700 leading-relaxed">${escapeHtml(report.summary)}</p></div>` : '';
    const highlights = report.highlights && report.highlights.length ? `
      <div>
        <p class="text-xs font-bold text-gray-500 mb-2">Key Highlights</p>
        <div class="space-y-2">
          ${report.highlights.map((h) => {
            let icon = '<svg class="w-4 h-4 text-gray-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>';
            if (h.trend === 'up') icon = '<svg class="w-4 h-4 text-green-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>';
            else if (h.trend === 'down') icon = '<svg class="w-4 h-4 text-red-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/><polyline points="17 18 23 18 23 12"/></svg>';
            return `<div class="flex items-start gap-2 text-sm">${icon}<span class="text-gray-700">${escapeHtml(h.text)}</span></div>`;
          }).join('')}
        </div>
      </div>` : '';
    const recommendations = report.recommendations && report.recommendations.length ? `
      <div>
        <p class="text-xs font-bold text-gray-500 mb-2">Recommendations</p>
        <div class="space-y-1.5">
          ${report.recommendations.map((r,i) => `<p class="text-sm text-gray-700 flex items-start gap-2"><span class="w-5 h-5 bg-[#c59d5f]/10 text-[#c59d5f] rounded-full flex items-center justify-center text-xs font-bold shrink-0">${i+1}</span>${escapeHtml(r)}</p>`).join('')}
        </div>
      </div>` : '';
    const insights = report.insights ? `<div><p class="text-xs font-bold text-gray-500 mb-1">AI Insights</p><div class="text-sm text-gray-700 whitespace-pre-wrap">${escapeHtml(report.insights)}</div></div>` : '';

    output.innerHTML = `
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between p-4 border-b border-gray-100 bg-[#0f3036]/5">
          <h3 class="text-sm font-bold text-gray-700">${escapeHtml(title)}</h3>
          <button id="copy-json" class="text-xs text-[#0f3036] hover:underline font-bold flex items-center gap-1"><svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Copy JSON</button>
        </div>
        <div class="p-5 space-y-4">
          ${summary}
          ${highlights}
          ${recommendations}
          ${insights}
        </div>
      </div>
    `;
    output.classList.remove('hidden');
    if (empty) empty.classList.add('hidden');
    const copyBtn = document.getElementById('copy-json');
    if (copyBtn) copyBtn.addEventListener('click', () => navigator.clipboard.writeText(JSON.stringify(report, null, 2)));
  }

  async function generateReport() {
    if (generating) return;
    setGenerating(true);
    if (output) output.classList.add('hidden');
    try {
      const reportType = reportTypeEl ? reportTypeEl.value : 'weekly';
      const reportScope = reportScopeEl ? reportScopeEl.value : 'all';
      const publishedArticles = articles.filter((a) => a.status === 'published');
      const now = new Date();
      let filtered = publishedArticles;
      if (reportType === 'weekly') {
        const weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
        filtered = publishedArticles.filter((a) => new Date(a.$createdAt || now) >= weekAgo);
      } else if (reportType === 'monthly') {
        const monthAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
        filtered = publishedArticles.filter((a) => new Date(a.$createdAt || now) >= monthAgo);
      }
      if (reportScope !== 'all') {
        filtered = filtered.filter((a) => a.section === reportScope);
      }

      const data = {
        totalArticles: filtered.length,
        sections: [...new Set(filtered.map((a) => a.section))],
        authors: [...new Set(filtered.map((a) => a.author))],
        avgWords: Math.round(filtered.reduce((sum, a) => sum + ((a.body ?? '').replace(/<[^>]*>/g, ' ').split(/\s+/).length || 0), 0) / (filtered.length || 1)),
        topTags: filtered.flatMap((a) => (a.tags || '').split(',').map((t) => t.trim()).filter(Boolean)).slice(0, 10),
      };

      // Try to call gemini via API if configured, otherwise mock
      let reportData = null;
      try {
        const res = await fetch('/api/gemini/report', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ data, reportType }),
        });
        if (res.ok) reportData = await res.json();
      } catch {}

      if (!reportData || reportData.error) {
        // Fallback mock report
        reportData = {
          title: `${reportType.charAt(0).toUpperCase() + reportType.slice(1)} Report — Mock`,
          summary: `This is a mock summary for ${filtered.length} articles across ${data.sections.length} sections. Generated locally because AI is not configured in this environment.`,
          highlights: [
            { text: `${filtered.length} articles published in this period`, trend: 'up' },
            { text: `${data.sections.length} active sections`, trend: 'up' },
            { text: `${data.authors.length} contributing authors`, trend: 'up' },
          ],
          recommendations: [
            'Increase coverage in underperforming sections',
            'Republish evergreen content with updated data',
            'Cross-promote trending topics on social media',
          ],
          insights: JSON.stringify(data, null, 2),
        };
      }

      report = reportData;
      renderReport(reportData, reportType);
    } catch (e) {
      alert('Report generation failed: ' + (e && e.message ? e.message : e));
      if (empty) empty.classList.remove('hidden');
    } finally {
      setGenerating(false);
    }
  }

  if (genBtn) genBtn.addEventListener('click', generateReport);
</script>
