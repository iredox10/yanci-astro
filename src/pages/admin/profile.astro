---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import {
  FaUser,
  FaEnvelope,
  FaLock,
  FaEye,
  FaEyeSlash,
  FaSpinner,
  FaCheck,
  FaTriangleExclamation,
  FaArrowRightFromBracket,
} from 'react-icons/fa6';
import { requireUser } from '@lib/auth';

export const prerender = false;

type IconCmp = React.ComponentType<{ className?: string }>;
const ic = (Icon: IconCmp, cls = 'w-5 h-5 shrink-0') =>
  renderToStaticMarkup(createElement(Icon, { className: cls }));

const auth = await requireUser(Astro.request);
if (!auth.ok) {
  return Astro.redirect(`/admin/login?next=${encodeURIComponent('/admin/profile')}`);
}
const user = auth.user;
const initialName = user.name || '';
const initialEmail = user.email || '';
---

<AdminLayout title="Profile" active="profile">
    <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6">
      <div class="max-w-3xl mx-auto space-y-6">
        <div>
          <h2 class="text-xl md:text-2xl font-bold text-gray-800">Your Profile</h2>
          <p class="text-sm text-gray-500">Manage your account settings</p>
        </div>

        <!-- Profile Card -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
          <h3 class="font-bold text-base text-gray-800 mb-4 flex items-center gap-2">
            <span set:html={ic(FaUser, 'w-4 h-4 text-[#c59d5f]')} /> Profile Information
          </h3>
          <form id="profile-form" class="space-y-4">
            <div>
              <label class="text-xs font-bold text-gray-500 uppercase mb-1 block">Full Name</label>
              <input id="profile-name" value={initialName} class="w-full text-sm p-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#c59d5f] outline-none" />
            </div>
            <div>
              <label class="text-xs font-bold text-gray-500 uppercase mb-1 block">Email</label>
              <input value={initialEmail} disabled class="w-full text-sm p-3 border border-gray-200 rounded-lg bg-gray-50 text-gray-500" />
              <p class="text-xs text-gray-400 mt-1">Email cannot be changed. Contact a super admin if needed.</p>
            </div>
            <div class="flex items-center gap-2 min-h-[20px]">
              <span id="profile-success" class="text-sm text-green-600 font-bold items-center gap-1 hidden"><span set:html={ic(FaCheck, 'w-3 h-3')} /> Profile updated</span>
              <span id="profile-error" class="text-sm text-red-600 font-bold items-center gap-1 hidden"><span set:html={ic(FaTriangleExclamation, 'w-3 h-3')} /> Update failed</span>
            </div>
            <button id="profile-save" type="submit" class="px-6 py-2.5 bg-[#0f3036] text-white rounded-lg font-bold text-sm hover:bg-[#1a454c] disabled:opacity-50 flex items-center gap-2">
              <span id="profile-save-spinner" class="hidden"><span set:html={ic(FaSpinner, 'w-4 h-4 animate-spin')} /></span> Save Changes
            </button>
          </form>
        </div>

        <!-- Password Card -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
          <h3 class="font-bold text-base text-gray-800 mb-4 flex items-center gap-2">
            <span set:html={ic(FaLock, 'w-4 h-4 text-[#c59d5f]')} /> Change Password
          </h3>
          <form id="password-form" class="space-y-4">
            <div>
              <label class="text-xs font-bold text-gray-500 uppercase mb-1 block">Current Password</label>
              <div class="relative">
                <input id="pw-current" type="password" class="w-full text-sm p-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#c59d5f] outline-none pr-10" />
                <button id="toggle-pw" type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                  <span id="eye-open" set:html={ic(FaEye, 'w-4 h-4')} />
                  <span id="eye-closed" class="hidden" set:html={ic(FaEyeSlash, 'w-4 h-4')} />
                </button>
              </div>
            </div>
            <div>
              <label class="text-xs font-bold text-gray-500 uppercase mb-1 block">New Password</label>
              <input id="pw-new" type="password" placeholder="At least 8 characters" class="w-full text-sm p-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#c59d5f] outline-none" />
            </div>
            <div>
              <label class="text-xs font-bold text-gray-500 uppercase mb-1 block">Confirm New Password</label>
              <input id="pw-confirm" type="password" class="w-full text-sm p-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#c59d5f] outline-none" />
            </div>
            <div class="flex items-center gap-2 flex-wrap min-h-[20px]">
              <span id="pw-success" class="text-sm text-green-600 font-bold items-center gap-1 hidden"><span set:html={ic(FaCheck, 'w-3 h-3')} /> Password changed</span>
              <span id="pw-mismatch" class="text-sm text-red-600 font-bold items-center gap-1 hidden"><span set:html={ic(FaTriangleExclamation, 'w-3 h-3')} /> Passwords don't match</span>
              <span id="pw-short" class="text-sm text-red-600 font-bold items-center gap-1 hidden"><span set:html={ic(FaTriangleExclamation, 'w-3 h-3')} /> Password too short</span>
              <span id="pw-error" class="text-sm text-red-600 font-bold items-center gap-1 hidden"><span set:html={ic(FaTriangleExclamation, 'w-3 h-3')} /> Failed. Check current password.</span>
            </div>
            <button id="pw-save" type="submit" class="px-6 py-2.5 bg-[#0f3036] text-white rounded-lg font-bold text-sm hover:bg-[#1a454c] disabled:opacity-50 flex items-center gap-2">
              <span id="pw-spinner" class="hidden"><span set:html={ic(FaSpinner, 'w-4 h-4 animate-spin')} /></span> Update Password
            </button>
          </form>
        </div>

        <!-- Session Card -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
          <h3 class="font-bold text-base text-gray-800 mb-4 flex items-center gap-2">
            <span set:html={ic(FaArrowRightFromBracket, 'w-4 h-4 text-[#c59d5f]')} /> Sessions
          </h3>
          <p class="text-sm text-gray-500 mb-4">Log out from all other devices where you're currently signed in.</p>
          <button id="logout-all" type="button" class="px-4 py-2.5 border border-red-200 text-red-600 rounded-lg font-bold text-sm hover:bg-red-50 flex items-center gap-2">
            <span set:html={ic(FaArrowRightFromBracket, 'w-4 h-4')} /> Logout Everywhere Else
          </button>
        </div>
      </div>
    </div>
</AdminLayout>

<script is:inline>
  const profileForm = document.getElementById('profile-form');
  const profileName = document.getElementById('profile-name');
  const profileSuccess = document.getElementById('profile-success');
  const profileError = document.getElementById('profile-error');
  const profileSave = document.getElementById('profile-save');
  const profileSpinner = document.getElementById('profile-save-spinner');

  const pwForm = document.getElementById('password-form');
  const pwCurrent = document.getElementById('pw-current');
  const pwNew = document.getElementById('pw-new');
  const pwConfirm = document.getElementById('pw-confirm');
  const pwSuccess = document.getElementById('pw-success');
  const pwMismatch = document.getElementById('pw-mismatch');
  const pwShort = document.getElementById('pw-short');
  const pwError = document.getElementById('pw-error');
  const pwSave = document.getElementById('pw-save');
  const pwSpinner = document.getElementById('pw-spinner');
  const togglePw = document.getElementById('toggle-pw');
  const eyeOpen = document.getElementById('eye-open');
  const eyeClosed = document.getElementById('eye-closed');
  const logoutAllBtn = document.getElementById('logout-all');

  let showPw = false;

  function hideAllProfileStatus() {
    if (profileSuccess) { profileSuccess.classList.add('hidden'); profileSuccess.classList.remove('flex'); }
    if (profileError) { profileError.classList.add('hidden'); profileError.classList.remove('flex'); }
  }
  function hideAllPwStatus() {
    if (pwSuccess) { pwSuccess.classList.add('hidden'); pwSuccess.classList.remove('flex'); }
    if (pwMismatch) { pwMismatch.classList.add('hidden'); pwMismatch.classList.remove('flex'); }
    if (pwShort) { pwShort.classList.add('hidden'); pwShort.classList.remove('flex'); }
    if (pwError) { pwError.classList.add('hidden'); pwError.classList.remove('flex'); }
  }

  if (togglePw && pwCurrent && eyeOpen && eyeClosed) {
    togglePw.addEventListener('click', () => {
      showPw = !showPw;
      pwCurrent.type = showPw ? 'text' : 'password';
      eyeOpen.classList.toggle('hidden', showPw);
      eyeClosed.classList.toggle('hidden', !showPw);
    });
  }

  if (profileForm) {
    profileForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAllProfileStatus();
      if (!profileName || !profileSave) return;
      const name = profileName.value.trim();
      profileSave.disabled = true;
      if (profileSpinner) profileSpinner.classList.remove('hidden');
      try {
        // Try new profile endpoint first, fallback to account update
        let res = await fetch('/api/admin/profile', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'name', name }),
        });
        if (!res.ok) {
          // fallback to direct Appwrite account update via API
          res = await fetch('/api/account/name', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name }),
          });
          if (!res.ok) throw new Error('failed');
        }
        if (profileSuccess) { profileSuccess.classList.remove('hidden'); profileSuccess.classList.add('flex'); }
        setTimeout(hideAllProfileStatus, 3000);
      } catch (err) {
        if (profileError) { profileError.classList.remove('hidden'); profileError.classList.add('flex'); }
      } finally {
        profileSave.disabled = false;
        if (profileSpinner) profileSpinner.classList.add('hidden');
      }
    });
  }

  if (pwForm) {
    pwForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAllPwStatus();
      const current = pwCurrent ? pwCurrent.value : '';
      const next = pwNew ? pwNew.value : '';
      const confirm = pwConfirm ? pwConfirm.value : '';
      if (next !== confirm) {
        if (pwMismatch) { pwMismatch.classList.remove('hidden'); pwMismatch.classList.add('flex'); }
        return;
      }
      if (next.length < 8) {
        if (pwShort) { pwShort.classList.remove('hidden'); pwShort.classList.add('flex'); }
        return;
      }
      if (!pwSave) return;
      pwSave.disabled = true;
      if (pwSpinner) pwSpinner.classList.remove('hidden');
      try {
        let res = await fetch('/api/admin/profile', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'password', currentPassword: current, newPassword: next, confirmPassword: confirm }),
        });
        if (!res.ok) {
          // fallback
          res = await fetch('/api/account/password', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ oldPassword: current, newPassword: next }),
          });
          if (!res.ok) throw new Error('failed');
        }
        if (pwCurrent) pwCurrent.value = '';
        if (pwNew) pwNew.value = '';
        if (pwConfirm) pwConfirm.value = '';
        if (pwSuccess) { pwSuccess.classList.remove('hidden'); pwSuccess.classList.add('flex'); }
        setTimeout(hideAllPwStatus, 3000);
      } catch (err) {
        if (pwError) { pwError.classList.remove('hidden'); pwError.classList.add('flex'); }
      } finally {
        pwSave.disabled = false;
        if (pwSpinner) pwSpinner.classList.add('hidden');
      }
    });
  }

  if (logoutAllBtn) {
    logoutAllBtn.addEventListener('click', async () => {
      if (!window.confirm('Log out from all other devices?')) return;
      try {
        // Try delete sessions via API
        let res = await fetch('/api/admin/profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'deleteSessions' }),
        });
        if (!res.ok) {
          res = await fetch('/api/account/sessions', { method: 'DELETE' });
          if (!res.ok) throw new Error('failed');
        }
        // Also call logout endpoint then redirect
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/admin/login';
      } catch (e) {
        alert('Failed to logout from other devices');
      }
    });
  }
</script>
