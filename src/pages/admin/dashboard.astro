---
import AdminLayout from '../../layouts/AdminLayout.astro';
import StatCard from '../../components/admin/StatCard.astro';
import { FaArrowTrendUp, FaEye, FaFileLines } from 'react-icons/fa6';
import { getArticles, getMostRead } from '@lib/appwrite-server';
import { requireUser } from '@lib/auth';

export const prerender = false;

const auth = await requireUser(Astro.request);
const userName = auth.ok ? auth.user.name : 'Staff';

const articles = await getArticles(200);
const mostRead = await getMostRead(5);

const liveArticles = articles.filter((a) => a.isLive);
const newsPillar = articles.filter((a) => String(a.pillar ?? 'news') === 'news');

const totalViews = mostRead.reduce((sum, m) => sum + m.views, 0);
const fmt = new Intl.NumberFormat('en-GB');

const titleFor = (a: { headline?: string; ogTitle?: string }) =>
  String(a.headline ?? a.ogTitle ?? 'Untitled');
const pillarClass = (pillar: string) =>
  pillar === 'news'
    ? 'bg-red-100 text-red-800'
    : pillar === 'sport'
      ? 'bg-blue-100 text-blue-800'
      : 'bg-gray-100 text-gray-800';

const recent = [...articles]
  .sort((a, b) => String(b.$createdAt ?? '').localeCompare(String(a.$createdAt ?? '')))
  .slice(0, 5);
---

<AdminLayout title="Dashboard" active="dashboard">
  <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6 md:space-y-8">
    <div>
      <h2 class="text-xl md:text-2xl font-bold text-gray-800">Dashboard Overview</h2>
      <p class="text-sm md:text-base text-gray-500">Welcome back, <span class="font-bold">{userName}</span>.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      <StatCard
        title="Total Articles"
        value={fmt.format(articles.length)}
        icon={FaFileLines}
        color="bg-blue-500"
      />
      <StatCard
        title="Live Stories"
        value={fmt.format(liveArticles.length)}
        icon={FaArrowTrendUp}
        color="bg-red-500"
      />
      <StatCard
        title="News Pillar"
        value={fmt.format(newsPillar.length)}
        icon={FaEye}
        color="bg-green-500"
      />
      <div class="bg-white p-4 md:p-6 rounded-lg shadow-sm border border-gray-200 col-span-1 sm:col-span-2 lg:col-span-1 flex flex-col justify-between relative overflow-hidden">
        <div class="z-10">
          <p class="text-xs md:text-sm text-gray-500 font-medium uppercase tracking-wider">Page Views (24h)</p>
          <h3 class="text-2xl md:text-3xl font-bold text-gray-900 mt-1">{totalViews > 0 ? fmt.format(totalViews) : '0'}</h3>
          {totalViews > 0 ? (
            <span class="text-green-500 text-xs font-bold">↑ Real-time data</span>
          ) : (
            <span class="text-gray-400 text-xs font-bold">No views yet</span>
          )}
        </div>
        <div class="absolute -bottom-4 -right-4 w-32 h-32 bg-green-50 rounded-full blur-2xl z-0"></div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 md:p-6 overflow-hidden">
      <h3 class="font-bold text-base md:text-lg mb-4 text-[#c70000]">Most Read / Trending</h3>
      {mostRead.length > 0 ? (
        <ul class="space-y-3 mb-6">
          {mostRead.map((m, idx) => {
            const article = articles.find((x) => x.$id === m.articleId);
            return (
              <li class="flex items-center gap-4 group cursor-pointer p-2 hover:bg-gray-50 rounded-lg transition-colors">
                <span class="text-2xl font-black text-gray-200 group-hover:text-[#c59d5f] transition-colors">{idx + 1}</span>
                <span class="flex-1 font-bold text-gray-800 line-clamp-1">{article ? titleFor(article) : 'Deleted article'}</span>
                <span class="text-xs font-bold bg-gray-100 text-gray-500 px-2 py-1 rounded-full">{fmt.format(m.views)} views</span>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="text-gray-400 text-sm mb-6">Babu bayanan karatu tukuna. Masu karatu ba su karanta labarai tukuna.</p>
      )}

      <h3 class="font-bold text-base md:text-lg mb-4 pt-4 border-t border-gray-100">Recent Articles</h3>
      <div class="overflow-x-auto -mx-4 md:mx-0 px-4 md:px-0">
        <table class="w-full text-left text-sm min-w-[600px]">
          <thead class="bg-gray-50 text-gray-600 uppercase tracking-wider">
            <tr>
              <th class="p-3">Title</th>
              <th class="p-3">Pillar</th>
              <th class="p-3 hidden sm:table-cell">Type</th>
              <th class="p-3">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {recent.map((article) => {
              const pillar = String(article.pillar ?? 'news');
              const isLive = Boolean(article.isLive);
              return (
                <tr class="hover:bg-gray-50">
                  <td class="p-3 font-medium text-gray-900 truncate max-w-[200px] md:max-w-md">{titleFor(article)}</td>
                  <td class="p-3 capitalize text-xs">
                    <span class={`px-2 py-1 rounded-full font-bold ${pillarClass(pillar)}`}>
                      {pillar}
                    </span>
                  </td>
                  <td class="p-3 capitalize text-gray-500 hidden sm:table-cell">{String(article.format ?? 'Standard')}</td>
                  <td class="p-3">
                    {isLive ? (
                      <span class="flex items-center gap-1 text-red-600 font-bold text-[10px] md:text-xs">
                        <span class="w-2 h-2 bg-red-600 rounded-full animate-pulse"></span> LIVE
                      </span>
                    ) : (
                      <span class="text-green-600 font-bold text-[10px] md:text-xs uppercase tracking-tight">Published</span>
                    )}
                  </td>
                </tr>
              );
            })}
            {recent.length === 0 && (
              <tr>
                <td colspan="4" class="p-4 text-center text-gray-500">No articles found for this category.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
