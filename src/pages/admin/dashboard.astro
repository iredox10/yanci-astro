---
import AdminLayout from '../../layouts/AdminLayout.astro';
import StatCard from '../../components/admin/StatCard.astro';
import { FaArrowTrendUp, FaEye, FaFileLines } from 'react-icons/fa6';
import { getArticles, getMostRead } from '@lib/appwrite-server';

export const prerender = false;

const articles = await getArticles(200);
const mostRead = await getMostRead(5);

const liveArticles = articles.filter((a) => a.isLive);
const newsPillar = articles.filter((a) => String(a.pillar ?? 'news') === 'news');

const readById = new Map(mostRead.map((m) => [m.articleId, m.views]));
const totalViews = mostRead.reduce((sum, m) => sum + m.views, 0);
const fmt = new Intl.NumberFormat('en-GB');

const titleFor = (a: { headline?: string; ogTitle?: string }) =>
  String(a.headline ?? a.ogTitle ?? 'Untitled');
const pillarClass = (pillar: string) =>
  pillar === 'news'
    ? 'bg-red-100 text-red-800'
    : pillar === 'sport'
      ? 'bg-blue-100 text-blue-800'
      : 'bg-gray-100 text-gray-800';

const recent = [...articles]
  .sort((a, b) => String(b.$createdAt ?? '').localeCompare(String(a.$createdAt ?? '')))
  .slice(0, 5);
---

<AdminLayout title="Dashboard" active="dashboard">
  <div class="flex-1 space-y-6 p-4 md:space-y-8 md:p-8">
    <div>
      <h2 class="text-xl font-bold text-gray-800 md:text-2xl">Dashboard Overview</h2>
      <p class="text-sm text-gray-500 md:text-base">Welcome back.</p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-6 lg:grid-cols-4">
      <StatCard
        label="Total Articles"
        value={fmt.format(articles.length)}
        icon={FaFileLines}
        color="bg-blue-500"
      />
      <StatCard
        label="Live Stories"
        value={fmt.format(liveArticles.length)}
        icon={FaArrowTrendUp}
        color="bg-red-500"
      />
      <StatCard
        label="News Pillar"
        value={fmt.format(newsPillar.length)}
        icon={FaEye}
        color="bg-green-500"
      />
      <div class="relative col-span-1 flex flex-col justify-between overflow-hidden rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:col-span-2 lg:col-span-1 md:p-6">
        <div class="z-10">
          <p class="text-xs font-medium uppercase tracking-wider text-gray-500 md:text-sm">
            Page Views (tracked)
          </p>
          <h3 class="mt-1 text-2xl font-bold text-gray-900 md:text-3xl">{fmt.format(totalViews)}</h3>
          {totalViews > 0 ? (
            <span class="text-xs font-bold text-green-500">↑ Real-time data</span>
          ) : (
            <span class="text-xs font-bold text-gray-400">No views yet</span>
          )}
        </div>
        <div class="absolute -bottom-4 -right-4 z-0 h-32 w-32 rounded-full bg-green-50 blur-2xl"></div>
      </div>
    </div>

    <div class="overflow-hidden rounded-lg border border-gray-200 bg-white p-4 shadow-sm md:p-6">
      <h3 class="mb-4 text-base font-bold text-[#c70000] md:text-lg">Most Read / Trending</h3>
      {mostRead.length > 0 ? (
        <ul class="mb-6 space-y-3">
          {mostRead.map((m, idx) => {
            const article = articles.find((x) => x.$id === m.articleId);
            return (
              <li class="group flex cursor-pointer items-center gap-4 rounded-lg p-2 transition-colors hover:bg-gray-50">
                <span class="text-2xl font-black text-gray-200 transition-colors group-hover:text-[#c59d5f]">
                  {idx + 1}
                </span>
                <span class="line-clamp-1 flex-1 font-bold text-gray-800">
                  {article ? titleFor(article) : 'Deleted article'}
                </span>
                <span class="rounded-full bg-gray-100 px-2 py-1 text-xs font-bold text-gray-500">
                  {fmt.format(m.views)} views
                </span>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="mb-6 text-sm text-gray-400">
          Babu bayanan karatu tukuna. Masu karatu ba su karanta labarai tukuna.
        </p>
      )}

      <h3 class="mb-4 border-t border-gray-100 pt-4 text-base font-bold md:text-lg">
        Recent Articles
      </h3>
      <div class="-mx-4 overflow-x-auto px-4 md:mx-0 md:px-0">
        <table class="w-full min-w-[600px] text-left text-sm">
          <thead class="bg-gray-50 uppercase tracking-wider text-gray-600">
            <tr>
              <th class="p-3">Title</th>
              <th class="p-3">Pillar</th>
              <th class="hidden p-3 sm:table-cell">Type</th>
              <th class="p-3">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {recent.map((article) => {
              const pillar = String(article.pillar ?? 'news');
              const isLive = Boolean(article.isLive);
              return (
                <tr class="hover:bg-gray-50">
                  <td class="max-w-[200px] truncate p-3 font-medium text-gray-900 md:max-w-md">
                    <a href={`/admin/articles/${article.$id}`} class="hover:underline">
                      {titleFor(article)}
                    </a>
                  </td>
                  <td class="p-3 text-xs capitalize">
                    <span class:list={['rounded-full px-2 py-1 font-bold', pillarClass(pillar)]}>
                      {pillar}
                    </span>
                  </td>
                  <td class="hidden p-3 capitalize text-gray-500 sm:table-cell">
                    {String(article.format ?? 'Standard')}
                  </td>
                  <td class="p-3">
                    {isLive ? (
                      <span class="flex items-center gap-1 text-[10px] font-bold text-red-600 md:text-xs">
                        <span class="h-2 w-2 animate-pulse rounded-full bg-red-600"></span> LIVE
                      </span>
                    ) : (
                      <span class="text-[10px] font-bold uppercase tracking-tight text-green-600 md:text-xs">
                        {article.status === 'scheduled' ? 'Scheduled' : article.status === 'draft' ? 'Draft' : 'Published'}
                      </span>
                    )}
                  </td>
                </tr>
              );
            })}
            {recent.length === 0 && (
              <tr>
                <td colspan="4" class="p-4 text-center text-gray-500">
                  No articles found.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
