---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminListCollection } from '@lib/admin-collections';
import { createElement, type ComponentType } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import {
  FaChartPie,
  FaPlus,
  FaTrash,
  FaPen,
  FaCheckToSlot,
  FaCalendar,
  FaUsers,
  FaCircleCheck,
  FaClock,
  FaArrowUpRightFromSquare,
  FaEye,
  FaEyeSlash,
} from 'react-icons/fa6';

export const prerender = false;

const [electionsRaw, candidatesRaw, factChecksRaw] = await Promise.all([
  adminListCollection('elections'),
  adminListCollection('candidates'),
  adminListCollection('factchecks'),
]);

type Doc = Record<string, any>;
const elections: Doc[] = (electionsRaw as Doc[]).map((d) => ({ ...d, id: d.$id ?? d.id }));
const candidates: Doc[] = (candidatesRaw as Doc[]) as Doc[];
const factChecks: Doc[] = (factChecksRaw as Doc[]) as Doc[];

type IconCmp = ComponentType<{ className?: string }>;
const ic = (Icon: IconCmp, cls = 'w-4 h-4') =>
  renderToStaticMarkup(createElement(Icon, { className: cls }));

const STATUS_CONFIG: Record<string, { label: string; color: string; Icon: IconCmp }> = {
  upcoming: { label: 'Mai Zuwa', color: 'bg-blue-100 text-blue-700 border-blue-200', Icon: FaCalendar },
  active: { label: 'Kai Tsaye', color: 'bg-green-100 text-green-700 border-green-200', Icon: FaClock },
  completed: { label: 'An Kammala', color: 'bg-gray-100 text-gray-700 border-gray-200', Icon: FaCircleCheck },
};

function fmtDate(dateStr: string) {
  if (!dateStr) return 'Ba a saita ba';
  try {
    return new Date(dateStr).toLocaleDateString('ha-NG', { day: 'numeric', month: 'long', year: 'numeric' });
  } catch {
    return dateStr;
  }
}

const activeCount = elections.filter((e) => e.status === 'active').length;

// Prepare elections data for client script
const electionsDataJson = JSON.stringify(elections.map((e) => ({
  id: e.id,
  $id: e.$id,
  name: e.name ?? '',
  fullName: e.fullName ?? '',
  date: e.date ? String(e.date).slice(0,10) : '',
  type: e.type ?? 'general',
  status: e.status ?? 'upcoming',
  electoralBody: e.electoralBody ?? 'INEC',
  description: e.description ?? '',
  published: e.published !== false,
})));
---

<AdminLayout title="Sarrafa Zabe" active="elections">
  <div class="flex-1 flex flex-col min-w-0 overflow-y-auto p-6 md:p-8 -m-4 md:-m-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-3">
          <span set:html={ic(FaCheckToSlot, 'text-[#0f3036] w-6 h-6')} />
          Sarrafa Zabe
        </h1>
        <p class="text-sm text-gray-500 mt-1">Gudanar da zabuka, 'yan takara, sakamako, da gaskiya.</p>
      </div>
      <button
        id="btn-create-election"
        class="flex items-center gap-2 px-4 py-2.5 bg-[#0f3036] text-white rounded-lg font-bold text-sm hover:bg-[#1a454c] transition-colors cursor-pointer"
      >
        <span set:html={ic(FaPlus, 'w-4 h-4')} /> Sabon Zabe
      </button>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
      <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
        <div class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Jimlar Zabuka</div>
        <div class="text-3xl font-black">{elections.length}</div>
      </div>
      <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
        <div class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">'Yan Takara</div>
        <div class="text-3xl font-black">{candidates.length}</div>
      </div>
      <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
        <div class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Binciken Gaskiya</div>
        <div class="text-3xl font-black">{factChecks.length}</div>
      </div>
      <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
        <div class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Kai Tsaye</div>
        <div class="text-3xl font-black text-green-600">{activeCount}</div>
      </div>
    </div>

    <!-- Elections List -->
    <div class="space-y-4">
      {elections.length === 0 ? (
        <div class="bg-white rounded-xl p-12 text-center border border-gray-100">
          <span class="flex justify-center mb-4" set:html={ic(FaCheckToSlot, 'w-12 h-12 mx-auto text-gray-200')} />
          <p class="text-gray-500 font-medium">Babu zabe tukuna.</p>
          <button id="btn-empty-create" class="mt-4 text-sm text-[#0f3036] font-bold hover:underline cursor-pointer">
            + Ƙara zabe na farko
          </button>
        </div>
      ) : (
        elections.map((election) => {
          const statusConfig = (STATUS_CONFIG as any)[election.status] || STATUS_CONFIG.upcoming;
          const StatusIcon: IconCmp = statusConfig.Icon;
          const electionCandidates = candidates.filter((c) => c.electionId === election.id);
          return (
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 hover:shadow-md transition-all">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <h2 class="text-xl font-bold text-gray-900">{election.name || 'Zabe mara suna'}</h2>
                    <span class={`text-xs font-bold px-2.5 py-1 rounded-full border flex items-center gap-1 ${statusConfig.color}`}>
                      <span set:html={ic(StatusIcon, 'w-3 h-3')} /> {statusConfig.label}
                    </span>
                    {election.published === false ? (
                      <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-gray-100 text-gray-500 flex items-center gap-1">
                        <span set:html={ic(FaEyeSlash, 'w-3 h-3')} /> Boye
                      </span>
                    ) : (
                      <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-green-100 text-green-700 flex items-center gap-1">
                        <span set:html={ic(FaEye, 'w-3 h-3')} /> Auna
                      </span>
                    )}
                  </div>
                  <p class="text-sm text-gray-500 mb-4">{election.fullName || election.description || ''}</p>
                  <div class="flex flex-wrap gap-6 text-sm text-gray-600">
                    <span class="flex items-center gap-1.5">
                      <span set:html={ic(FaCalendar, 'text-gray-400 w-4 h-4')} /> {fmtDate(election.date)}
                    </span>
                    <span class="flex items-center gap-1.5">
                      <span set:html={ic(FaUsers, 'text-gray-400 w-4 h-4')} /> {electionCandidates.length} 'yan takara
                    </span>
                    <span class="flex items-center gap-1.5">
                      <span set:html={ic(FaChartPie, 'text-gray-400 w-4 h-4')} /> {election.electoralBody || 'INEC'}
                    </span>
                  </div>
                </div>
              </div>

              {/* Action Buttons */}
              <div class="flex flex-wrap gap-3 mt-5 pt-5 border-t border-gray-100">
                <a
                  href="/zabe"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 px-4 py-2 bg-purple-50 text-purple-700 rounded-lg text-sm font-bold hover:bg-purple-100 transition-colors"
                >
                  <span set:html={ic(FaArrowUpRightFromSquare, 'w-4 h-4')} /> Duba a Shafi
                </a>
                <a
                  href={`/admin/elections/${election.id}/results`}
                  class="flex items-center gap-2 px-4 py-2 bg-green-50 text-green-700 rounded-lg text-sm font-bold hover:bg-green-100 transition-colors"
                >
                  <span set:html={ic(FaChartPie, 'w-4 h-4')} /> Sakamako
                </a>
                <a
                  href={`/admin/elections/${election.id}/candidates`}
                  class="flex items-center gap-2 px-4 py-2 bg-blue-50 text-blue-700 rounded-lg text-sm font-bold hover:bg-blue-100 transition-colors"
                >
                  <span set:html={ic(FaUsers, 'w-4 h-4')} /> 'Yan Takara
                </a>
                <a
                  href={`/admin/elections/${election.id}/factchecks`}
                  class="flex items-center gap-2 px-4 py-2 bg-amber-50 text-amber-700 rounded-lg text-sm font-bold hover:bg-amber-100 transition-colors"
                >
                  <span set:html={ic(FaCheckToSlot, 'w-4 h-4')} /> Gaskiya
                </a>
                <button
                  data-edit-election={election.id}
                  class="flex items-center gap-2 px-4 py-2 bg-gray-50 text-gray-700 rounded-lg text-sm font-bold hover:bg-gray-100 transition-colors cursor-pointer"
                >
                  <span set:html={ic(FaPen, 'w-4 h-4')} /> Gyara
                </button>
                <button
                  data-delete-election={election.id}
                  class="flex items-center gap-2 px-4 py-2 bg-red-50 text-red-700 rounded-lg text-sm font-bold hover:bg-red-100 transition-colors cursor-pointer"
                >
                  <span set:html={ic(FaTrash, 'w-4 h-4')} /> Share
                </button>
              </div>
            </div>
          );
        })
      )}
    </div>

    <!-- Modal -->
    <div id="election-modal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden" aria-hidden="true">
      <div id="election-modal-panel" class="bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="p-6 border-b border-gray-100">
          <h2 id="election-modal-title" class="text-xl font-bold">Sabon Zabe</h2>
        </div>
        <form id="election-form" class="p-6 space-y-4">
          <div>
            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Sunan Zabe</label>
            <input name="name" required placeholder="Zaben Gabaɗaya 2027" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036]" />
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Cikakken Suna (Turanci)</label>
            <input name="fullName" placeholder="Nigeria General Election 2027" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036]" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Ranar Zabe</label>
              <input type="date" name="date" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036]" />
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Matsayi</label>
              <select name="status" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036]">
                <option value="upcoming">Mai Zuwa</option>
                <option value="active">Kai Tsaye</option>
                <option value="completed">An Kammala</option>
              </select>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Nau'i</label>
              <select name="type" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036]">
                <option value="general">Gabaɗaya</option>
                <option value="presidential">Shugaban Ƙasa</option>
                <option value="governor">Gwamna</option>
                <option value="by-election">Cike Gurbi</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Hukumar Zabe</label>
              <input name="electoralBody" placeholder="INEC" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036]" />
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Bayani</label>
            <textarea name="description" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0f3036]/20 focus:border-[#0f3036] resize-none"></textarea>
          </div>
          <div class="flex items-center gap-3">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="published" checked class="w-4 h-4 text-[#0f3036] border-gray-300 rounded focus:ring-[#0f3036]" />
              <span class="text-sm font-bold text-gray-700">Auna a shafin jama'a</span>
            </label>
          </div>
          <div class="flex justify-end gap-3 pt-4">
            <button type="button" id="election-modal-cancel" class="px-4 py-2 text-sm font-bold text-gray-600 hover:text-gray-800 cursor-pointer">Soke</button>
            <button type="submit" id="election-modal-submit" class="px-6 py-2 bg-[#0f3036] text-white text-sm font-bold rounded-lg hover:bg-[#1a454c] transition-colors cursor-pointer">
              Ƙirƙiri Zabe
            </button>
          </div>
          <p id="election-form-msg" class="text-xs text-red-600 font-bold hidden"></p>
        </form>
      </div>
    </div>
  </div>

  <script type="application/json" id="elections-data" set:html={electionsDataJson} />

  <script is:inline>
    (() => {
      const modal = document.getElementById('election-modal');
      const panel = document.getElementById('election-modal-panel');
      const form = document.getElementById('election-form');
      const titleEl = document.getElementById('election-modal-title');
      const submitBtn = document.getElementById('election-modal-submit');
      const msgEl = document.getElementById('election-form-msg');
      const cancelBtn = document.getElementById('election-modal-cancel');
      const createBtn = document.getElementById('btn-create-election');
      const emptyBtn = document.getElementById('btn-empty-create');
      const dataEl = document.getElementById('elections-data');
      let editingId = null;
      let electionsData = [];
      try { electionsData = JSON.parse(dataEl.textContent || '[]'); } catch {}

      function showMsg(t){ if(!msgEl) return; msgEl.textContent=t; msgEl.classList.remove('hidden'); }
      function hideMsg(){ if(msgEl){ msgEl.textContent=''; msgEl.classList.add('hidden'); } }

      function openCreate(){
        editingId = null;
        if(titleEl) titleEl.textContent = 'Sabon Zabe';
        if(submitBtn) submitBtn.textContent = 'Ƙirƙiri Zabe';
        form.reset();
        const pub = form.elements.namedItem('published');
        if(pub) pub.checked = true;
        const status = form.elements.namedItem('status');
        if(status) status.value = 'upcoming';
        const typ = form.elements.namedItem('type');
        if(typ) typ.value = 'general';
        const eb = form.elements.namedItem('electoralBody');
        if(eb) eb.value = 'INEC';
        hideMsg();
        modal.classList.remove('hidden');
        document.body.style.overflow='hidden';
      }

      function openEdit(id){
        const election = electionsData.find(e=>e.id===id || e.$id===id);
        if(!election) return;
        editingId = election.id || election.$id;
        if(titleEl) titleEl.textContent = 'Gyara Zabe';
        if(submitBtn) submitBtn.textContent = 'Ajiye Canje-canje';
        hideMsg();
        const fields = ['name','fullName','date','type','status','electoralBody','description'];
        for(const k of fields){
          const el = form.elements.namedItem(k);
          if(el) el.value = election[k] ?? '';
        }
        const pub = form.elements.namedItem('published');
        if(pub) pub.checked = election.published !== false;
        modal.classList.remove('hidden');
        document.body.style.overflow='hidden';
      }

      function closeModal(){
        modal.classList.add('hidden');
        document.body.style.overflow='';
        editingId=null;
        hideMsg();
      }

      createBtn && createBtn.addEventListener('click', openCreate);
      emptyBtn && emptyBtn.addEventListener('click', openCreate);
      cancelBtn && cancelBtn.addEventListener('click', closeModal);
      modal && modal.addEventListener('click', (e)=>{ if(e.target===modal) closeModal(); });
      panel && panel.addEventListener('click', (e)=> e.stopPropagation());

      document.querySelectorAll('[data-edit-election]').forEach(btn=>{
        btn.addEventListener('click', ()=> openEdit(btn.getAttribute('data-edit-election')));
      });

      document.querySelectorAll('[data-delete-election]').forEach(btn=>{
        btn.addEventListener('click', async ()=>{
          const id = btn.getAttribute('data-delete-election');
          if(!confirm('Ka tabbata kana son share wannan zabe?')) return;
          btn.disabled = true;
          try{
            const res = await fetch(`/api/admin/elections/${id}`, { method:'DELETE' });
            const data = await res.json().catch(()=>({}));
            if(!res.ok) throw new Error(data.message||'Delete failed');
            window.location.reload();
          }catch(err){
            alert(err.message||'Delete failed');
            btn.disabled=false;
          }
        });
      });

      form && form.addEventListener('submit', async (e)=>{
        e.preventDefault();
        hideMsg();
        const fd = new FormData(form);
        const data = {
          name: String(fd.get('name')||''),
          fullName: String(fd.get('fullName')||''),
          date: String(fd.get('date')||''),
          type: String(fd.get('type')||'general'),
          status: String(fd.get('status')||'upcoming'),
          electoralBody: String(fd.get('electoralBody')||'INEC'),
          description: String(fd.get('description')||''),
          published: Boolean(form.elements.namedItem('published')?.checked),
        };
        if(!data.name || !data.date){ showMsg('Sunan Zabe da Ranar Zabe suna da mahimmanci.'); return; }
        submitBtn.disabled = true;
        submitBtn.textContent = 'Ana ajiyewa...';
        try{
          const url = `/api/admin/elections/${editingId || 'new'}`;
          const method = editingId ? 'PUT' : 'POST';
          const res = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(data)});
          const json = await res.json().catch(()=>({}));
          if(!res.ok) throw new Error(json.message||'Save failed');
          window.location.reload();
        }catch(err){
          showMsg(err.message||'Save failed');
          submitBtn.disabled=false;
          submitBtn.textContent = editingId ? 'Ajiye Canje-canje' : 'Ƙirƙiri Zabe';
        }
      });

      document.addEventListener('keydown', (e)=>{ if(e.key==='Escape' && modal && !modal.classList.contains('hidden')) closeModal(); });
    })();
  </script>
</AdminLayout>
