---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminCrud from '../../components/admin/AdminCrud.astro';
import { adminListCollection } from '@lib/admin-collections';

export const prerender = false;

const [elections, candidates, results] = await Promise.all([
  adminListCollection('elections'),
  adminListCollection('candidates'),
  adminListCollection('results'),
]);
---

<AdminLayout title="Elections" active="elections">
  <div class="mb-6">
    <h1 class="font-serif text-2xl font-bold text-yanci-primary">Elections hub</h1>
    <p class="mt-1 max-w-2xl text-sm text-yanci-primary/60">
      Manage elections, candidates and state-by-state results. Candidates and results are linked to an election via its ID
      (e.g. <code class="rounded bg-yanci-primary/10 px-1 font-mono text-xs">election-2027</code>).
    </p>
  </div>

  <div class="mb-6 flex flex-wrap gap-1">
    <button data-tab="tab-elections" class="tab-btn bg-yanci-primary px-4 py-2 text-sm font-bold text-yanci-paper">Elections ({elections.length})</button>
    <button data-tab="tab-candidates" class="tab-btn px-4 py-2 text-sm font-medium text-yanci-primary/70 hover:bg-yanci-primary/10">Candidates ({candidates.length})</button>
    <button data-tab="tab-results" class="tab-btn px-4 py-2 text-sm font-medium text-yanci-primary/70 hover:bg-yanci-primary/10">Results ({results.length})</button>
  </div>

  <div id="tab-elections" class="tab-panel">
    <AdminCrud
      collection="elections"
      title="Elections"
      docs={elections}
      fields={[
        { key: 'name', label: 'Name', placeholder: 'Zaben Gabaɗaya 2027' },
        { key: 'fullName', label: 'Full name', placeholder: 'Nigeria General Election 2027' },
        { key: 'date', label: 'Date', placeholder: '2027-02-06' },
        { key: 'type', label: 'Type', options: ['general', 'governorship', 'local', 'referendum'], type: 'select' },
        { key: 'status', label: 'Status', options: ['upcoming', 'active', 'completed'], type: 'select' },
        { key: 'electoralBody', label: 'Electoral body', placeholder: 'INEC' },
        { key: 'description', label: 'Description', type: 'textarea' },
        { key: 'image', label: 'Image URL', placeholder: 'https://…' },
        { key: 'published', label: 'Published', type: 'checkbox' },
      ]}
    />
  </div>

  <div id="tab-candidates" class="tab-panel hidden">
    <AdminCrud
      collection="candidates"
      title="Candidates"
      docs={candidates}
      fields={[
        { key: 'electionId', label: 'Election ID', placeholder: 'election-2027' },
        { key: 'name', label: 'Name', placeholder: 'Ahmadu Bello Musa' },
        { key: 'party', label: 'Party', options: ['apc', 'pdp', 'nnpp', 'lpp', 'apga', 'independent'], type: 'select' },
        { key: 'position', label: 'Position', options: ['president', 'governor', 'senator', 'house'], type: 'select' },
        { key: 'state', label: 'State', placeholder: 'Kaduna' },
        { key: 'runningMate', label: 'Running mate', placeholder: 'Fatima Abdullahi' },
        { key: 'previousOffice', label: 'Previous office', placeholder: 'Gwamnan Kaduna' },
        { key: 'education', label: 'Education', type: 'textarea', placeholder: 'PhD Economics, ABU Zaria' },
        { key: 'platform', label: 'Platform', type: 'textarea', placeholder: 'One promise per line' },
        { key: 'image', label: 'Image URL', placeholder: 'https://…' },
        { key: 'order', label: 'Order', type: 'number' },
      ]}
    />
  </div>

  <div id="tab-results" class="tab-panel hidden">
    <AdminCrud
      collection="results"
      title="Results by state"
      docs={results}
      fields={[
        { key: 'electionId', label: 'Election ID', placeholder: 'election-2027' },
        { key: 'state', label: 'State', placeholder: 'Kaduna' },
        { key: 'region', label: 'Region', options: ['North West', 'North East', 'North Central', 'South West', 'South East', 'South South', 'FCT'], type: 'select' },
        { key: 'candidateVotes', label: 'Votes per candidate', type: 'json', placeholder: '{"c1": 147224, "c2": 478478}' },
        { key: 'met25Threshold', label: 'Met 25% threshold', type: 'json', placeholder: '["c2","c3"]' },
        { key: 'winner', label: 'Winner candidate', placeholder: 'c2' },
        { key: 'governor', label: 'Governor party', placeholder: 'apc' },
        { key: 'senate', label: 'Senate', type: 'json', placeholder: '{"apc": 1}' },
        { key: 'registeredVoters', label: 'Registered voters', type: 'number' },
        { key: 'accreditedVoters', label: 'Accredited voters', type: 'number' },
        { key: 'validVotes', label: 'Valid votes', type: 'number' },
        { key: 'rejectedVotes', label: 'Rejected votes', type: 'number' },
      ]}
    />
  </div>
</AdminLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach((b) => {
        b.className = 'tab-btn px-4 py-2 text-sm font-medium text-yanci-primary/70 hover:bg-yanci-primary/10';
      });
      document.querySelectorAll('.tab-panel').forEach((p) => p.classList.add('hidden'));
      btn.className = 'tab-btn bg-yanci-primary px-4 py-2 text-sm font-bold text-yanci-paper';
      document.getElementById(btn.dataset.tab!)?.classList.remove('hidden');
    });
  });
</script>
