---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getArticles } from '@lib/appwrite-server';
import { adminListCollection } from '@lib/admin-collections';

export const prerender = false;

const [views, articles] = await Promise.all([
  adminListCollection('views', 5000),
  getArticles(500),
]);

const titleFor = (a: { headline?: string; ogTitle?: string }) => String(a.headline ?? a.ogTitle ?? 'Untitled');

const byArticle = new Map<string, number>();
const bySection = new Map<string, number>();
const byDevice = new Map<string, number>();
const byDay = new Map<string, number>();

for (const v of views) {
  const articleId = String(v.article_id ?? '');
  if (articleId) byArticle.set(articleId, (byArticle.get(articleId) ?? 0) + 1);
  const section = String(v.section ?? 'unknown');
  bySection.set(section, (bySection.get(section) ?? 0) + 1);
  const device = String(v.device ?? 'unknown');
  byDevice.set(device, (byDevice.get(device) ?? 0) + 1);
  const d = (v as any).viewed_at ?? v.$createdAt ?? '';
  if (d) byDay.set(String(d).slice(0, 10), (byDay.get(String(d).slice(0, 10)) ?? 0) + 1);
}

const topArticles = [...byArticle.entries()].sort((a, b) => b[1] - a[1]).slice(0, 15);
const articleById = new Map(articles.map((a) => [a.$id, a]));
const fmt = new Intl.NumberFormat('en-GB');
const topDays = [...byDay.entries()].sort((a, b) => a[0].localeCompare(b[0])).slice(-14);
const maxDay = Math.max(1, ...topDays.map(([, n]) => n));
---

<AdminLayout title="Analytics" active="analytics">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="font-serif text-2xl font-bold text-yanci-primary">Analytics</h1>
      <p class="mt-1 text-sm text-yanci-primary/60">From the views collection. Sample is capped at 5,000 recent rows.</p>
    </div>
    <p class="text-sm font-semibold text-yanci-primary">{fmt.format(views.length)} page views tracked</p>
  </div>

  <section class="mt-6 grid gap-4 sm:grid-cols-3">
    <div class="border border-yanci-primary/15 bg-white/60 p-5">
      <h2 class="border-b border-yanci-primary/20 pb-2 font-serif text-lg font-bold text-yanci-primary">By section</h2>
      <ul class="mt-3 space-y-2">
        {[...bySection.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8).map(([section, count]) => (
          <li class="flex items-center justify-between text-sm">
            <span class="capitalize text-yanci-dark/80">{section || 'unknown'}</span>
            <span class="font-semibold text-yanci-primary">{fmt.format(count)}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="border border-yanci-primary/15 bg-white/60 p-5">
      <h2 class="border-b border-yanci-primary/20 pb-2 font-serif text-lg font-bold text-yanci-primary">By device</h2>
      <ul class="mt-3 space-y-2">
        {[...byDevice.entries()].sort((a, b) => b[1] - a[1]).map(([device, count]) => (
          <li class="flex items-center justify-between text-sm">
            <span class="capitalize text-yanci-dark/80">{device || 'unknown'}</span>
            <span class="font-semibold text-yanci-primary">{fmt.format(count)}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="border border-yanci-primary/15 bg-white/60 p-5">
      <h2 class="border-b border-yanci-primary/20 pb-2 font-serif text-lg font-bold text-yanci-primary">Last 14 days</h2>
      <div class="mt-4 flex h-36 items-end gap-1">
        {topDays.map(([day, count]) => (
          <div class="group relative flex-1" title={`${day}: ${fmt.format(count)}`}>
            <div class="w-full bg-yanci-accent/70 transition-colors group-hover:bg-yanci-accent" style={`height:${Math.max(4, Math.round((count / maxDay) * 100))}%`}></div>
          </div>
        ))}
      </div>
      <p class="mt-2 text-right text-xs text-yanci-primary/50">Views per day</p>
    </div>
  </section>

  <section class="mt-8">
    <h2 class="border-b border-yanci-primary/20 pb-2 font-serif text-lg font-bold text-yanci-primary">Top articles</h2>
    <ul class="mt-3 divide-y divide-yanci-primary/10">
      {topArticles.length === 0 && <li class="py-4 text-sm text-yanci-primary/50">No view data yet.</li>}
      {topArticles.map(([id, count], i) => {
        const article = articleById.get(id);
        return (
          <li class="flex items-center gap-4 py-2.5 text-sm">
            <span class="w-5 font-serif font-bold text-yanci-accent">{i + 1}</span>
            <a href={article ? `/admin/articles/${article.$id}` : '#'} class="flex-1 truncate font-medium text-yanci-dark/85 hover:text-yanci-primary">
              {article ? titleFor(article) : 'Deleted article'}
            </a>
            <span class="text-xs text-yanci-primary/50">{fmt.format(count)} views</span>
          </li>
        );
      })}
    </ul>
  </section>
</AdminLayout>
