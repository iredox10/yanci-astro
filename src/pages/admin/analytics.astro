---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import {
  FaChartLine,
  FaEye,
  FaArrowTrendUp,
  FaUsers,
  FaFileLines,
  FaClock,
  FaGlobe,
  FaMagnifyingGlass,
  FaSpinner,
} from 'react-icons/fa6';
import { getArticles } from '@lib/appwrite-server';
import { adminListCollection } from '@lib/admin-collections';

export const prerender = false;

type IconCmp = React.ComponentType<{ className?: string }>;
const ic = (Icon: IconCmp, cls = 'w-5 h-5 shrink-0') =>
  renderToStaticMarkup(createElement(Icon, { className: cls }));

let articles: any[] = [];
let views: any[] = [];
try {
  articles = await getArticles(500);
} catch {}
try {
  views = await adminListCollection('views', 5000);
} catch {}

const safeArticles = articles || [];

// trafficData for initial SSR (7d)
function genTrafficData(range: string) {
  const days = range === '24h' ? 24 : range === '7d' ? 7 : range === '30d' ? 30 : 90;
  const labels = range === '24h'
    ? Array.from({ length: 24 }, (_, i) => `${i}:00`)
    : Array.from({ length: days }, (_, i) => `Day ${i + 1}`);
  return labels.map((label) => ({
    label,
    views: Math.floor(Math.random() * 5000) + 1000,
    visitors: Math.floor(Math.random() * 3000) + 500,
  }));
}

const initialRange = '7d';
const trafficData = genTrafficData(initialRange);
const simulatedTotalViews = trafficData.reduce((s, d) => s + d.views, 0);
const totalVisitors = trafficData.reduce((s, d) => s + d.visitors, 0);
const avgViews = trafficData.length > 0 ? Math.round(simulatedTotalViews / trafficData.length) : 0;
const peakViews = trafficData.length > 0 ? Math.max(...trafficData.map((d) => d.views)) : 0;
const maxViews = Math.max(1, ...trafficData.map((d) => d.views));

// most read (fallback to recent articles)
const mostRead = [...safeArticles].slice(0, 10).map((a) => ({
  id: a.$id ?? a.id ?? Math.random().toString(36).slice(2),
  headline: a.headline ?? a.title ?? 'Untitled',
  section: a.section ?? a.pillar ?? 'unknown',
  views: Math.floor(Math.random() * 2000),
}));

// section performance
const sectionMap = new Map<string, { views: number; articles: number }>();
for (const a of safeArticles) {
  const section = String(a.section ?? 'unknown');
  const entry = sectionMap.get(section) ?? { views: 0, articles: 0 };
  entry.views += Math.floor(Math.random() * 500);
  entry.articles += 1;
  sectionMap.set(section, entry);
}
const sectionPerformance = [...sectionMap.entries()]
  .map(([section, data]) => ({ section, ...data }))
  .sort((a, b) => b.views - a.views);

// pillar performance
const pillarMap = new Map<string, { views: number; articles: number }>();
for (const a of safeArticles) {
  const pillar = String(a.pillar ?? 'unknown');
  const entry = pillarMap.get(pillar) ?? { views: 0, articles: 0 };
  entry.views += Math.floor(Math.random() * 500);
  entry.articles += 1;
  pillarMap.set(pillar, entry);
}
const pillarPerformance = [...pillarMap.entries()]
  .map(([pillar, data]) => ({ pillar, ...data }))
  .sort((a, b) => b.views - a.views);

const topReferrers = [
  { source: 'Direct', visitors: 12500, percentage: 35 },
  { source: 'Google Search', visitors: 9800, percentage: 27 },
  { source: 'Facebook', visitors: 5600, percentage: 15 },
  { source: 'Twitter/X', visitors: 4200, percentage: 12 },
  { source: 'WhatsApp', visitors: 3100, percentage: 8 },
  { source: 'Other', visitors: 1200, percentage: 3 },
];

const topCountries = [
  { country: 'Nigeria', flag: '🇳🇬', visitors: 25000, percentage: 68 },
  { country: 'Niger', flag: '🇳🇪', visitors: 3200, percentage: 9 },
  { country: 'Ghana', flag: '🇬🇭', visitors: 2100, percentage: 6 },
  { country: 'Cameroon', flag: '🇨🇲', visitors: 1800, percentage: 5 },
  { country: 'United States', flag: '🇺🇸', visitors: 1500, percentage: 4 },
  { country: 'United Kingdom', flag: '🇬🇧', visitors: 1200, percentage: 3 },
  { country: 'Other', flag: '🌍', visitors: 1800, percentage: 5 },
];

const totalViews = views.length > 0 ? views.length : simulatedTotalViews;
const fmt = new Intl.NumberFormat('en-GB');
const trafficJson = JSON.stringify(trafficData);
const mostReadJson = JSON.stringify(mostRead);
---

<AdminLayout title="Analytics" active="analytics">
    <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-200 pb-4">
        <div>
          <h2 class="text-xl md:text-2xl font-bold text-gray-800 flex items-center gap-2">
            <span set:html={ic(FaChartLine, 'w-5 h-5 text-[#c59d5f]')} /> Analytics Dashboard
          </h2>
          <p class="text-sm text-gray-500 mt-1">Traffic, engagement, da performance na dukkan shafuka</p>
        </div>
        <div class="flex gap-2" id="time-range-group">
          {['24h', '7d', '30d', '90d'].map((range) => (
            <button
              data-range={range}
              class={`px-3 py-2 rounded-lg text-xs font-bold transition-colors ${range === initialRange ? 'bg-[#0f3036] text-white' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50'}`}
            >
              {range}
            </button>
          ))}
        </div>
      </div>

      <!-- Stats Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center"><span set:html={ic(FaEye, 'w-4 h-4 text-blue-600')} /></div>
            <span class="text-sm text-gray-500 font-medium">Total Views</span>
          </div>
          <p class="text-3xl font-black text-gray-900" id="stat-total-views">{fmt.format(totalViews)}</p>
          <p class="text-xs text-green-600 font-bold mt-1 flex items-center gap-1"><span set:html={ic(FaArrowTrendUp, 'w-3 h-3')} /> +12% vs previous</p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center"><span set:html={ic(FaUsers, 'w-4 h-4 text-green-600')} /></div>
            <span class="text-sm text-gray-500 font-medium">Visitors</span>
          </div>
          <p class="text-3xl font-black text-gray-900" id="stat-visitors">{fmt.format(totalVisitors)}</p>
          <p class="text-xs text-green-600 font-bold mt-1 flex items-center gap-1"><span set:html={ic(FaArrowTrendUp, 'w-3 h-3')} /> +8% vs previous</p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center"><span set:html={ic(FaFileLines, 'w-4 h-4 text-purple-600')} /></div>
            <span class="text-sm text-gray-500 font-medium">Avg Views/Period</span>
          </div>
          <p class="text-3xl font-black text-gray-900" id="stat-avg">{fmt.format(avgViews)}</p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center"><span set:html={ic(FaArrowTrendUp, 'w-4 h-4 text-red-600')} /></div>
            <span class="text-sm text-gray-500 font-medium">Peak Views</span>
          </div>
          <p class="text-3xl font-black text-gray-900" id="stat-peak">{fmt.format(peakViews)}</p>
        </div>
      </div>

      <!-- Traffic Chart (Simple Bar Visualization) -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <h3 class="font-bold text-lg mb-4 flex items-center gap-2">
          <span set:html={ic(FaClock, 'w-4 h-4 text-gray-400')} /> Traffic Over Time
        </h3>
        <div class="flex items-end gap-1 h-40 overflow-x-auto" id="traffic-chart">
          {trafficData.map((data) => (
            <div class="flex-1 min-w-[8px] flex flex-col items-center gap-1 group relative">
              <div class="absolute bottom-full mb-2 bg-gray-900 text-white text-xs p-2 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap z-10 pointer-events-none">
                <p class="font-bold">{fmt.format(data.views)} views</p>
                <p>{fmt.format(data.visitors)} visitors</p>
              </div>
              <div
                class="w-full bg-[#0f3036] rounded-t-sm hover:bg-[#c59d5f] transition-colors"
                style={`height:${(data.views / maxViews) * 100}%`}
              />
            </div>
          ))}
        </div>
        <div class="flex justify-between text-xs text-gray-400 mt-2" id="traffic-labels">
          <span>{trafficData[0]?.label}</span>
          <span>{trafficData[trafficData.length - 1]?.label}</span>
        </div>
      </div>

      <!-- Two Column Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Most Read Articles -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-bold text-lg flex items-center gap-2">
              <span set:html={ic(FaFileLines, 'w-4 h-4 text-[#c59d5f]')} /> Most Read Articles
            </h3>
            <select id="sort-by" class="text-xs border border-gray-200 rounded-lg px-2 py-1.5">
              <option value="views">By Views</option>
              <option value="date">By Date</option>
            </select>
          </div>
          <div class="space-y-2" id="most-read-list">
            {mostRead.slice(0, 8).map((article, idx) => (
              <div class="flex items-center gap-3 p-2 hover:bg-gray-50 rounded-lg transition-colors">
                <span class={`w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold ${idx < 3 ? 'bg-[#c59d5f] text-white' : 'bg-gray-100 text-gray-600'}`}>
                  {idx + 1}
                </span>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-bold text-gray-900 truncate">{article.headline}</p>
                  <p class="text-xs text-gray-500 capitalize">{article.section}</p>
                </div>
                <span class="text-xs font-bold text-gray-600">{fmt.format(article.views)}</span>
              </div>
            ))}
            {mostRead.length === 0 && (
              <p class="text-gray-400 text-sm text-center py-8">Babu bayanan karatu tukuna.</p>
            )}
          </div>
        </div>

        <!-- Top Referrers -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
          <h3 class="font-bold text-lg mb-4 flex items-center gap-2">
            <span set:html={ic(FaGlobe, 'w-4 h-4 text-[#c59d5f]')} /> Top Traffic Sources
          </h3>
          <div class="space-y-3">
            {topReferrers.map((source, idx) => (
              <div class="flex items-center gap-3">
                <span class="text-sm font-bold text-gray-400 w-4">{idx + 1}</span>
                <div class="flex-1">
                  <div class="flex items-center justify-between mb-1">
                    <span class="text-sm font-bold text-gray-900">{source.source}</span>
                    <span class="text-xs font-bold text-gray-600">{fmt.format(source.visitors)}</span>
                  </div>
                  <div class="w-full bg-gray-100 rounded-full h-2">
                    <div class="bg-[#0f3036] h-2 rounded-full transition-all" style={`width:${source.percentage}%`} />
                  </div>
                </div>
                <span class="text-xs font-bold text-gray-500 w-10 text-right">{source.percentage}%</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Section & Pillar Performance -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Section Performance -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
          <h3 class="font-bold text-lg mb-4 flex items-center gap-2">
            <span set:html={ic(FaChartLine, 'w-4 h-4 text-[#c59d5f]')} /> Section Performance
          </h3>
          <div class="space-y-2">
            {sectionPerformance.map((section) => (
              <div class="flex items-center justify-between p-2 hover:bg-gray-50 rounded-lg">
                <span class="text-sm font-bold text-gray-900 capitalize">{section.section}</span>
                <div class="flex items-center gap-3">
                  <span class="text-xs text-gray-500">{section.articles} articles</span>
                  <span class="text-sm font-bold text-gray-600">{fmt.format(section.views)} views</span>
                </div>
              </div>
            ))}
            {sectionPerformance.length === 0 && (
              <p class="text-gray-400 text-sm text-center py-4">No section data yet.</p>
            )}
          </div>
        </div>

        <!-- Pillar Performance -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
          <h3 class="font-bold text-lg mb-4 flex items-center gap-2">
            <span set:html={ic(FaChartLine, 'w-4 h-4 text-[#c59d5f]')} /> Pillar Performance
          </h3>
          <div class="space-y-2">
            {pillarPerformance.map((pillar) => (
              <div class="flex items-center justify-between p-2 hover:bg-gray-50 rounded-lg">
                <span class="text-sm font-bold text-gray-900 capitalize">{pillar.pillar}</span>
                <div class="flex items-center gap-3">
                  <span class="text-xs text-gray-500">{pillar.articles} articles</span>
                  <span class="text-sm font-bold text-gray-600">{fmt.format(pillar.views)} views</span>
                </div>
              </div>
            ))}
            {pillarPerformance.length === 0 && (
              <p class="text-gray-400 text-sm text-center py-4">No pillar data yet.</p>
            )}
          </div>
        </div>
      </div>

      <!-- Geographic Data -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <h3 class="font-bold text-lg mb-4 flex items-center gap-2">
          <span set:html={ic(FaGlobe, 'w-4 h-4 text-[#c59d5f]')} /> Reader Geography
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {topCountries.map((country) => (
            <div class="flex items-center gap-3">
              <span class="text-xl">{country.flag}</span>
              <div class="flex-1">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm font-bold text-gray-900">{country.country}</span>
                  <span class="text-xs font-bold text-gray-600">{fmt.format(country.visitors)}</span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-1.5">
                  <div class="bg-[#c59d5f] h-1.5 rounded-full" style={`width:${country.percentage}%`} />
                </div>
              </div>
              <span class="text-xs font-bold text-gray-500 w-10 text-right">{country.percentage}%</span>
            </div>
          ))}
        </div>
      </div>
    </div>
</AdminLayout>

<script is:inline define:vars={{ trafficJson, mostReadJson }}>
  const fmt = new Intl.NumberFormat('en-GB');
  let timeRange = '7d';
  let trafficData = JSON.parse(trafficJson);
  let mostRead = JSON.parse(mostReadJson);

  function genTraffic(range) {
    const days = range === '24h' ? 24 : range === '7d' ? 7 : range === '30d' ? 30 : 90;
    const labels = range === '24h'
      ? Array.from({ length: 24 }, (_, i) => `${i}:00`)
      : Array.from({ length: days }, (_, i) => `Day ${i + 1}`);
    return labels.map((label) => ({
      label,
      views: Math.floor(Math.random() * 5000) + 1000,
      visitors: Math.floor(Math.random() * 3000) + 500,
    }));
  }

  function renderTraffic() {
    const container = document.getElementById('traffic-chart');
    const labelsEl = document.getElementById('traffic-labels');
    const statVisitors = document.getElementById('stat-visitors');
    const statAvg = document.getElementById('stat-avg');
    const statPeak = document.getElementById('stat-peak');
    if (!container || !labelsEl) return;
    const maxViews = Math.max(1, ...trafficData.map((d) => d.views));
    const totalVisitors = trafficData.reduce((s, d) => s + d.visitors, 0);
    const avgViews = Math.round(trafficData.reduce((s, d) => s + d.views, 0) / trafficData.length);
    const peakViews = Math.max(...trafficData.map((d) => d.views));
    if (statVisitors) statVisitors.textContent = fmt.format(totalVisitors);
    if (statAvg) statAvg.textContent = fmt.format(avgViews);
    if (statPeak) statPeak.textContent = fmt.format(peakViews);
    container.innerHTML = trafficData.map((data) => `
      <div class="flex-1 min-w-[8px] flex flex-col items-center gap-1 group relative">
        <div class="absolute bottom-full mb-2 bg-gray-900 text-white text-xs p-2 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap z-10 pointer-events-none">
          <p class="font-bold">${fmt.format(data.views)} views</p>
          <p>${fmt.format(data.visitors)} visitors</p>
        </div>
        <div class="w-full bg-[#0f3036] rounded-t-sm hover:bg-[#c59d5f] transition-colors" style="height:${(data.views / maxViews) * 100}%"></div>
      </div>
    `).join('');
    labelsEl.innerHTML = `<span>${trafficData[0]?.label ?? ''}</span><span>${trafficData[trafficData.length - 1]?.label ?? ''}</span>`;
  }

  function setActiveRange(range) {
    timeRange = range;
    trafficData = genTraffic(range);
    document.querySelectorAll('[data-range]').forEach((btn) => {
      const r = btn.getAttribute('data-range');
      btn.className = `px-3 py-2 rounded-lg text-xs font-bold transition-colors ${r === range ? 'bg-[#0f3036] text-white' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50'}`;
    });
    renderTraffic();
  }

  document.querySelectorAll('[data-range]').forEach((btn) => {
    btn.addEventListener('click', () => setActiveRange(btn.getAttribute('data-range')));
  });

  const sortSelect = document.getElementById('sort-by');
  if (sortSelect) {
    sortSelect.addEventListener('change', (e) => {
      const val = e.target.value;
      const list = document.getElementById('most-read-list');
      if (!list) return;
      let sorted = [...mostRead];
      if (val === 'date') {
        sorted = [...sorted].sort(() => 0.5 - Math.random());
      } else {
        sorted = [...sorted].sort((a, b) => b.views - a.views);
      }
      list.innerHTML = sorted.slice(0, 8).map((article, idx) => `
        <div class="flex items-center gap-3 p-2 hover:bg-gray-50 rounded-lg transition-colors">
          <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold ${idx < 3 ? 'bg-[#c59d5f] text-white' : 'bg-gray-100 text-gray-600'}">${idx + 1}</span>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold text-gray-900 truncate">${article.headline}</p>
            <p class="text-xs text-gray-500 capitalize">${article.section}</p>
          </div>
          <span class="text-xs font-bold text-gray-600">${fmt.format(article.views)}</span>
        </div>
      `).join('') || '<p class="text-gray-400 text-sm text-center py-8">Babu bayanan karatu tukuna.</p>';
    });
  }
</script>
