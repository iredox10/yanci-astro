---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import {
  FaMagnifyingGlassChart,
  FaSpinner,
  FaPlus,
  FaArrowRight,
  FaWandMagicSparkles,
  FaFire,
} from 'react-icons/fa6';
import { getArticles } from '@lib/appwrite-server';

export const prerender = false;

type IconCmp = React.ComponentType<{ className?: string }>;
const ic = (Icon: IconCmp, cls = 'w-5 h-5 shrink-0') =>
  renderToStaticMarkup(createElement(Icon, { className: cls }));

let articles: any[] = [];
try {
  articles = await getArticles(500);
} catch {}
const articlesJson = JSON.stringify(articles || []);
---

<AdminLayout title="Content Gap" active="content-gap">
    <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-200 pb-4">
        <div>
          <h2 class="text-xl md:text-2xl font-bold text-gray-800 flex items-center gap-2">
            <span set:html={ic(FaMagnifyingGlassChart, 'w-5 h-5 text-[#c59d5f]')} /> Content Gap Analyzer
          </h2>
          <p class="text-sm text-gray-500 mt-1">Find topics your competitors cover but you don't</p>
        </div>
      </div>

      <!-- Controls -->
      <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
        <h3 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2">
          <span set:html={ic(FaWandMagicSparkles, 'w-4 h-4 text-[#c59d5f]')} /> Analyze Gaps
        </h3>
        <div class="mb-4">
          <label class="text-xs font-bold text-gray-500 mb-1 block">Competitor Topics (optional, comma-separated)</label>
          <input
            id="competitor-topics"
            type="text"
            placeholder="e.g., election results, fuel subsidy, AFCON 2026"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#c59d5f] text-sm"
          />
        </div>
        <button
          id="find-gaps"
          type="button"
          class="bg-[#0f3036] text-white px-6 py-2.5 rounded-lg font-bold text-sm hover:bg-[#1a454c] disabled:opacity-50 flex items-center gap-2"
        >
          <span id="gap-icon" set:html={ic(FaMagnifyingGlassChart, 'w-4 h-4')} />
          <span id="gap-label">Find Content Gaps</span>
        </button>
      </div>

      <!-- Results -->
      <div id="gaps-results" class="space-y-6 hidden"></div>

      <div id="gaps-empty" class="text-center py-16">
        <div class="w-12 h-12 text-gray-200 mx-auto mb-3 flex items-center justify-center"><span set:html={ic(FaMagnifyingGlassChart, 'w-12 h-12 text-gray-200')} /></div>
        <p class="text-sm text-gray-400">Click "Find Content Gaps" to discover topics you should be covering.</p>
      </div>
    </div>
</AdminLayout>

<script is:inline define:vars={{ articlesJson }}>
  const articles = JSON.parse(articlesJson);
  const btn = document.getElementById('find-gaps');
  const iconEl = document.getElementById('gap-icon');
  const labelEl = document.getElementById('gap-label');
  const input = document.getElementById('competitor-topics');
  const results = document.getElementById('gaps-results');
  const empty = document.getElementById('gaps-empty');

  let analyzing = false;
  const spinnerSvg = '<svg class="animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25"/><path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="4" class="opacity-75"/></svg>';
  const gapSvg = '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>';

  function setAnalyzing(v) {
    analyzing = v;
    if (!btn || !iconEl || !labelEl) return;
    btn.disabled = v;
    iconEl.innerHTML = v ? spinnerSvg : gapSvg;
    labelEl.textContent = v ? 'Analyzing...' : 'Find Content Gaps';
  }

  function escapeHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function renderGaps(gaps) {
    if (!results) return;
    const high = gaps.high_priority || [];
    const medium = gaps.medium_priority || [];
    const trending = gaps.trending_opportunities || [];

    const highHtml = high.length ? `
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-gray-100 bg-red-50 flex items-center gap-2">
          <svg class="w-4 h-4 text-red-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17 5.8 21.3l2.4-7.4L2 9.4h7.6z"/></svg>
          <h3 class="text-sm font-bold text-red-700">High Priority Gaps (${high.length})</h3>
        </div>
        <div class="divide-y divide-gray-100">
          ${high.map((gap) => `
            <div class="p-4 hover:bg-gray-50">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <p class="text-sm font-bold text-gray-900 mb-1">${escapeHtml(gap.topic)}</p>
                  <p class="text-xs text-gray-500 mb-2">${escapeHtml(gap.reason || '')}</p>
                  ${gap.suggested_angles && gap.suggested_angles.length ? `<div class="space-y-1">${gap.suggested_angles.map((angle) => `<div class="flex items-center gap-2 text-xs text-gray-600"><svg class="w-2.5 h-2.5 text-[#c59d5f] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>${escapeHtml(angle)}</div>`).join('')}</div>` : ''}
                </div>
                <span class="text-xs font-bold text-red-500 bg-red-50 px-2 py-1 rounded-full shrink-0">High</span>
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    ` : '';

    const mediumHtml = medium.length ? `
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-gray-100 bg-amber-50 flex items-center gap-2">
          <svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17 5.8 21.3l2.4-7.4L2 9.4h7.6z"/></svg>
          <h3 class="text-sm font-bold text-amber-700">Medium Priority Gaps (${medium.length})</h3>
        </div>
        <div class="divide-y divide-gray-100">
          ${medium.map((gap) => `
            <div class="p-4 hover:bg-gray-50">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <p class="text-sm font-bold text-gray-900 mb-1">${escapeHtml(gap.topic)}</p>
                  <p class="text-xs text-gray-500 mb-2">${escapeHtml(gap.reason || '')}</p>
                  ${gap.suggested_angles && gap.suggested_angles.length ? `<div class="space-y-1">${gap.suggested_angles.map((angle) => `<div class="flex items-center gap-2 text-xs text-gray-600"><svg class="w-2.5 h-2.5 text-[#c59d5f] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>${escapeHtml(angle)}</div>`).join('')}</div>` : ''}
                </div>
                <span class="text-xs font-bold text-amber-500 bg-amber-50 px-2 py-1 rounded-full shrink-0">Medium</span>
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    ` : '';

    const trendingHtml = trending.length ? `
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-gray-100 bg-green-50 flex items-center gap-2">
          <svg class="w-4 h-4 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <h3 class="text-sm font-bold text-green-700">Trending Opportunities</h3>
        </div>
        <div class="divide-y divide-gray-100">
          ${trending.map((opp) => `
            <div class="p-4 hover:bg-gray-50">
              <p class="text-sm font-bold text-gray-900 mb-1">${escapeHtml(opp.topic)}</p>
              <p class="text-xs text-gray-500">${escapeHtml(opp.why_now || '')}</p>
            </div>
          `).join('')}
        </div>
      </div>
    ` : '';

    if (!highHtml && !mediumHtml && !trendingHtml) {
      results.innerHTML = '<div class="bg-white p-8 rounded-xl border border-gray-200 text-center"><p class="text-sm text-gray-500">No gaps found. Your coverage looks comprehensive!</p></div>';
    } else {
      results.innerHTML = highHtml + mediumHtml + trendingHtml;
    }
    results.classList.remove('hidden');
    if (empty) empty.classList.add('hidden');
  }

  async function runGapAnalysis() {
    if (analyzing) return;
    setAnalyzing(true);
    if (results) results.classList.add('hidden');
    try {
      const competitorTopics = input ? input.value : '';
      const publishedArticles = articles.filter((a) => a.status === 'published');
      const existingTopics = publishedArticles.map((a) => ({
        headline: a.headline,
        section: a.section,
        tags: a.tags,
        date: a.$createdAt,
      }));

      let result = null;
      try {
        const res = await fetch('/api/gemini/content-gap', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ existingTopics, competitorTopics }),
        });
        if (res.ok) result = await res.json();
      } catch {}

      if (!result || result.error) {
        // fallback mock
        const topics = competitorTopics ? competitorTopics.split(',').map((t) => t.trim()).filter(Boolean) : ['fuel subsidy', 'AFCON 2026', 'election results'];
        result = {
          high_priority: topics.slice(0, 2).map((topic) => ({
            topic,
            reason: 'High search volume but low coverage on your site',
            suggested_angles: ['Explainer: What it means', 'Live updates and reactions', 'Impact on local communities'],
          })),
          medium_priority: topics.slice(2, 3).map((topic) => ({
            topic,
            reason: 'Emerging topic with growing interest',
            suggested_angles: ['Background and context', 'Expert opinions'],
          })),
          trending_opportunities: [{ topic: 'Youth tech innovation', why_now: 'Trending on social media this week with 12k mentions' }],
        };
      }

      renderGaps(result);
    } catch (e) {
      alert('Content gap analysis failed: ' + (e && e.message ? e.message : e));
      if (empty) empty.classList.remove('hidden');
    } finally {
      setAnalyzing(false);
    }
  }

  if (btn) btn.addEventListener('click', runGapAnalysis);
</script>
