---
import AdminLayout from '../../layouts/AdminLayout.astro';
import StatCard from '../../components/admin/StatCard.astro';
import { loadArticles } from '@lib/content';
import { adminListCollection } from '@lib/admin-collections';
import { SECTIONS } from '@/data/sections';

export const prerender = false;

const articles = await loadArticles();
const published = articles.filter((a) => !a.status || a.status === 'published');

const NOW = Date.now();
const DAY = 24 * 60 * 60 * 1000;
const asOf = (a: (typeof articles)[number]) => {
  const raw = a.publishAt ?? a.$createdAt ?? '';
  const t = new Date(String(raw)).getTime();
  return Number.isFinite(t) ? t : 0;
};
const last90 = published.filter((a) => NOW - asOf(a) <= 90 * DAY);

const sectionNames = new Set<string>([
  ...SECTIONS.map((s) => s.label),
  ...SECTIONS.map((s) => s.slug),
]);

type SectionRow = { name: string; recent: number; total: number; newest: number };
const sectionMap = new Map<string, SectionRow>();
for (const name of sectionNames) {
  sectionMap.set(name, { name, recent: 0, total: 0, newest: 0 });
}
for (const a of published) {
  const key = String(a.section ?? '') || String(a.pillar ?? '');
  if (!key) continue;
  const row =
    sectionMap.get(key) ??
    ({ name: key, recent: 0, total: 0, newest: 0 } satisfies SectionRow);
  row.total += 1;
  const t = asOf(a);
  if (NOW - t <= 90 * DAY) row.recent += 1;
  if (t > row.newest) row.newest = t;
  if (!sectionMap.has(key)) sectionMap.set(key, row);
}
const sections = [...sectionMap.values()].sort((a, b) => a.recent - b.recent || b.total - a.total);
const maxRecent = Math.max(1, ...sections.map((s) => s.recent));
const gaps = sections.filter((s) => s.recent < 3);

const tagCounts = new Map<string, number>();
for (const a of published) {
  if (!Array.isArray(a.tags)) continue;
  for (const tag of a.tags) {
    const k = String(tag).toLowerCase().trim();
    if (k) tagCounts.set(k, (tagCounts.get(k) ?? 0) + 1);
  }
}
const tagRows = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
const topTags = tagRows.slice(0, 20);
const longTailCount = tagRows.filter(([, n]) => n === 1).length;

const stalest = [...sectionMap.values()]
  .filter((s) => s.newest > 0)
  .sort((a, b) => a.newest - b.newest)
  .slice(0, 5);

const views = await adminListCollection<{ section?: string; article_id?: string }>('views', 5000);
const viewsBySection = new Map<string, number>();
for (const v of views) {
  const s = String(v.section ?? '').trim();
  if (s) viewsBySection.set(s, (viewsBySection.get(s) ?? 0) + 1);
}
const quickWins = sections
  .map((s) => ({ ...s, views: viewsBySection.get(s.name) ?? 0 }))
  .filter((s) => s.views >= 5 && s.recent < 3)
  .sort((a, b) => b.views - a.views)
  .slice(0, 5);

const daysSince = (t: number) => (t > 0 ? Math.floor((NOW - t) / DAY) : null);
const fmtInt = new Intl.NumberFormat('en-GB');
---

<AdminLayout title="Content gaps" active="content-gap">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="font-serif text-2xl font-bold text-yanci-primary">Rashin labarai</h1>
      <p class="text-sm text-gray-500">Bincike na rufe kowanne sashe da kuma tsufa na labarai.</p>
    </div>
    <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-bold text-gray-600">
      {fmtInt.format(last90.length)} labarai cikin kwanaki 90
    </span>
  </div>

  <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
    <StatCard label="Sassan da ke da rashi" value={String(gaps.length)} />
    <StatCard label="Manufofi (tags)" value={fmtInt.format(tagCounts.size)} />
    <StatCard label="Manufofi mawadaci" value={fmtInt.format(longTailCount)} />
    <StatCard label="Labarai 90d / duka" value={`${last90.length} / ${published.length}`} />
  </div>

  <section class="mt-10 rounded-sm border border-yanci-primary/10 bg-white p-6 shadow-sm">
    <h2 class="mb-1 font-serif text-lg font-bold text-[#121212]">Rufe sassan cikin kwanaki 90</h2>
    <p class="mb-6 text-xs text-gray-500">Sassan da ke ƙasa sun fi bukatar sabon labari (ja = ƙasa da uku).</p>
    <div class="space-y-3">
      {sections.map((s) => (
        <div class="grid grid-cols-[9rem_1fr_5rem] items-center gap-3 text-sm">
          <span class="truncate font-bold text-[#121212]" title={s.name}>{s.name}</span>
          <div class="h-3 overflow-hidden rounded-full bg-gray-100">
            <div
              class={`h-full rounded-full ${s.recent < 3 ? 'bg-[#c70000]' : 'bg-teal-600'}`}
              style={`width:${Math.round((s.recent / maxRecent) * 100)}%`}
            >
            </div>
          </div>
          <span class={`text-right text-xs font-bold ${s.recent < 3 ? 'text-[#c70000]' : 'text-gray-500'}`}>
            {s.recent} / {s.total}
          </span>
        </div>
      ))}
    </div>
  </section>

  <div class="mt-8 grid gap-8 lg:grid-cols-2">
    <section class="rounded-sm border border-yanci-primary/10 bg-white p-6 shadow-sm">
      <h2 class="mb-4 font-serif text-lg font-bold text-[#121212]">Sassan mafi tsufa</h2>
      {stalest.length === 0 ? (
        <p class="text-sm italic text-gray-400">Babu bayani.</p>
      ) : (
        <ul class="space-y-2 text-sm">
          {stalest.map((s) => (
            <li class="flex items-center justify-between border-b border-gray-50 pb-2">
              <span class="font-bold text-[#121212]">{s.name}</span>
              <span class="text-xs text-gray-500">sabo na karshe: {daysSince(s.newest) ?? '?'} kwanaki da suka wuce</span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="rounded-sm border border-yanci-primary/10 bg-white p-6 shadow-sm">
      <h2 class="mb-4 font-serif text-lg font-bold text-[#121212]">Damammakin gaggawa</h2>
      <p class="mb-4 text-xs text-gray-500">Sashen mai karatu da yawa amma labarai kaɗan kwanan nan.</p>
      {quickWins.length === 0 ? (
        <p class="text-sm italic text-gray-400">Babu damammaiki a halin yanzu.</p>
      ) : (
        <ul class="space-y-2 text-sm">
          {quickWins.map((s) => (
            <li class="flex items-center justify-between border-b border-gray-50 pb-2">
              <span class="font-bold text-[#121212]">{s.name}</span>
              <span class="text-xs text-gray-500">{fmtInt.format(s.views)} kalli · {s.recent} sabo</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>

  <section class="mt-8 rounded-sm border border-yanci-primary/10 bg-white p-6 shadow-sm">
    <h2 class="mb-1 font-serif text-lg font-bold text-[#121212]">Manufofin da aka fi amfani da su</h2>
    <p class="mb-6 text-xs text-gray-500">{longTailCount} manufofi sun bayyana sau daya kadai — hada su zuwa jigogi masu karfi.</p>
    <div class="space-y-2">
      {topTags.map(([tag, count]) => (
        <div class="grid grid-cols-[12rem_1fr_3rem] items-center gap-3 text-sm">
          <a href={`/tag/${encodeURIComponent(tag)}`} class="truncate text-teal-700 hover:underline">#{tag}</a>
          <div class="h-2.5 overflow-hidden rounded-full bg-gray-100">
            <div class="h-full rounded-full bg-yanci-accent" style={`width:${Math.round((count / (topTags[0]?.[1] ?? 1)) * 100)}%`}></div>
          </div>
          <span class="text-right text-xs font-bold text-gray-500">{count}</span>
        </div>
      ))}
    </div>
  </section>
</AdminLayout>
