---
import '../../styles/global.css';

export const prerender = false;
---

<!doctype html>
<html lang="ha">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Manta Kalmar Sirri? — Yanci Admin</title>
  </head>
  <body class="antialiased">
    <div class="min-h-screen bg-[#0f3036] flex items-center justify-center p-4">
      <div id="forgot-initial" class="max-w-md w-full">
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white/10 mb-4">
            <svg class="text-[#c59d5f] text-2xl" style="width:1em;height:1em" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M144 144v48H304V144c0-44.2-35.8-80-80-80s-80 35.8-80 80zM80 192V144C80 64.5 144.5 0 224 0s144 64.5 144 144v48h16c35.3 0 64 28.7 64 64V448c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V256c0-35.3 28.7-64 64-64H80z"></path></svg>
          </div>
          <h1 class="text-2xl font-black text-white tracking-tight">Manta Kalmar Sirri?</h1>
          <p class="text-white/50 text-sm mt-1">Shigar da imel ɗinka, za mu aiko maka da hanyar sake saiti</p>
        </div>

        <div class="bg-white rounded-2xl shadow-2xl p-8">
          <form id="forgot-form" class="space-y-5">
            <div>
              <label for="email" class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wider">
                <svg class="inline w-3 h-3 mr-1 text-[#c59d5f]" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48L48 64zM0 176L0 384c0 35.3 28.7 64 64 64l384 0c35.3 0 64-28.7 64-64l0-208L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z"></path></svg>
                Imel
              </label>
              <input
                id="email"
                name="email"
                type="email"
                placeholder="admin@yanci.ng"
                required
                autocomplete="username"
                class="w-full border border-gray-200 rounded-xl px-3 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#c59d5f] focus:border-transparent bg-gray-50 transition"
              />
            </div>

            <div id="forgot-error" class="hidden bg-red-50 border border-red-100 rounded-xl px-4 py-3 text-sm text-red-700 font-medium"></div>

            <button
              id="forgot-btn"
              type="submit"
              class="w-full bg-[#0f3036] text-white py-3.5 rounded-xl font-bold hover:bg-[#1a4e56] transition-colors disabled:opacity-50 disabled:cursor-not-allowed text-sm tracking-wide"
            >
              Aiko Hanyar Sake Saiti
            </button>
          </form>

          <div class="mt-6 text-center">
            <a href="/admin/login" class="text-xs text-gray-400 hover:text-[#0f3036] transition-colors">
              &larr; Koma Shiga
            </a>
          </div>
        </div>
      </div>

      <div id="forgot-sent" class="max-w-md w-full hidden">
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white/10 mb-4">
            <svg class="text-green-400 text-2xl" style="width:1em;height:1em" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM369 209L241 337c-9.4 9.4-24.6 9.4-33.9 0l-64-64c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0l47 47L335 175c9.4-9.4 24.6-9.4 33.9 0s9.4 24.6 0 33.9z"></path></svg>
          </div>
          <h1 class="text-2xl font-black text-white tracking-tight">An Aiko Imel</h1>
          <p class="text-white/50 text-sm mt-1">Duba akwatin imel ɗinka don ci gaba</p>
        </div>

        <div class="bg-white rounded-2xl shadow-2xl p-8 text-center">
          <p class="text-gray-600 text-sm leading-relaxed mb-6">
            Mun aiko maka hanyar sake saitin kalmar sirri zuwa <strong id="sent-email" class="text-[#0f3036]"></strong>.
            Idan ba ka ga saƙon ba, duba akwatin spam ɗinka.
          </p>
          <a href="/admin/login" class="inline-block bg-[#0f3036] text-white py-3 px-6 rounded-xl font-bold hover:bg-[#1a4e56] transition-colors text-sm tracking-wide">
            Koma Shiga
          </a>
        </div>
      </div>
    </div>

    <script is:inline>
      const form = document.getElementById('forgot-form');
      const btn = document.getElementById('forgot-btn');
      const errBox = document.getElementById('forgot-error');
      const initial = document.getElementById('forgot-initial');
      const sent = document.getElementById('forgot-sent');
      const sentEmail = document.getElementById('sent-email');
      const emailInput = document.getElementById('email');

      function updateBtnState() {
        if (!btn || !emailInput) return;
        if (emailInput.value.trim() && !btn.hasAttribute('data-loading')) {
          btn.removeAttribute('disabled');
        } else if (!btn.hasAttribute('data-loading')) {
          btn.setAttribute('disabled', 'true');
        }
      }
      if (emailInput) {
        emailInput.addEventListener('input', () => {
          if (errBox) {
            errBox.classList.add('hidden');
            errBox.textContent = '';
          }
          updateBtnState();
        });
      }
      updateBtnState();

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (errBox) {
            errBox.classList.add('hidden');
            errBox.textContent = '';
          }
          if (btn) {
            btn.setAttribute('disabled', 'true');
            btn.setAttribute('data-loading', 'true');
            btn.textContent = 'Ana aikawa...';
          }
          const email = emailInput ? emailInput.value.trim() : '';
          try {
            const res = await fetch('/api/auth/recovery', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email }),
            });
            const data = await res.json();
            if (!res.ok || !data.ok) {
              throw new Error(data.message || 'An sami matsala. Gwada sake.');
            }
            if (initial) initial.classList.add('hidden');
            if (sent) sent.classList.remove('hidden');
            if (sentEmail) sentEmail.textContent = email;
          } catch (err) {
            if (errBox) {
              errBox.textContent = err.message || 'An sami matsala. Gwada sake.';
              errBox.classList.remove('hidden');
            }
            if (btn) {
              btn.removeAttribute('data-loading');
              btn.textContent = 'Aiko Hanyar Sake Saiti';
              updateBtnState();
            }
          }
        });
      }
    </script>
  </body>
</html>
