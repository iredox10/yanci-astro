---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import NewsCard from '../components/NewsCard.astro';
import { sectionBySlug, sectionKeyForSlug } from '../data/sections';
import { loadSectionFeed, toCards } from '../lib/content';
import { pillarColors } from '../data/schema';
import { getSportsData } from '@lib/appwrite-server';
import { SEED_SPORTS } from '../data/seed';

export const prerender = false;

const { section } = Astro.params;
const def = sectionBySlug(section!);
if (!def) {
  return Astro.redirect('/404');
}
const colors = pillarColors(def.pillar);
const sectionKey = sectionKeyForSlug(section!) ?? section!;

const cards = await toCards(await loadSectionFeed(sectionKey));

const [heroStory, ...rest] = cards;
const subStories = rest.slice(0, 3);
const feedStories = rest.slice(3);

const isSport = sectionKey === 'sport';
const sports = isSport ? (await getSportsData()) ?? SEED_SPORTS : null;
const sportsAny = sports as any;
const liveMatches: any[] = sportsAny?.liveMatches ?? [];
const standings: any[] = sportsAny?.standings ?? [];
const fixtures: any[] = sportsAny?.fixtures ?? [];
---

<BaseLayout
  title={`${def.label} — Yanci`}
  description={def.blurb}
  path={`/${section}/`}
>
  <SectionHeader section={def} />

  <main class="mx-auto max-w-[1400px] px-4 py-12 md:px-6">
    {isSport && (liveMatches.length > 0 || standings.length > 0 || fixtures.length > 0) && (
      <>
        {/* Scoreboard strip */}
        {liveMatches.length > 0 && (
          <div class="mb-8 overflow-x-auto rounded-2xl bg-[#0f3036] shadow-lg">
            <div class="flex min-w-max gap-6 px-5 py-4">
              {liveMatches.map((match: any) => (
                <div class="flex items-center gap-4 rounded-lg bg-[#1a454c] px-4 py-3">
                  <span class="rounded-full bg-[#c59d5f]/20 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-[#c59d5f]">{match.league}</span>
                  <span class="whitespace-nowrap text-sm font-bold text-white">
                    {match.homeTeam} <span class="mx-1 text-[#c59d5f]">{match.homeScore ?? 0} - {match.awayScore ?? 0}</span> {match.awayTeam}
                  </span>
                  {match.isLive ? (
                    <span class="flex items-center gap-1.5 text-xs font-bold text-red-400">
                      <span class="relative flex h-2 w-2">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-400 opacity-75"></span>
                        <span class="relative inline-flex h-2 w-2 rounded-full bg-red-500"></span>
                      </span>
                      LIVE{match.minute ? ` · ${match.minute}` : ''}
                    </span>
                  ) : (
                    <span class="text-xs font-bold text-gray-300">{match.minute || 'KARSHE'}</span>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Standings + fixtures */}
        <div class="mb-12 grid gap-8 lg:grid-cols-12">
          {standings.length > 0 && (
            <div class="overflow-hidden rounded-2xl bg-white shadow-xl lg:col-span-5">
              <div class="flex items-center justify-between border-b border-gray-100 p-4">
                <span class="text-sm font-bold text-[#0f3036]">Tsarin Gasar</span>
                <span class="text-xs text-gray-400">Cikakken tebur</span>
              </div>
              <div class="p-3">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-gray-100 text-left text-[10px] font-bold uppercase tracking-widest text-gray-400">
                      <th class="px-2.5 py-2">#</th>
                      <th class="py-2 text-left">Kungiya</th>
                      <th class="py-2 text-center">W</th>
                      <th class="py-2 text-center">GD</th>
                      <th class="py-2 text-center">Pts</th>
                    </tr>
                  </thead>
                  <tbody>
                    {standings.map((team: any) => (
                      <tr class={team.pos === 1 ? 'border-l-4 border-[#c59d5f] bg-[#c59d5f]/10' : 'border-l-4 border-transparent'}>
                        <td class="px-2.5 py-2.5 text-center font-bold text-gray-400">{team.pos}</td>
                        <td class={`py-2.5 font-bold ${team.pos === 1 ? 'text-[#0f3036]' : 'text-[#1c1917]'}`}>{team.team}</td>
                        <td class="py-2.5 text-center text-gray-400">{team.p}</td>
                        <td class="py-2.5 text-center text-gray-400">{team.gd}</td>
                        <td class="py-2.5 text-center font-bold text-[#0f3036]">{team.pts}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {fixtures.length > 0 && (
            <div class="rounded-2xl bg-white/95 p-6 shadow-xl lg:col-span-7">
              <div class="mb-6 flex items-center justify-between">
                <span class="text-lg font-bold text-[#0f3036]">Wasannin Wannan Mako</span>
                <span class="rounded-full bg-[#0f3036]/10 px-3 py-1 text-xs font-bold text-[#0f3036]">{fixtures.length} Wasanni</span>
              </div>
              <div class="space-y-4">
                {fixtures.map((match: any) => (
                  <div class="flex items-center gap-4 rounded-xl border border-gray-100 bg-white p-4">
                    <div class="flex-1 text-center">
                      <span class="block text-sm font-bold text-[#1c1917]">{match.home}</span>
                    </div>
                    <div class="px-4 text-center">
                      <span class="block text-xs text-gray-400">{match.date}, {match.time}</span>
                      <span class="my-1 block text-lg font-black text-gray-300">VS</span>
                      <span class="block text-[10px] text-gray-400">{match.stadium}</span>
                    </div>
                    <div class="flex-1 text-center">
                      <span class="block text-sm font-bold text-gray-600">{match.away}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </>
    )}

    {cards.length === 0 ? (
      <div class="py-32 text-center text-gray-400">
        <p class="mb-2 font-serif text-2xl">Babu labari a nan tukuna.</p>
        <p class="text-sm">Dawo nan gaba ko nema labari.</p>
        <a
          href="/search"
          class="mt-6 inline-block rounded-sm px-6 py-3 text-sm font-bold uppercase tracking-widest text-white transition-all duration-200"
          style={`background-color: ${colors.main}`}
        >
          Nema Labari
        </a>
      </div>
    ) : (
      <>
        <section class="mb-12">
          <div class="grid gap-8 md:grid-cols-12">
            {heroStory && (
              <div class="md:col-span-8">
                <NewsCard data={heroStory} variant="hero" />
              </div>
            )}
            {subStories.length > 0 && (
              <div class="border-t-4 bg-white p-6 md:col-span-4" style={`border-color: ${colors.main}`}>
                <h3 class="mb-4 text-sm font-bold uppercase tracking-widest" style={`color: ${colors.main}`}>
                  Mafi Daukar Hankali
                </h3>
                <ul class="divide-y divide-gray-100">
                  {subStories.map((story) => (
                    <li class="py-4 first:pt-0">
                      <a href={`/article/${story.$id ?? story.id}`} class="group block">
                        <span class="mb-1 block text-[10px] font-bold uppercase tracking-widest" style={`color: ${colors.main}`}>
                          {story.kicker}
                        </span>
                        <h4 class="line-clamp-2 font-serif text-lg font-bold leading-tight text-[#1c1917] transition-colors group-hover:text-[#0f3036]">
                          {story.headline}
                        </h4>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>

        {feedStories.length > 0 && (
          <section class="mt-12">
            <div class="mb-8 flex items-center gap-2 border-b pb-2" style={`border-color: ${colors.main}`}>
              <span class="text-sm font-bold uppercase tracking-widest" style={`color: ${colors.main}`}>
                {def.label} — Ƙarin Labari
              </span>
            </div>
            <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
              {feedStories.map((story) => (
                <NewsCard data={story} />
              ))}
            </div>
          </section>
        )}
      </>
    )}
  </main>
</BaseLayout>