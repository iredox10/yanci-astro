---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getElections, getFactChecks } from '@lib/appwrite-server';

export const prerender = false;

const elections = await getElections();
const active = elections.find((e) => e.status === 'active' && e.published !== false) ?? elections[0];

const [allFactChecks] = await Promise.all([getFactChecks()]);
const factChecks = allFactChecks.filter((fc) => fc.verdict !== '');

const verdictStyles: Record<string, string> = {
  true: 'bg-emerald-100 text-emerald-700',
  mostly_true: 'bg-teal-100 text-teal-700',
  misleading: 'bg-amber-100 text-amber-700',
  false: 'bg-red-100 text-red-700',
  unverified: 'bg-gray-200 text-gray-600',
};
const verdictLabels: Record<string, string> = {
  true: 'Gaskiya',
  mostly_true: 'Gaskiya da yawa',
  misleading: 'Yaudara',
  false: 'Karya',
  unverified: 'Ba a tantance ba',
};
const partyNames: Record<string, string> = {
  apc: 'APC',
  pdp: 'PDP',
  nnpp: 'NNPP',
  lpp: 'LPP',
  apga: 'APGA',
  independent: 'Independent',
};
const verdicts = ['true', 'mostly_true', 'misleading', 'false', 'unverified'] as const;
const counts: Record<string, number> = { all: factChecks.length };
for (const v of verdicts) counts[v] = factChecks.filter((fc) => fc.verdict === v).length;

const filter = (Astro.url.searchParams.get('verdict') ?? '').toLowerCase();
const filterVerdict = (verdicts as readonly string[]).includes(filter) ? filter : '';
const shown = filterVerdict ? factChecks.filter((fc) => fc.verdict === filterVerdict) : factChecks;
---

<BaseLayout
  title="Binciken Gaskiya — Yanci"
  description="Tantance maganganun 'yan siyasa: muna bincika da'awowi kuma mu ba da hukunci — Gaskiya, Yaudara ko Karya."
  path="/fact-check"
>
  <section class="border-b border-yanci-primary/15 bg-yanci-primary/5">
    <div class="mx-auto max-w-[1400px] px-4 py-10 md:px-6">
      <span class="text-xs font-bold uppercase tracking-widest text-yanci-accent">Fact checks</span>
      <h1 class="mt-2 font-serif text-3xl font-black text-yanci-primary md:text-4xl">Binciken Gaskiya</h1>
      <p class="mt-2 max-w-2xl text-sm text-yanci-primary/60">
        Muna bincika maganganun 'yan siyasa da masu rike da mukamai, sannan mu tantance gaskiyarsu bisa shaidu.
        {active?.name ? ` Na yanzu: ${active.name}.` : ''}
      </p>
    </div>
  </section>

  <main class="mx-auto max-w-[1400px] px-4 py-12 md:px-6">
    <!-- Verdict filter tabs -->
    <div class="mb-8 flex flex-wrap gap-1">
      {[{ id: '', label: `Duka (${counts.all})` }, ...verdicts.map((v) => ({ id: v, label: `${verdictLabels[v]} (${counts[v] ?? 0})` }))].map((tab) => (
        <a
          href={tab.id ? `/fact-check?verdict=${tab.id}` : '/fact-check'}
          class:list={[
            'rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wide transition-colors',
            filterVerdict === tab.id
              ? 'bg-yanci-primary text-white'
              : 'border border-yanci-primary/20 text-yanci-primary/70 hover:bg-yanci-primary/10',
          ]}
        >
          {tab.label}
        </a>
      ))}
    </div>

    {shown.length === 0 ? (
      <div class="py-24 text-center">
        <p class="mb-2 font-serif text-2xl text-gray-400">Babu tantancewa a wannan filter tukuna.</p>
        <a href="/fact-check" class="text-sm font-bold text-yanci-accent hover:underline">Nuna duka</a>
      </div>
    ) : (
      <div class="space-y-4">
        {shown.map((fc) => (
          <article class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="max-w-2xl">
                <p class="font-serif text-lg font-bold leading-snug text-yanci-dark">“{fc.claim}”</p>
                <p class="mt-1 text-xs text-yanci-primary/50">
                  {fc.claimant}
                  {fc.claimantParty ? ` · ${partyNames[fc.claimantParty] ?? fc.claimantParty}` : ''}
                  {fc.date && (
                    <>
                      {' · '}
                      {new Date(fc.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                    </>
                  )}
                </p>
              </div>
              <span class={`rounded-full px-3 py-1 text-xs font-bold uppercase ${verdictStyles[fc.verdict] ?? verdictStyles.unverified}`}>
                {verdictLabels[fc.verdict] ?? fc.verdict}
              </span>
            </div>
            {fc.analysis && <p class="mt-3 text-sm leading-relaxed text-gray-600">{fc.analysis}</p>}
            {fc.source && <p class="mt-2 text-xs font-medium text-yanci-primary/50">Source: {fc.source}</p>}
          </article>
        ))}
      </div>
    )}

    <div class="pt-10 text-center">
      <a href="/zabe" class="inline-flex items-center gap-2 rounded-lg bg-yanci-primary px-6 py-3 font-bold text-white transition-colors hover:bg-[#1a454c]">
        Duba Sakamakon Zabe Kai Tsaye
      </a>
    </div>
  </main>
</BaseLayout>