---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import { loadSearchResults, toCards } from '../lib/content';

export const prerender = false;

const q = (Astro.url.searchParams.get('q') ?? '').trim().toLowerCase();
const results = q ? await toCards(await loadSearchResults(q)) : [];
---

<BaseLayout title={q ? `Nema: ${q} — Yanci` : 'Nema Labari — Yanci'} description="Nema labarai daga Yanci." path="/search/">
  <section class="mx-auto max-w-[1400px] px-4 py-12 md:px-6">
    <div class="mb-10 max-w-xl">
      <h1 class="mb-6 font-serif text-4xl font-black tracking-tighter text-[#121212] md:text-5xl">Nema Labari</h1>
      <form action="/search" method="get" class="flex gap-2">
        <input
          type="search" name="q" value={Astro.url.searchParams.get('q') ?? ''}
          placeholder="Nemi da kalmar..."
          class="flex-1 rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm outline-none transition-all focus:border-[#c59d5f] focus:ring-2 focus:ring-[#c59d5f]/20"
        />
        <button type="submit" class="rounded-lg bg-[#0f3036] px-6 py-3 text-sm font-bold uppercase tracking-wider text-white transition-colors hover:bg-[#1a454c]">Nema</button>
      </form>
    </div>

    {!q ? (
      <p class="py-16 text-center text-gray-400">Rubuta abin da kake nema a kasa sama.</p>
    ) : results.length === 0 ? (
      <p class="py-16 text-center text-gray-400">Babu sakamako ga "{q}".</p>
    ) : (
      <>
        <p class="mb-6 text-sm font-bold text-gray-500">{results.length} sakamako ga "{q}"</p>
        <div class="grid gap-8 sm:grid-cols-2">
          {results.map((a) => (
            <NewsCard data={a} />
          ))}
        </div>
      </>
    )}
  </section>
</BaseLayout>