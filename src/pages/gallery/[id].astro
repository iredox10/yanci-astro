---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoGallery from '../../components/PhotoGallery';
import { loadGallery, loadGalleries } from '../../lib/galleries';

export const prerender = false;

const { id } = Astro.params;
const gallery = await loadGallery(id!);

if (!gallery) {
  return Astro.redirect('/404');
}

const allGalleries = await loadGalleries();
const otherGalleries = allGalleries.filter(
  (g) => g.id !== gallery.id && g.slug !== gallery.slug,
);

const galleryId = gallery.slug || gallery.id;
const currentUrl = `${Astro.site?.href ?? 'https://yanci.ng'}gallery/${galleryId}`;
const enc = (s: string) => encodeURIComponent(s);
const facebookShare = `https://www.facebook.com/sharer/sharer.php?u=${enc(currentUrl)}`;
const twitterShare = `https://twitter.com/intent/tweet?url=${enc(currentUrl)}&text=${enc(gallery.title)}`;
const whatsappShare = `https://api.whatsapp.com/send?text=${enc(`${gallery.title} - ${currentUrl}`)}`;

const formatDate = (iso?: string) =>
  iso
    ? new Date(iso).toLocaleDateString('ha-NG', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      })
    : '';
---

<BaseLayout
  title={`${gallery.title} — Kundin Hotuna — Yanci`}
  description={gallery.description}
  path={`/gallery/${galleryId}`}
  image={gallery.coverImage || gallery.items[0]?.url}
  ogType="article"
  publishedTime={gallery.publishedAt}
  authorName={gallery.photographer}
  tags={gallery.tags}
  section={gallery.section || "Al'adu"}
>
  <article class="bg-yanci-paper min-h-screen pb-16 font-sans">
    {/* Top Header & Breadcrumbs */}
    <header class="border-b border-stone-200 bg-white/70 backdrop-blur-sm">
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 md:py-12">
        {/* Kicker & Metadata Badges */}
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs font-bold uppercase tracking-wider text-stone-500 mb-4">
          <a
            href="/"
            class="hover:text-yanci-primary transition-colors inline-flex items-center gap-1"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-3.5 h-3.5"
            >
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
              <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
            Gida
          </a>
          <span>/</span>
          <span class="text-[#8a2c2c] font-black tracking-widest inline-flex items-center gap-1">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-3.5 h-3.5"
            >
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
              <circle cx="12" cy="13" r="4" />
            </svg>
            {gallery.kicker || 'Kundin Hotuna'}
          </span>
          {gallery.section && (
            <>
              <span>•</span>
              <span class="text-stone-600">{gallery.section}</span>
            </>
          )}
        </div>

        {/* Title / Headline */}
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-[#0f3036] leading-[1.15] mb-6">
          {gallery.title}
        </h1>

        {/* Lead / Subheadline */}
        {gallery.lead && (
          <p class="font-sans text-lg sm:text-xl text-stone-700 leading-relaxed max-w-4xl mb-6">
            {gallery.lead}
          </p>
        )}

        {/* Byline & Sharing Row */}
        <div class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-stone-200/80">
          <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-stone-600">
            <div class="flex items-center gap-2 font-medium">
              <span class="text-stone-400">Hotuna da Labari:</span>
              <span class="font-bold text-[#0f3036]">{gallery.photographer}</span>
            </div>

            {gallery.publishedAt && (
              <>
                <span class="text-stone-300">•</span>
                <time datetime={gallery.publishedAt} class="text-stone-500">
                  {formatDate(gallery.publishedAt)}
                </time>
              </>
            )}

            <span class="text-stone-300">•</span>
            <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 text-[#8a6a35] px-2.5 py-0.5 font-bold text-xs">
              {gallery.items.length} Hotuna
            </span>
          </div>

          {/* Social Share Buttons */}
          <div class="flex items-center gap-2">
            <a
              href={whatsappShare}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-[#25D366]/10 text-[#25D366] hover:bg-[#25D366] hover:text-white transition-colors"
              aria-label="Raba a WhatsApp"
              title="Raba a WhatsApp"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
              </svg>
            </a>

            <a
              href={twitterShare}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-sky-500/10 text-sky-600 hover:bg-sky-500 hover:text-white transition-colors"
              aria-label="Raba a X (Twitter)"
              title="Raba a X (Twitter)"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            </a>

            <a
              href={facebookShare}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-blue-600/10 text-blue-600 hover:bg-blue-600 hover:text-white transition-colors"
              aria-label="Raba a Facebook"
              title="Raba a Facebook"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.5 5H18V0h-3.808C10.595 0 9 1.583 9 4.615V8z" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </header>

    {/* Main Photo Gallery Interactive Stage */}
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <PhotoGallery client:load items={gallery.items} title={gallery.title} />
    </div>

    {/* Additional Photo Essay Stories & Highlights */}
    {otherGalleries.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pt-12 sm:px-6">
        <div class="border-t-2 border-[#0f3036] pt-6 mb-8 flex items-center justify-between">
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#0f3036]">
            Karin Kundin Hotuna
          </h2>
          <span class="text-xs font-bold uppercase tracking-widest text-[#c59d5f]">
            Labarai a Hotuna
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {otherGalleries.map((other) => (
            <a
              href={`/gallery/${other.slug || other.id}`}
              class="group flex flex-col overflow-hidden rounded-xl bg-white border border-stone-200 shadow-sm hover:shadow-md hover:border-[#c59d5f] transition-all duration-200"
            >
              <div class="relative aspect-[16/10] overflow-hidden bg-stone-900">
                <img
                  src={other.coverImage || other.items[0]?.url}
                  alt={other.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <span class="absolute top-2.5 right-2.5 inline-flex items-center gap-1 rounded-full bg-black/75 px-2.5 py-1 text-[11px] font-bold text-amber-200 backdrop-blur-sm">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="w-3 h-3 text-[#c59d5f]"
                  >
                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                    <circle cx="12" cy="13" r="4" />
                  </svg>
                  {other.items.length} Hotuna
                </span>
              </div>

              <div class="flex flex-1 flex-col p-5">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#8a2c2c] mb-2">
                  {other.kicker || 'Kundin Hotuna'}
                </span>
                <h3 class="font-serif text-lg font-bold text-[#0f3036] group-hover:text-[#8a2c2c] transition-colors leading-snug mb-2">
                  {other.title}
                </h3>
                <p class="text-xs text-stone-600 line-clamp-2 mb-4 leading-relaxed">
                  {other.description}
                </p>
                <div class="mt-auto flex items-center justify-between text-[11px] font-semibold text-stone-400 pt-3 border-t border-stone-100">
                  <span>{other.photographer}</span>
                  <span class="text-[#c59d5f] group-hover:translate-x-0.5 transition-transform">
                    Duba &rarr;
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
