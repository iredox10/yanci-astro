---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResultsBoard from '../../components/elections/ResultsBoard';
import { getElections } from '@lib/appwrite-server';

export const prerender = false;

const elections = await getElections();
const active =
  elections.find((e) => e.status === 'active' && e.published !== false) ?? elections[0];

const parsedDate = active ? new Date(active.date) : null;
const validDate = parsedDate && !Number.isNaN(parsedDate.getTime()) ? parsedDate : null;
const fmt = new Intl.DateTimeFormat('ha-NG', { day: 'numeric', month: 'long', year: 'numeric' });
const dateLabel = validDate ? fmt.format(validDate) : '';
---

<BaseLayout
  title={active ? `Sakamako Kai Tsaye — ${active.name} | Yanci` : 'Sakamako Kai Tsaye | Yanci'}
  description="Sakamakon zabe kai tsaye — kuri'u, jam'iyyu da sakamakon jihohi a lokacin gaskiya."
  path="/zabe/sakamako"
>
  <section class="bg-yanci-primary text-white">
    <div class="mx-auto max-w-[1400px] px-4 py-10 md:px-6">
      <span class="inline-flex items-center gap-2 rounded-full bg-red-600 px-3 py-1 text-xs font-bold uppercase tracking-wider">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-white"></span>
        </span>
        Kai Tsaye
      </span>
      <h1 class="mt-3 font-serif text-3xl font-black tracking-tight md:text-5xl">Sakamako</h1>
      {active && (
        <p class="mt-2 max-w-3xl text-sm text-white/70">
          {active.fullName || active.name} · {active.electoralBody}{dateLabel ? ` · ${dateLabel}` : ''}
        </p>
      )}
    </div>
  </section>

  <main class="mx-auto max-w-[1400px] px-4 py-10 md:px-6">
    <ResultsBoard client:load electionId={active?.$id ?? null} />
    <noscript>
      <p class="mt-6 rounded-xl border border-gray-200 bg-white p-6 text-sm text-gray-500">
        Don ganin sakamako kai tsaye, buɗe JavaScript. Za ka iya duba taƙaitaccen bayani a
        <a href="/zabe" class="font-bold text-yanci-primary underline">shafin zabe</a>.
      </p>
    </noscript>
  </main>
</BaseLayout>
