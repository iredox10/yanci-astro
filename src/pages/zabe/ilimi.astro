---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getElections } from '@lib/appwrite-server';

export const prerender = false;

const elections = await getElections();
const active = elections.find((e) => e.status === 'active' && e.published !== false) ?? elections[0];

const registrationDeadline = new Date('2026-12-31');
const pollingDay = new Date('2027-02-06');
const pollingHours = '8:00 AM - 4:00 PM';
const requirements = [
  'Katin zaba na INEC (Permanent Voter Card)',
  'Katin shaida (ID card, passport, ko driving license)',
  'Ku zo da kansa — ba za a iya zaba a madadin ku ba',
];
const howToVote = [
  'Je zuwa cibiyar zaba da aka raba maka',
  "Nuna katin zaba ga ma'aikacin INEC",
  'Ana ba ka takardar zaba',
  "Zaɓi ɗan takarar ka a cikin ɗakin zaba",
  'Saka takardar a cikin akwatin zaba',
  'Danna yatsa da tawada (indelible ink)',
];
const warnings = [
  "Kada ka sayi ko ka sayar da ƙuri'ar ka — laifi ne",
  "KADA ka ɗauki hoton ƙuri'ar ka a cikin ɗakin zaba",
  'KADA ka karɓi kuɗi ko kayayyaki don zaba',
  'KADA ka bar katin zabar ka ga wani',
  'KADA ka yi zaba fiye da sau ɗaya',
  'KADA ka ɗauki makami ko wani abu mai haɗari zuwa cibiyar zaba',
];
const rights = [
  { title: "'Yancin Sirri", desc: "Zaben ka sirri ne — babu wanda zai iya tilasta maka zaban wani." },
  { title: "'Yancin Samun Bayanai", desc: "Kana da 'yancin sanin manufofin 'yan takara da tsarin zabe." },
  { title: "'Yancin Korar Suka", desc: "Idan aka hana ka zaba, kana da 'yancin korar hukuma ga INEC." },
  { title: "'Yancin Tsaro", desc: "Kana da 'yancin zaba cikin tsaro ba tare da tsoro ba." },
];
const emergencyContacts = [
  { name: 'INEC Hotline', phone: '0800-INEC-001' },
  { name: 'Police Emergency', phone: '112' },
  { name: 'Yanci Election Desk', phone: '0800-YANCI-01' },
];
const registerSteps = [
  { title: 'Je Ofishin INEC', desc: 'Je ofishin INEC na ƙaramar hukumar ka tare da takardar shaida.' },
  { title: 'Cika Fom', desc: "Cika fom din rajistar ɗan zaba da duk bayanin da ake buƙata." },
  { title: 'Hotuna da Fingerprint', desc: 'Ana ɗaukar hoton ka da fingerprints na hannun ka biyu.' },
  { title: "Karɓi Katin Zaba", desc: 'Za a ba ka Permanent Voter Card (PVC) bayan kwanaki 30-90.' },
];
const fmt = new Intl.DateTimeFormat('ha-NG', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Ilimin ɗan Zaba — Zabe 2027 | Yanci"
  description="Koyi yadda ake zaba — rajista, abubuwan da ake buƙata, lokaci, da wuraren zaba."
  path="/zabe/ilimi"
>
  <section class="border-b border-yanci-primary/15 bg-yanci-primary/5">
    <div class="mx-auto max-w-[1400px] px-4 py-10 md:px-6">
      <span class="text-xs font-bold uppercase tracking-widest text-yanci-accent">Ilimin ɗan Zaba</span>
      <h1 class="mt-2 font-serif text-3xl font-black text-yanci-primary md:text-4xl">Koyi Yadda Ake Zaba</h1>
      <p class="mt-2 max-w-2xl text-sm text-yanci-primary/60">
        Cikakken jagora ga ɗan ƙasa mai son yin zabe — daga rajista har zuwa jefa ƙuri'a.
      </p>
    </div>
  </section>

  <main class="mx-auto max-w-[1400px] space-y-12 px-4 py-12 md:px-6">
    <!-- Key dates -->
    <section>
      <h2 class="mb-6 flex items-center gap-3 font-serif text-2xl font-black text-yanci-primary">Muhimman Lokuta</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
          <p class="mb-2 text-xs font-bold uppercase tracking-wider text-gray-500">Ranar Rajista</p>
          <p class="text-xl font-black text-red-600">{fmt.format(registrationDeadline)}</p>
          <p class="mt-2 text-xs text-gray-500">Ranar ƙarshe don yin rajista ko canza cibiyar zaba</p>
        </div>
        <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
          <p class="mb-2 text-xs font-bold uppercase tracking-wider text-gray-500">Ranar Zabe</p>
          <p class="text-xl font-black text-yanci-primary">{fmt.format(pollingDay)}</p>
          <p class="mt-2 text-xs text-gray-500">Lokacin zaba: {pollingHours}</p>
        </div>
        <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
          <p class="mb-2 text-xs font-bold uppercase tracking-wider text-gray-500">Zaben</p>
          <p class="text-xl font-black">{active?.name ?? 'Zaben Gabaɗaya 2027'}</p>
          <p class="mt-2 text-xs text-gray-500">{active?.electoralBody ?? 'INEC'} · {active ? fmt.format(new Date(active.date)) : '2027'}</p>
        </div>
      </div>
    </section>

    <!-- How to register -->
    <section class="rounded-xl border border-gray-100 bg-white p-8 shadow-sm">
      <h2 class="mb-6 font-serif text-2xl font-black text-yanci-primary">Yadda Ake Yin Rajista</h2>
      <div class="grid gap-6 md:grid-cols-4">
        {registerSteps.map((item, i) => (
          <div class="text-center">
            <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-yanci-primary text-lg font-bold text-white">{i + 1}</div>
            <h3 class="mb-2 font-bold">{item.title}</h3>
            <p class="text-sm leading-relaxed text-gray-500">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- What to bring -->
    <section class="rounded-xl border border-green-200 bg-gradient-to-br from-green-50 to-emerald-50 p-8">
      <h2 class="mb-6 font-serif text-2xl font-black text-yanci-primary">Abubuwan Da Ake Bukata A Ranar Zabe</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {requirements.map((req) => (
          <div class="flex items-start gap-3 rounded-lg bg-white p-4 shadow-sm">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-green-600" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M256 512a256 256 0 1 0 0-512 256 256 0 1 0 0 512zm113-303 17 17-17 17-128 128-17 17-17-17L113 289l-17-17 17-17 73-73 17-17 17 17 55 55 135-135 17-17 17 17z"/></svg>
            <span class="text-sm font-medium">{req}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- How to vote -->
    <section class="rounded-xl border border-gray-100 bg-white p-8 shadow-sm">
      <h2 class="mb-6 font-serif text-2xl font-black text-yanci-primary">Matakan Jefa Ƙuri'a</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {howToVote.map((step, i) => (
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-yanci-primary font-bold text-white">{i + 1}</div>
            <p class="text-sm font-medium leading-relaxed">{step}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Warnings -->
    <section class="rounded-xl border border-amber-200 bg-amber-50 p-8">
      <h2 class="mb-6 font-serif text-2xl font-black text-yanci-primary">Gargadi — Abubuwan Da Kada A Yi</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {warnings.map((warning) => (
          <div class="flex items-start gap-3 rounded-lg bg-white p-4 shadow-sm">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-amber-600" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M256 32 14.3 415.2 86.8 480h338.4l72.5-64.8L256 32zm-32 320v-128h64v128h-64zm0 64v-48h64v48h-64z"/></svg>
            <span class="text-sm font-medium">{warning}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Rights -->
    <section class="rounded-xl bg-yanci-primary p-8 text-white">
      <h2 class="mb-6 flex items-center gap-3 font-serif text-2xl font-black"><span class="text-yanci-accent">'</span>Yancin Ka A Matsayin ɗan Zaba</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {rights.map((right) => (
          <div class="rounded-lg bg-white/10 p-5 backdrop-blur">
            <h3 class="mb-2 font-bold text-yanci-accent">{right.title}</h3>
            <p class="text-sm leading-relaxed text-white/80">{right.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Emergency contacts -->
    <section class="rounded-xl border border-gray-100 bg-white p-8 shadow-sm">
      <h2 class="mb-6 font-serif text-2xl font-black text-yanci-primary">Lambobin Gaggawa</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {emergencyContacts.map((contact) => (
          <div class="rounded-lg bg-gray-50 p-5 text-center">
            <p class="mb-1 text-2xl font-black text-yanci-primary">{contact.phone}</p>
            <p class="text-sm font-bold text-gray-600">{contact.name}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="pt-4 text-center">
      <a href="/zabe" class="inline-flex items-center gap-2 rounded-lg bg-yanci-primary px-6 py-3 font-bold text-white transition-colors hover:bg-[#1a454c]">
        Komawa Babban Shafin Zabe
      </a>
    </div>
  </main>
</BaseLayout>