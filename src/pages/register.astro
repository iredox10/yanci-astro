---
import BaseLayout from '../layouts/BaseLayout.astro';
import RegisterForm from '../components/auth/RegisterForm';

export const prerender = false;
---

<BaseLayout title="Yi rajista — Yanci" description="Kiranci asusun mai karatu a Yanci don shiga cikin tattaunawa da raba ra'ayinka." path="/register/">
  <div class="flex min-h-[70vh] items-center justify-center px-4 py-16">
    <div class="w-full max-w-sm">
      <div class="mb-6 text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-yanci-accent">Asusu</span>
        <h1 class="mt-2 font-serif text-3xl font-black text-yanci-primary">Yi rajista</h1>
        <p class="mt-1 text-sm text-yanci-primary/60">
          Kiranci asusun mai karatu don shiga cikin tattaunawa a Yanci.
        </p>
      </div>
      <div class="border border-yanci-primary/15 bg-white p-6 shadow-sm">
        <RegisterForm client:load />
      </div>
      <a href="/" class="mt-6 block text-center text-sm text-yanci-primary/60 hover:text-yanci-primary">
        &larr; Komawa gida
      </a>
    </div>
  </div>
</BaseLayout>
