---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getStaff } from '@lib/appwrite-server';
import { roleName } from '@lib/auth';

export const prerender = false;

const staff = (await getStaff()).filter((s) => String(s.status ?? 'Active') === 'Active');
---

<BaseLayout
  title="Game da Mu — Yanci"
  description="Yanci: jaridar Hausa mai zuwa daga Arewacin Najeriya."
  path="/about/"
>
  <main class="mx-auto max-w-[900px] px-4 py-16 md:px-6">
    <span class="text-xs font-bold uppercase tracking-widest text-yanci-accent">Kamfanin mu</span>
    <h1 class="mt-2 font-serif text-4xl font-black text-yanci-primary">Game da Yanci</h1>

    <div class="prose mt-8 max-w-none space-y-6 text-gray-600">
      <p class="text-lg leading-relaxed">
        <strong class="text-yanci-dark">Yanci</strong> ita ce muryar Arewa — jaridar Hausa da ke ba da labarai,
        siyasa, wasanni da al'adu kai tsaye daga Najeriya. Sunanmu <em>"Yanci"</em> yana nufin 'yanci da gaskiya
        a cikin aikin jarida.
      </p>
      <p>
        Muna gaskata cewa kowane ɗan Najeriya na da hakkin sanin abin da ke faruwa a ƙasarsa, cikin yaren da ya fi
        fahimta. Daga Labarai zuwa Ra'ayi, daga Zabe zuwa Wasanni, muna kawo muku rahotanni masu inganci da
        tantancewa.
      </p>
      <p>
        Aikinmu: ba da labarai na gaskiya, tantance maganganun shugabanci, da dandalin ra'ayoyi da suka bambanta.
      </p>
    </div>

    <div class="mt-12">
      <h2 class="border-b-2 border-yanci-accent pb-2 font-serif text-2xl font-bold text-yanci-primary">Tawagarmu</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {staff.length === 0 && <p class="text-sm text-yanci-primary/50">Ana shirye-shirye...</p>}
        {staff.map((person) => (
          <article class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
            {person.image ? (
              <img src={person.image} alt={person.name} loading="lazy" class="h-20 w-20 rounded-full object-cover" />
            ) : (
              <div class="flex h-20 w-20 items-center justify-center rounded-full bg-yanci-primary/10 font-serif text-2xl font-black text-yanci-primary">
                {person.name.slice(0, 1)}
              </div>
            )}
            <h3 class="mt-4 font-serif text-lg font-bold text-yanci-dark">{person.name}</h3>
            <p class="text-xs font-medium capitalize text-yanci-teal">{roleName(person.role)}</p>
            {person.bio && <p class="mt-2 text-sm leading-relaxed text-gray-500">{person.bio}</p>}
          </article>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
