---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Ba a samu shafin ba — Yanci" description="Shafin da kake nema bai wanzu ba.">
  <section class="mx-auto flex max-w-[640px] flex-col items-center px-4 py-28 text-center md:px-6">
    <p class="mb-4 font-serif text-[7rem] font-black leading-none text-[#0f3036] md:text-[9rem]">404</p>
    <h1 class="mb-4 font-serif text-3xl font-bold text-[#1c1917]">Ba a samu shafin da kake nema ba</h1>
    <p class="mb-8 text-gray-500">Da alama shafin da kake son buɗewa an cire shi ko bai taɓa wanzuwa ba.</p>
    <a href="/" class="rounded-full bg-[#0f3036] px-8 py-3.5 text-sm font-bold uppercase tracking-wider text-white transition-colors hover:bg-[#c59d5f]">
      Komawa Gida
    </a>
  </section>
</BaseLayout>