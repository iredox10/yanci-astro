---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import LiveTimeline from '../../components/LiveTimeline.astro';
import CommentsSection from '../../components/CommentsSection.astro';
import AudioPlayer from '../../components/AudioPlayer';
import ArticleExplainer from '../../components/ArticleExplainer';
import RecommendedArticles from '../../components/RecommendedArticles.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import Corrections from '../../components/Corrections.astro';
import WhatsAppTipLine from '../../components/WhatsAppTipLine.astro';
import BreakingNewsBanner from '../../components/BreakingNewsBanner.astro';
import BookmarkButton from '../../components/BookmarkButton';
import FontSizeController from '../../components/FontSizeController';
import PrintButton from '../../components/PrintButton';
import { pillarAccent } from '../../data/schema';
import { loadArticles, loadArticle, toCards } from '../../lib/content';

export const prerender = false;

const { id } = Astro.params;
const article = await loadArticle(id!);
if (!article) {
  return Astro.redirect('/404');
}

const accent = pillarAccent(article.pillar);
const idStr = String(article.$id ?? article.id);
const body = article.body;
const isLive = Boolean(article.isLive);
const liveUpdates = Array.isArray(article.liveUpdates) ? article.liveUpdates : [];

const isBreaking = Boolean(
  article.is_breaking || (article as unknown as Record<string, unknown>).isBreaking,
);
const isBreakingActive =
  isBreaking &&
  (!article.breaking_until || new Date(article.breaking_until).getTime() > Date.now());

const isSensitive = Boolean(
  article.isSensitive || (article as unknown as Record<string, unknown>).is_sensitive,
);

const words = (body ?? '').replace(/<[^>]*>/g, ' ').trim().split(/\s+/).filter(Boolean).length;
const readTime = Math.max(1, Math.ceil(words / 200));

const plainBody = (body ?? '')
  .replace(/<(style|script)[\s\S]*?<\/\1>/gi, ' ')
  .replace(/<[^>]*>/g, ' ')
  .replace(/&nbsp;/g, ' ')
  .replace(/&amp;/g, '&')
  .replace(/&lt;/g, '<')
  .replace(/&gt;/g, '>')
  .replace(/&quot;/g, '"')
  .replace(/&#39;/g, '\'')
  .replace(/\s+/g, ' ')
  .trim();

const tagList = Array.isArray(article.tags) ? article.tags : [];
const corrections = Array.isArray((article as { corrections?: unknown }).corrections)
  ? ((article as { corrections?: Array<{ date: string | Date; text: string }> }).corrections ?? [])
  : undefined;

const focalPosition = (() => {
  if (article.focal_point) {
    if (typeof article.focal_point === 'object' && article.focal_point !== null) {
      return `${article.focal_point.x}% ${article.focal_point.y}%`;
    }
    if (typeof article.focal_point === 'string') {
      try {
        const parsed = JSON.parse(article.focal_point);
        if (parsed && typeof parsed.x === 'number' && typeof parsed.y === 'number') {
          return `${parsed.x}% ${parsed.y}%`;
        }
      } catch {}
      return article.focal_point;
    }
  }
  if (article.imageFocalX != null && article.imageFocalY != null) {
    return `${article.imageFocalX}% ${article.imageFocalY}%`;
  }
  return undefined;
})();

const sectionLabel = String(article.section ?? article.pillar ?? 'Labarai');

const others = (await loadArticles()).filter((a) => String(a.$id ?? a.id) !== idStr);
const relevance = (a: (typeof others)[number]) => {
  const otherTags = Array.isArray(a.tags) ? a.tags : [];
  return (
    (String(a.section ?? '') === sectionLabel ? 20 : 0) +
    otherTags.filter((t) => tagList.includes(t)).length * 5 +
    (String(a.pillar ?? '') === String(article.pillar ?? '') ? 3 : 0)
  );
};
const related = await toCards([...others].sort((a, b) => relevance(b) - relevance(a)).slice(0, 4));

const formatDate = (iso?: string) =>
  iso ? new Date(iso).toLocaleDateString('ha-NG', { day: 'numeric', month: 'long', year: 'numeric' }) : '';

const currentUrl = `${Astro.site?.href ?? 'https://yanci.ng'}article/${idStr}`;
const enc = (s: string) => encodeURIComponent(s);
const facebookShare = `https://www.facebook.com/sharer/sharer.php?u=${enc(currentUrl)}`;
const twitterShare = `https://twitter.com/intent/tweet?url=${enc(currentUrl)}&text=${enc(article.headline)}`;
const whatsappShare = `https://api.whatsapp.com/send?text=${enc(`${article.headline} - ${currentUrl}`)}`;

const audioPlaylist = [
  {
    id: idStr,
    title: article.headline,
    text: plainBody,
    section: sectionLabel,
    author: article.author,
    image: article.image,
    url: `/article/${idStr}`,
  },
  ...others.slice(0, 6).map((o) => {
    const oBody = (o.body ?? o.trail ?? '')
      .replace(/<(style|script)[\s\S]*?<\/\1>/gi, ' ')
      .replace(/<[^>]*>/g, ' ')
      .replace(/&nbsp;/g, ' ')
      .replace(/&amp;/g, '&')
      .replace(/&lt;/g, '<')
      .replace(/&gt;/g, '>')
      .replace(/&quot;/g, '"')
      .replace(/&#39;/g, '\'')
      .replace(/\s+/g, ' ')
      .trim();
    return {
      id: String(o.$id ?? o.id),
      title: o.headline,
      text: oBody,
      section: String(o.section ?? o.pillar ?? 'Labarai'),
      author: o.author,
      image: o.image,
      url: `/article/${String(o.$id ?? o.id)}`,
    };
  }),
];
---

<BaseLayout
  title={article.headline}
  description={article.trail}
  path={`/article/${idStr}`}
  image={article.image}
  ogType="article"
  publishedTime={article.$createdAt}
  modifiedTime={article.$updatedAt}
  authorName={article.author}
  tags={tagList}
  section={sectionLabel}
>
  <!-- Breaking news banner (if active sitewide or for breaking article) -->
  <BreakingNewsBanner />

  <!-- Sensitive Content Warning Modal -->
  {isSensitive && (
    <div
      id="sensitive-warning-modal"
      class="fixed inset-0 z-[100] flex items-center justify-center bg-black/80 p-4 backdrop-blur-sm"
      role="dialog"
      aria-modal="true"
      aria-labelledby="sensitive-title"
    >
      <div class="w-full max-w-md rounded-2xl bg-white p-6 text-center shadow-2xl sm:p-8">
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-amber-100 text-amber-600">
          <svg class="h-8 w-8" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
            <path d="M256 32c14.2 0 27.3 7.5 34.5 19.8l216 368c7.3 12.4 7.3 27.7 .2 40.1S486.3 480 472 480H40c-14.3 0-27.4-7.7-34.7-20.1s-7.1-27.7 .2-40.1l216-368C228.7 39.5 241.8 32 256 32zm0 128c-13.3 0-24 10.7-24 24V280c0 13.3 10.7 24 24 24s24-10.7 24-24V184c0-13.3-10.7-24-24-24zm32 224a32 32 0 1 0 -64 0 32 32 0 1 0 64 0z" />
          </svg>
        </div>
        <h2 id="sensitive-title" class="mb-3 font-serif text-2xl font-black text-[#121212]">
          Abun Ciki Mai Kula
        </h2>
        <p class="mb-6 text-sm leading-relaxed text-gray-600">
          Wannan labari ya ƙunshi bayanan da zasu iya damun wasu masu karatu. Don Allah ka tabbata kana son ci gaba da karantawa.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <button
            type="button"
            id="accept-sensitive-btn"
            class="flex-1 rounded-xl bg-[#121212] py-3 text-sm font-bold text-white transition-colors hover:bg-gray-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#121212]"
          >
            Na Fahimta, Ci Gaba
          </button>
          <a
            href="/"
            class="flex-1 rounded-xl bg-gray-100 py-3 text-sm font-bold text-gray-700 transition-colors hover:bg-gray-200"
          >
            Komawa Gida
          </a>
        </div>
      </div>
    </div>
  )}

  <!-- Reading progress -->
  <div class="fixed left-0 top-0 z-50 h-1.5 w-full bg-gray-100">
    <div id="reading-progress-bar" class="h-full transition-all duration-300 ease-out" style={`width:0%; background-color: ${accent}`} />
  </div>

  <main id="main-content" class="overflow-hidden pb-32 pt-10 md:pt-16" role="main" aria-label="Babban ciki" data-article-id={idStr} data-article-section={sectionLabel}>
    <article class="mx-auto w-full max-w-[780px] px-4 sm:px-5 md:px-0">
      <!-- Print Newspaper Header (Visible only when printing) -->
      <div class="print-newspaper-header hidden" aria-hidden="true">
        <div class="print-header-top">
          <span class="print-brand">YANCI</span>
          <span class="print-tagline">Jaridar Hausa Mai Zaman Kanta</span>
          <span class="print-url">www.yanci.ng</span>
        </div>
        <div class="print-header-sub">
          <span class="print-date">{formatDate(article.$createdAt)}</span>
          <span class="print-section">{sectionLabel}</span>
          <span class="print-edition">Bugun Yanar Gizo</span>
        </div>
      </div>

      <!-- Header -->
      <header class="mb-8 md:mb-10">
        <div class="mb-6 flex flex-wrap items-center gap-3 no-print">
          <a href={`/tag/${encodeURIComponent(sectionLabel)}`} class="font-sans text-sm font-extrabold uppercase tracking-widest hover:underline" style={`color: ${accent}`}>
            {sectionLabel}
          </a>
          <span class="text-xs text-gray-300">/</span>
          {isLive && (
            <span class="flex items-center gap-1.5 rounded-full bg-[#c70000] px-2.5 py-1 text-[10px] font-black uppercase tracking-widest text-white">
              <span class="h-2 w-2 animate-pulse rounded-full bg-white"></span> Kai Tsaye
            </span>
          )}
          {isBreakingActive && !isLive && (
            <span class="flex items-center gap-1.5 rounded-full bg-[#c70000] px-2.5 py-1 text-[10px] font-black uppercase tracking-widest text-white animate-pulse">
              <svg class="h-3 w-3 text-yellow-300" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true"><path d="M349.4 44.6c5.9-13.7 1.5-29.7-10.6-38.5s-28.6-8-39.9 1.8l-256 224c-10 8.8-13.6 22.9-8.9 35.3S50.7 288 64 288h111.5L98.6 467.4c-5.9 13.7-1.5 29.7 10.6 38.5s28.6 8 39.9-1.8l256-224c10-8.8 13.6-22.9 8.9-35.3s-16.6-20.7-29.9-20.7H272.5L349.4 44.6z"/></svg>
              Breaking News
            </span>
          )}
          <span class="flex items-center gap-1 font-sans text-xs font-bold uppercase tracking-widest text-gray-500">
            <svg class="h-3 w-3 text-gray-400" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M256 0C114.6 0 0 114.6 0 256s114.6 256 256 256 256-114.6 256-256S397.4 0 256 0zm112 288c0 8.8-7.2 16-16 16h-96c-8.8 0-16-7.2-16-16V128c0-8.8 7.2-16 16-16s16 7.2 16 16v128h80c8.8 0 16 7.2 16 16z"/></svg>
            {readTime} Min Read
          </span>
        </div>

        <h1 class="mb-6 break-words font-serif text-3xl font-bold leading-[1.1] tracking-tight text-[#121212] sm:text-4xl md:mb-8 md:text-5xl lg:text-[3.5rem]">
          {article.headline}
        </h1>

        {article.trail && (
          <div class="mb-8 break-words border-l-4 border-gray-200 py-1 pl-4 font-serif text-lg leading-[1.5] text-gray-600 sm:text-xl md:mb-10 md:pl-6 md:text-2xl">
            {article.trail}
          </div>
        )}

        <!-- Print-only Byline -->
        <div class="print-byline hidden font-sans text-xs text-gray-700" aria-hidden="true">
          <span>Daga <strong>{article.author ?? 'Yanci Staff'}</strong>{article.coAuthor ? ` tare da ${article.coAuthor}` : ''}</span>
          <span class="mx-2">•</span>
          <span>An buga: {formatDate(article.$createdAt)}</span>
          <span class="mx-2">•</span>
          <span>Rukuni: {sectionLabel}</span>
        </div>

        {/* Meta */}
        <div class="mb-8 flex flex-col justify-between gap-4 py-4 sm:flex-row sm:items-center sm:gap-6 sm:py-6 md:mb-10 border-y border-gray-100 no-print">
          <div class="flex items-center gap-3 sm:gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100 text-lg font-bold text-[#121212] sm:h-12 sm:w-12 sm:text-xl">
              {(article.author ?? 'Y')[0]}
            </div>
            <div class="flex min-w-0 flex-col">
              <span class="mb-0.5 text-[10px] font-sans font-bold uppercase tracking-widest text-gray-400">Written by</span>
              <a href={`/author/${encodeURIComponent(article.author ?? 'Yanci Staff')}`} class="truncate font-sans text-sm font-bold transition-colors hover:underline sm:text-base" style={`color: ${accent}`}>
                {article.author ?? 'Yanci Staff'}
              </a>
              {article.coAuthor && (
                <a href={`/author/${encodeURIComponent(article.coAuthor)}`} class="truncate font-sans text-xs text-gray-500 transition-colors hover:underline mt-0.5">
                  Tare da {article.coAuthor}
                </a>
              )}
            </div>
          </div>

          <div class="flex items-center gap-2 text-xs text-gray-400">
            <svg class="h-3 w-3 shrink-0" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M464 256H48c-26.5 0-48-21.5-48-48V80c0-26.5 21.5-48 48-48h416c26.5 0 48 21.5 48 48v128c0 26.5-21.5 48-48 48zM64 207.8V320c0 26.5 21.5 48 48 48h288c26.5 0 48-21.5 48-48V207.8l-54.6 27.6c-25.5 12.9-56.7 10.2-81.2-9.2l-9.3 9.3c-33.1 33.1-86.8 33.1-119.9 0l-9.3-9.3c-24.5 19.4-55.7 22.1-81.2 6.9 0 0 0-1.1 0-1.1zm0 61.9 2.7-2.7 42.7-21.6-2.7 2.7-7.5 7.5c-12.5 12.5-32.8 12.5-45.3 0L64 269.1z"/></svg>
            <span>{formatDate(article.$createdAt)}</span>
          </div>

          <div class="flex shrink-0 flex-wrap items-center gap-2 sm:gap-3">
            <FontSizeController client:load />
            <BookmarkButton
              client:load
              article={{
                id: idStr,
                headline: article.headline,
                section: sectionLabel,
                pillar: String(article.pillar ?? ''),
                image: article.image,
                slug: article.slug,
                publishDate: article.$createdAt,
              }}
              showLabel={true}
            />
            <PrintButton client:load />
            <div class="hidden h-5 w-px bg-gray-200 sm:block" />
            <span class="mr-1 hidden font-sans text-[10px] font-bold uppercase tracking-widest text-gray-400 sm:block">Share</span>
            <a href={facebookShare} target="_blank" rel="noopener noreferrer" class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-100 text-gray-400 transition-all duration-300 hover:border-[#1877F2] hover:bg-[#1877F2] hover:text-white sm:h-10 sm:w-10" title="Facebook" aria-label="Share on Facebook">
              <svg class="h-[14px] w-[14px]" viewBox="0 0 320 512" fill="currentColor" aria-hidden="true"><path d="M279.14 288l14.22-92.66h-88.9v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/></svg>
            </a>
            <a href={twitterShare} target="_blank" rel="noopener noreferrer" class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-100 text-gray-400 transition-all duration-300 hover:border-[#1DA1F2] hover:bg-[#1DA1F2] hover:text-white sm:h-10 sm:w-10" title="Twitter" aria-label="Share on Twitter">
              <svg class="h-[14px] w-[14px]" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M459.6 151.8c.3 4.6.3 9.3.3 14.1 0 144.6-110.1 311.4-311.4 311.4-61.8 0-119.3-18.1-167.7-49.2 8.6 1 17.2 1.5 26.2 1.5 53.4 0 102.5-18.2 141.5-48.9-49.9-1-92-26-106.5-81.6 13.4 2.6 27.2 2.6 41.3-1.6C120.3 277 80 228.7 80 169.4v-2.1c13 7.4 27.4 11.9 42.3 12.3-27.7-19.7-42.3-61.4-42.3-83.5 0-14.7 3.9-29 12.2-41.8 55.2 71.9 126.9 108.5 219.8 116.9a133.1 133.1 0 0 1 3.1-29.2C327.3 86.2 368 56 413.6 56c19.4 0 37.3 8.1 47.1 21-13.4 2.8-40 7.1-64.5 19.2 26.6-6.9 61.8-8.8 78.4-3.3z" transform="translate(9 0)"/></svg>
            </a>
            <a href={whatsappShare} target="_blank" rel="noopener noreferrer" class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-100 text-gray-400 transition-all duration-300 hover:border-[#25D366] hover:bg-[#25D366] hover:text-white sm:h-10 sm:w-10" title="Whatsapp" aria-label="Share on WhatsApp">
              <svg class="h-[14px] w-[14px]" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
            </a>
          </div>
        </div>
      </header>

      <!-- Article Explainer -->
      <ArticleExplainer
        client:visible
        headline={article.headline}
        body={plainBody || body || ''}
        initialSummary={article.trail}
      />

      <!-- Main image -->
      {article.image && (
        <figure class="mb-8 w-full md:mb-12">
          <div class="relative overflow-hidden rounded-sm bg-gray-100 shadow-sm">
            <img
              src={article.image}
              alt={article.imageAlt || article.headline}
              loading="eager"
              decoding="async"
              class="block h-auto w-full object-cover"
              style={focalPosition ? `object-position: ${focalPosition};` : undefined}
            />
          </div>
          {(article.imageCaption || article.imageCredit) && (
            <figcaption class="mt-3 flex items-start gap-1.5 font-sans text-xs sm:text-sm text-gray-500 leading-tight">
              <svg class="mt-0.5 h-3 w-3 shrink-0 text-[#121212]" viewBox="0 0 320 512" fill="currentColor" aria-hidden="true"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"/></svg>
              <span>
                {article.imageCaption}
                {article.imageCaption && article.imageCredit && <span class="mx-1 text-gray-300">|</span>}
                {article.imageCredit && <span class="font-bold uppercase tracking-widest text-[10px]">Hoto: {article.imageCredit}</span>}
              </span>
            </figcaption>
          )}
        </figure>
      )}

      <!-- Audio Player (Inline + Persistent Floating Mini-Player) -->
      <AudioPlayer client:load title={article.headline} text={plainBody} playlist={audioPlaylist} />

      <!-- Body -->
      <div class="article-body yanci-article-body prose prose-lg md:prose-xl max-w-none text-[#121212] prose-headings:font-bold prose-headings:font-serif prose-headings:tracking-tight prose-p:font-serif prose-p:text-[1.125rem] md:prose-p:text-[1.35rem] prose-p:leading-[1.8] prose-p:mb-8 prose-img:rounded-lg prose-img:shadow-lg prose-img:my-10 prose-a:text-[#c70000] prose-a:no-underline hover:prose-a:underline hover:prose-a:decoration-2 hover:prose-a:underline-offset-2 prose-blockquote:border-l-[6px] prose-blockquote:border-[#c70000] prose-blockquote:bg-gray-50 prose-blockquote:py-4 prose-blockquote:px-8 prose-blockquote:not-italic prose-blockquote:font-bold prose-blockquote:text-xl md:prose-blockquote:text-2xl prose-blockquote:text-gray-900 prose-blockquote:rounded-r-lg">
        {body ? (
          <Fragment set:html={body} />
        ) : (
          <p class="py-12 text-center font-serif italic text-gray-400">Ana loda labarin...</p>
        )}
      </div>

      <script is:inline>
        (function() {
          try {
            var s = localStorage.getItem('yanci_reader_fontsize');
            if (s && ['normal', 'big', 'large', 'xlarge'].indexOf(s) !== -1) {
              document.documentElement.setAttribute('data-reader-font-size', s);
              var targets = document.querySelectorAll('.yanci-article-body, .article-body');
              for (var i = 0; i < targets.length; i++) {
                targets[i].setAttribute('data-font-size', s);
              }
            }
          } catch(e) {}
        })();
      </script>

      <Corrections corrections={corrections} className="mt-10" />

      <AdSlot variant="inline" slotId="article-inline" className="mt-10" />

      <!-- Live blog timeline -->
      {liveUpdates.length > 0 && (
        <section class="mt-14 border-t-4 border-gray-100 pt-10 md:mt-20">
          <LiveTimeline updates={liveUpdates} isLive={isLive} accent={accent} />
        </section>
      )}

      <!-- Tags -->
      <div class="mt-16 border-t border-gray-200 pt-8 md:mt-20 md:pt-10">
        <h4 class="mb-4 font-sans text-xs font-bold uppercase tracking-widest text-gray-400 md:mb-6">Taken Labarai</h4>
        <div class="flex flex-wrap gap-2 md:gap-3">
          {(article.tags && article.tags.length > 0 ? article.tags : ['Najeriya', 'Arewa', 'Labarai']).map((tag) => (
            <a href={`/tag/${encodeURIComponent(tag)}`} class="rounded-full border border-gray-100 bg-gray-50 px-3 py-1.5 font-sans text-xs font-bold text-gray-700 shadow-sm transition-all duration-300 hover:border-[#121212] hover:bg-[#121212] hover:text-white md:px-4 md:py-2 md:text-sm">
              #{tag}
            </a>
          ))}
        </div>
      </div>

      <!-- Reader tips -->
      <div class="mt-14">
        <WhatsAppTipLine />
      </div>

      <!-- Comments -->
      <CommentsSection articleId={idStr} />

      <!-- Print Article Footer URL -->
      <div class="print-article-footer hidden" aria-hidden="true">
        <p class="font-bold text-[#121212]">YANCI — www.yanci.ng</p>
        <p class="mt-1">An ɗauko wannan labari daga: <span class="underline">{currentUrl}</span></p>
        <p class="text-[10px] text-gray-500 mt-1">© {new Date().getFullYear()} Yanci Media Ltd. An kiyaye haƙƙin mallaka.</p>
      </div>
    </article>

    <!-- Recommended Articles -->
    <RecommendedArticles currentArticle={article} />

    <!-- Related Articles -->
    <section class="mt-12 border-t border-gray-200 bg-gray-50 py-12 md:mt-24 md:py-20">
      <div class="mx-auto max-w-[1400px] px-4 sm:px-5 md:px-6">
        <div class="mb-8">
          <span class="mb-2 block text-xs font-bold uppercase tracking-widest" style={`color: ${accent}`}>Ku karanta ƙari</span>
          <h2 class="font-serif text-3xl font-black text-[#121212]">Labaran da ke da alaƙa</h2>
        </div>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((a) => (
            <NewsCard data={a} />
          ))}
        </div>
      </div>
    </section>
  </main>

  <button id="back-to-top" type="button" class="fixed bottom-6 right-4 z-50 hidden h-12 w-12 items-center justify-center rounded-full bg-[#121212] text-white shadow-2xl transition-all duration-300 hover:bg-[#c70000] sm:bottom-10 sm:right-10 sm:h-14 sm:w-14" aria-label="Back to top">
    <svg class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true"><path d="M63.5 405.4 167.6 268.6l-32.2 0c-40.3 0-73-32.6-73-72.9v-2.6c0-9.4 14.3-17.9 15.3-28.2 3.7-8.9 12.7-37.7 17.8-44 6.4-8 16.9-13 27.6-13 10.6 0 17.3 6.4 27.4 11.1 0 0-1.8-15.9-1.8-26.8 0-6.8-3.3-13.4-8.7-17.4l-19.8-11.2c-8.7-12.4-18.3-24.3-18.3-36.2 0-14 14.9-21.2 27.3-21.2 9.2 0 16.9 6.2 26.3 10.6 0 0 0-8.1 0-14.8 0-8-7-14.8-15.4-14.8h-3.9C122.4 1.9 104.4 18.2 104.4 40 103.2 51 199.2 512 231.3 512c14.4 0 31.9-13.3 47.9-27.9 4.2 4.3 7.9 11.9 13.1 16.9 30.5 29.6 63.6 14.9 63.6 14.9v0c-9.7-30.1-15.2-35.1 22.1-15.3v0c4.3-8.2 13.8-14.7 20.6-21.7-7.3-3.6-8.8-9.3-12.4-16.2l-28.9-67.4C263.9 141.4 42.4 116.4 42.4 319.7z"/></svg>
  </button>
</BaseLayout>

<script>
  const bar = document.getElementById('reading-progress-bar');
  const topBtn = document.getElementById('back-to-top');
  const onScroll = () => {
    const total = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const p = total > 0 ? (window.scrollY / total) * 100 : 0;
    if (bar) bar.style.width = `${Math.min(p, 100)}%`;
    if (topBtn) topBtn.classList.toggle('hidden', window.scrollY <= 500);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  topBtn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

  const mainEl = document.getElementById('main-content');
  const articleId = mainEl?.getAttribute('data-article-id') ?? '';
  const articleSection = mainEl?.getAttribute('data-article-section') ?? null;

  fetch('/api/track-view', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      articleId,
      section: articleSection,
      referrer: document.referrer || null,
      device: /Mobi|Android|iPhone/i.test(navigator.userAgent) ? 'mobile' : 'desktop',
    }),
    keepalive: true,
  }).catch(() => {});

  // ── Live blog: filters + polling ──────────────────────────────────────────
  const liveFeed = document.getElementById('live-feed');
  const filterBtns = [...document.querySelectorAll('[data-live-filter]')];

  function applyFilter(type: string): void {
    if (!liveFeed) return;
    liveFeed
      .querySelectorAll('[data-live-update]')
      .forEach((el) => el.classList.toggle('hidden', type !== 'all' && el.getAttribute('data-live-type') !== type));
    filterBtns.forEach((btn) => {
      const active = btn.getAttribute('data-live-filter') === type;
      btn.classList.toggle('border-[#121212]', active);
      btn.classList.toggle('bg-[#121212]', active);
      btn.classList.toggle('text-white', active);
      btn.classList.toggle('text-gray-500', !active);
    });
  }

  filterBtns.forEach((btn) =>
    btn.addEventListener('click', () => applyFilter(btn.getAttribute('data-live-filter') ?? 'all')),
  );

  function timeOf(u: { time?: string; timestamp?: string }): string {
    return String(u.time ?? '') || (u.timestamp ? new Date(String(u.timestamp)).toLocaleTimeString('ha-NG', { hour: '2-digit', minute: '2-digit' }) : '');
  }

  interface PollUpdate {
    id?: string | number;
    timestamp?: string;
    time?: string;
    title?: string;
    content?: string;
    type?: string;
    pinned?: boolean;
    author?: string;
    image?: string;
  }

  function updateHtml(u: PollUpdate): string {
    const type = String(u.type ?? 'update');
    return `<article class="relative pl-0 md:pl-10" data-live-update data-live-type="${type}">
      <div class="absolute left-0 top-[22px] z-10 hidden h-4 w-4 rounded-full border-[3px] border-white shadow-sm md:block ${type === 'key-event' ? 'bg-[#c70000] ring-4 ring-[#c70000]/10' : 'bg-[#121212]'}"></div>
      <div class="mb-4 flex items-center gap-3 md:hidden"><time class="text-xs font-bold text-gray-400">${timeOf(u)}</time><div class="h-px flex-1 bg-gray-100"></div></div>
      <div>
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <time class="hidden text-xs font-extrabold uppercase tracking-widest text-[#c70000] md:block">${timeOf(u)}</time>
          ${type === 'key-event' ? '<span class="border border-[#c70000] bg-[#fff0f0] px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-[#c70000]">Muhimmin Abu</span>' : ''}
        </div>
        ${u.title ? `<h3 class="mb-3 font-serif text-xl font-black leading-tight text-[#121212] md:text-2xl">${escapeHtml(String(u.title))}</h3>` : ''}
        ${u.image ? `<figure class="mb-5 overflow-hidden rounded-sm bg-gray-100"><img src="${escapeAttr(String(u.image))}" alt="" class="h-auto w-full object-cover" loading="lazy"></figure>` : ''}
        ${u.content ? `<div class="prose max-w-none font-serif leading-relaxed text-gray-800">${String(u.content)}</div>` : ''}
        ${u.author ? `<p class="mt-4 text-[11px] font-bold uppercase tracking-widest text-gray-400">Daga ${escapeHtml(String(u.author))}</p>` : ''}
      </div>
    </article>`;
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c as '&' | '<' | '>' | '"' | "'"]);
  }
  function escapeAttr(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
  }

  function renderUpdates(updates: PollUpdate[]): void {
    if (!liveFeed) return;
    const list = liveFeed.querySelector('.space-y-10');
    const empty = liveFeed.querySelector('.border-dashed');
    if (!list) return;
    const sorted = [...updates].sort((a, b) => String(b.timestamp ?? '').localeCompare(String(a.timestamp ?? '')) || String(b.time ?? '').localeCompare(String(a.time ?? '')));
    const feed = sorted.filter((u) => !u.pinned);
    if (empty) empty.remove();
    list.innerHTML = feed.map(updateHtml).join('');
    const first = list.querySelector('[data-live-update]');
    if (first) {
      const badge = document.createElement('span');
      badge.className = 'border border-[#0f3036]/30 bg-[#0f3036]/5 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-[#0f3036]';
      badge.textContent = 'Sabuwa';
      first.querySelector('div > div > div.mb-3')?.appendChild(badge);
    }
    const counts = document.querySelectorAll('[data-live-filter]');
    if (counts[0]) counts[0].textContent = `Duka (${feed.length})`;
    const keyCount = feed.filter((u) => String(u.type ?? '') === 'key-event').length;
    if (counts[1]) counts[1].textContent = `Muhimman Abubuwa (${keyCount})`;
  }

  // Refresh by re-fetching the article JSON; rebuild the timeline when updates changed.
  let lastJson = '';
  async function refreshLive() {
    if (!liveFeed) return;
    try {
      const res = await fetch(`/api/articles/${encodeURIComponent(articleId)}`, { cache: 'no-store' });
      const data = await res.json();
      if (!res.ok || !data.ok || !data.article) return;
      const newUpdates = Array.isArray(data.article.liveUpdates) ? data.article.liveUpdates : [];
      const json = JSON.stringify(newUpdates);
      if (json !== lastJson) {
        lastJson = json;
        renderUpdates(newUpdates);
      }
    } catch {
      /* keep current timeline on network errors */
    }
  }

  document.getElementById('live-refresh')?.addEventListener('click', refreshLive);
  setInterval(refreshLive, 30000);
</script>