# ─── Public (safe to ship to the browser) ─────────────────────────────────────
# These are NOT secrets. They identify the Appwrite project, not authorize it.
PUBLIC_SITE_URL=https://yanci.ng
PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
PUBLIC_APPWRITE_PROJECT_ID=your_project_id_here
PUBLIC_APPWRITE_DATABASE_ID=your_database_id_here
PUBLIC_APPWRITE_BUCKET_ID=your_bucket_id_here
PUBLIC_APPWRITE_COLLECTION_ARTICLES=articles
PUBLIC_APPWRITE_COLLECTION_ELECTIONS=elections
PUBLIC_APPWRITE_COLLECTION_CANDIDATES=candidates
PUBLIC_APPWRITE_COLLECTION_RESULTS=results
PUBLIC_APPWRITE_COLLECTION_FACTCHECKS=factchecks
PUBLIC_APPWRITE_COLLECTION_HIGHLIGHTS=highlights
PUBLIC_APPWRITE_COLLECTION_HOMEPAGE_STATS=homepage_stats
PUBLIC_APPWRITE_COLLECTION_SPORTS=sports
PUBLIC_APPWRITE_COLLECTION_HOMEPAGE_LAYOUT=homepage_layout
PUBLIC_APPWRITE_COLLECTION_SETTINGS=settings
PUBLIC_APPWRITE_COLLECTION_COMMENTS=comments
PUBLIC_APPWRITE_COLLECTION_VIEWS=article_views
PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ─── Server-only secrets (NEVER prefix with PUBLIC_) ─────────────────────────
# Appwrite API key. Create one at Appwrite Console > API Keys with ONLY the
# scopes needed: documents.read, documents.write, files.read, files.write,
# users.read, sessions.write. Never use a project-level admin key on the site.
APPWRITE_API_KEY=your_server_api_key_here
APPWRITE_COLLECTION_ROLES=roles
APPWRITE_COLLECTION_INVITATIONS=invitations
APPWRITE_COLLECTION_REVISIONS=article_revisions
# Newsletter signups come in through POST /api/newsletter
APPWRITE_COLLECTION_NEWSLETTER=newsletter_subscribers
APPWRITE_COLLECTION_AUTOFETCH_SOURCES=autofetch_sources

# AI providers (server-only, used by /api/ai/* proxy + workers)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Social auto-post worker
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
