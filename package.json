{
  "name": "yanci-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./scripts/start.mjs",
    "db:migrate": "node ./scripts/migrate.mjs",
    "db:seed": "node ./scripts/seed.mjs",
    "db:generate": "drizzle-kit generate",
    "cron:publish": "node ./scripts/publish-scheduled.mjs",
    "cron:social": "node ./scripts/social-auto-post.mjs --check-recent",
    "firecrawl:start": "docker compose -f ../firecrawl/docker-compose.yaml up -d",
    "firecrawl:stop": "docker compose -f ../firecrawl/docker-compose.yaml stop",
    "firecrawl:status": "docker compose -f ../firecrawl/docker-compose.yaml ps",
    "firecrawl:logs": "docker compose -f ../firecrawl/docker-compose.yaml logs api --tail 50",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.0",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.5.0",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.11"
  }
}
